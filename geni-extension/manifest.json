{
  "manifest_version": 3,
  "name": "geni collector",
  "version": "1.6.0",
  "description": "Drives the Geni side of this repo: relationship paths, profile saves, placeholder individuals and Forest exports.",
  "permissions": [
    "tabs",
    "storage",
    "alarms"
  ],
  "host_permissions": [
    "*://www.geni.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "*://www.geni.com/*"
      ],
      "js": [
        "content/common.js",
        "content/path.js",
        "content/export.js",
        "content/seed.js",
        "content/family.js",
        "content/individual.js",
        "content/router.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "action": {
    "default_popup": "popup.html",
    "default_title": "geni collector"
  }
}
