2 CONT
2 CONT Filosofie magister:
2 CONT
2 CONT 1676-04-27 Rostock Tyskland 2)
2 CONT
2 CONT Jämtlands prästerskaps representant:
2 CONT
2 CONT 1693 Riksdagen 2)
2 CONT
2 CONT Död:
2 CONT
2 CONT 1723-06-21 Ragunda (Z) 1)
2 CONT
2 CONT --------------------------------------------------------------------------------
2 CONT
2 CONT Familj med Elisabet Flodalin (1648 - )
2 CONT
