2 CONT
2 CONT Født:   omkring 1585 Østerhalne, Vadum sogn, Ålborg amt 
2 CONT
2 CONT Boede:   (1653-) Vesterhalne Bundgård, Vadum sogn, Ålborg amt 
2 CONT
2 CONT --------------------------------------------------------------------------------
2 CONT
2 CONT I familie med Bertel Thomsen Kjærulf (1580 - ) 
2 CONT
2 CONT Vielse:   omkring 1608 
2 CONT
2 CONT Børn:  Karen Bertelsdatter Kjærulf (1608 - 1663) 
2 CONT
2 CONT   Johanne Bertelsdatter Kjærulf (1610 - 1691) 
2 CONT
2 CONT   Maren Bertelsdatter Kjærulf (1615 - ) 
2 CONT
2 CONT   Else Bertelsdatter Kjærulf (1618 - ) 
2 CONT
2 CONT   Gertrud Bertelsdatter Kjærulf (1621 - 1665) 
2 CONT
2 CONT   Thomas Bertelsen Kjærulf (1624 - 1688) 
