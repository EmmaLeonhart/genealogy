1 NOTE {geni:about_me} https://www.adelsvapen.com/genealogi/Von_D%C3%B6beln_nr_1519#TAB_11
2 CONT
2 CONT Ernst Fredrik (son av Johan Jakob), född 1756-07-03 på Stora Torpa i Segerstads socken, Skaraborgs län. Levde utan tjänst. Död 1804-03-02 på Röllesås i Sandhems socken, Skaraborgs län och begravd 1804-03-11.
2 CONT
2 CONT Gift 1776-10-16 med sin systers svägerska Brita Catharina Björnberg, född 1752-06-13 på Brushed i Eriksbergs socken, Älvsborgs län, död 1815-11-18. Dotter av hovkvartermästaren Carl Fredrik Björnberg, nr 359 (Tab. 31), och Elisabe
2 CONC t Belfrage, nr 782.
2 CONT
2 CONT Barn:
2 CONT
2 CONT Johan Fredrik, född 1777-02-26 i Brickagården i Eriksbergs socken,
2 CONT
2 CONT Älvsborgs län, död 1778-06-21 på Jonsjö i Veddige socken, Hallands län.
2 CONT
2 CONT Johanna Jakobina, född 1779-06-09 på Jonsjö i Veddige socken, Hallands län,
2 CONT
2 CONT död 1824-11-06 på säteriet Åsaka i Åsaka socken, i Barne härad, Skaraborgs
2 CONT
2 CONT län.
2 CONT
2 CONT Gift 1797 med sin moders syssling, kaptenen Alexander Magnus Björnberg, nr
2 CONT
2 CONT 359 (Tab. 54), född 1759-05-31, död 1813-11-20.
2 CONT
2 CONT Johan Jakob, född 1781. Adjutant. Död 1822. Se Tab. 12.
2 CONT
2 CONT Lovisa Sofia, född 1784-04-25 på Jonsjö i Veddige socken, Hallands län, död
2 CONT
2 CONT ogift 1812-01-30 på Dintestorp i Sandhems socken, Skaraborgs län.
2 CONT
2 CONT Adolf Fredrik, född 1787. Bruksinspektor. Död 1822. Se Tab. 15.
2 CONT
2 CONT Carl Georg, född 1789-04-20, död 1789-06-02.
2 CONT
2 CONT Gustaf Adolf, född 1790-06-30 på Byslätt i Istorps socken, Älvsborgs län.
2 CONT
2 CONT Arrendator. Död 1837-04-17 i Höggärde i Magra socken, Älvsborgs län.
2 CONT
2 CONT Gift 1820-06-06 på Krakavik i Kinnarumma socken, Älvsborgs län med sin
2 CONT
2 CONT moders sysslings änka Anna Helena Norling i hennes 2:a gifte (gift 1:o 1810-
2 CONT
2 CONT 04-26 på Krakavik med löjtnanten Adolf Mattias Björnberg, nr 359 (Tab. 46),
2 CONT
2 CONT född 1756, död 1811), död 1840-06-23 på Djupsås i Essunga socken,
2 CONT
2 CONT Skaraborgs län.
2 CONT
2 CONT Brita Fredrika, född 1792 på Näsboholm i Marbäcks socken, Älvsborgs län,
2 CONT
2 CONT död 1792-03-05.
2 CONT
2 CONT Brita Charlotta, född 1795-05-23 på Arnesholm, Älvsborgs län, död 1864-01-
2 CONT
2 CONT 24 i Hjo.
2 CONT
2 CONT Gift 1820-04-25 i Yllestads kyrka, Skaraborgs län med Johan von Strokirch, nr
2 CONT
2 CONT 1233 (Tab. 7), född 1781-10-12 på Stora Kärr i Habo socken, Skaraborgs län,
2 CONT
2 CONT död 1835-06-06 i Hjo.
2 CONT
2 CONT Georg Carl, född 1796-02-24, död 1796-02-24.
