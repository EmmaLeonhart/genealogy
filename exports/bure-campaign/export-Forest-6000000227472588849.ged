1 NOTE {geni:about_me} Innlegg fra http://hem.fyristorg.com/ingegard-lennart/anorlenk/sida0/h_____f4.htm
2 CONT
2 CONT JOHAN VENDELSSON SCHEIBE,
2 CONT
2 CONT f 1644, d 1714 i Blädinge sn (G). Kapten, Hauptman i Lästad o Hullersvik, Blädinge sn (G). 
2 CONT
2 CONT Pfalzgreve, hertig Adolf Johans hauptman. Farbroder till kaptenen
2 CONT
2 CONT Henrik Scheibe, adlad Ridderborg, nr 1428. Johan Scheibe fick 1672
2 CONT
2 CONT adl. frihet på de gods, han med sin fru skulle få, samt anhöll
2 CONT
2 CONT 1686 om adelskap. 
2 CONT
2 CONT Barn bl.a.: Henrik Scheibe Ridderbor född 1673 och Alexander Johan
2 CONT
2 CONT Scheibe född 1687-02-15.
