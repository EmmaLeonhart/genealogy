1 NOTE {geni:about_me} David , son av Anders, född 1686-10-05. 
2 CONT
2 CONT Volontär vid
2 CONT
2 CONT amiralitetet 1701. Lärfyrverkare 1702. Fänrik vid Hälsinge och Gästrike treoch
2 CONT
2 CONT femmänningsbataljon 1703-07-12. Konfirm.fullm. 1704-01-11. Löjtnant
2 CONT
2 CONT 1706-04-05. Avgick med rekryter från Västernorrland till armén 1708-08-16.
2 CONT
2 CONT Kapten vid. G. H. von Buddenbrocks sammanslagna regemente rekryter i Riga
2 CONT
2 CONT 1709-10-23. Ånyo fullm. vid samma regemente (då överste H. F. von Beckerns)
2 CONT
2 CONT 1710-02-22. Kapten vid Smålands tremänningsinfanteriregemente 1712-05-05.
2 CONT
2 CONT Konfirm.fullm. 1716-02-06. Avsked 1719-07-22. Majors karaktär och rang
2 CONT
2 CONT 1720-11-26. Erhöll pension 1730-04-16. Död 1762-05-16 på Os i Öja socken,
2 CONT
2 CONT Kronobergs län [Lk].
2 CONT
2 CONT Gift 1714-01-01 med Magdalena Elisabet Rosenbielke, född 1697-12-07, död
2 CONT
2 CONT 1739-11-03 i Furuby socken, Kronobergs län. Dotter av kaptenen Carl Gustaf
2 CONT
2 CONT Rosenbielke, nr 52 (Tab. 15), och Helena Margareta Frijs.
2 CONT
2 CONT Barn:
2 CONT
2 CONT Anders Gustaf, född 1714-11-01, 1714-12-25.
2 CONT
2 CONT Ulrika Christina, född 1715-12-01, död ogift 1778-08-17.
2 CONT
2 CONT Sofia Charlotta, född 1717-03-10, död 1717-03-10.
2 CONT
2 CONT Vendla Helena, född 1718-04-03, död ogift 1740-12-05.
2 CONT
2 CONT Carl Henrik, född 1720. Löjtnant. Död 1772. Se Tab. 10.
2 CONT
2 CONT Magdalena Jeanette, född 1722-08-29 på Skye i Uråsa socken, Kronobergs
2 CONT
2 CONT län, död ogift 1801-05-20 på Strömserum i Ålems socken, Kalmar län.
2 CONT
2 CONT Anna Beata, född 1724-10-18 på Skye, död 1792-07-10 på Allatorp i Tävelsås
2 CONT
2 CONT socken, Kronobergs län.
2 CONT
2 CONT Gift 1753-04-13 med inspektören Jonas Ahlström, född1718-04-15 i Alsheda
2 CONT
2 CONT socken, Jönköpings län, död 1798-06-08 på Allatorp.
2 CONT
2 CONT Jonas David, född 1727. Kapten. Död 1796. Se Tab. 15.
2 CONT
2 CONT Catharina Elisabet, född 1729-10-16, död 1795-07-28 i Mönsterås.
2 CONT
2 CONT Gift 1:o 1776-02-20 med handlanden i Pataholm Anders Hoflund, född 1739,
2 CONT
2 CONT död 1777-12-21 i Pataholm i Ålems socken, Kalmar län.
2 CONT
2 CONT Gift 2:o med kofferdikaptenen Henrik Oxe, nr 103 (Tab. 12), i hans 2:a gifte,
2 CONT
2 CONT (gift 1:o med1758-12-29 med Catharina Chistina Folling, född 1726, död1775),
2 CONT
2 CONT född 1722-11-09, död 1790-04-15 i Mönsterås.
2 CONT
2 CONT Gustaf Göran, född 1732. Sergeant. Död 1786. Se Tab. 16.
2 CONT
2 CONT Anders Johan, född 1734-09-01, död 1736-02-10.
2 CONT
2 CONT Beata Maria, född 1737-09-03, död 1738-10-16.
