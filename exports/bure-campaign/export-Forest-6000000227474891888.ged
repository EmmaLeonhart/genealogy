2 CONT
2 CONT Agneta Olofsson LÖVÅNGERS BYAR OCH GÅRDAR 347
2 CONT
2 CONT BROÄNDAN 2 1/2 mantal 4 tunnland
2 CONT
2 CONT 1630 Jon Hermansson
2 CONT
2 CONT 1639 Per Olofsson Nm1635, mlgd39-54, 50:g
