1 NOTE {geni:about_me} https://personen.digitale-sammlungen.de//baltlex/Blatt_bsb00000600,00573.html?prozent=
2 CONT
2 CONT XIII.4
2 CONT
2 CONT https://personen.digitale-sammlungen.de//baltlex/Blatt_bsb00000600,00574.html?prozent=
