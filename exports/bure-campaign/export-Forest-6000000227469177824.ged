2 CONT Olof Loffman, f. 1678 18/12 (dop 22/12) uti Piteå prästgård. Död 1742 10/6 (bg. 15/6).
2 CONT
2 CONT Nämnd 1701-1730, 1735 (mtl). Handelsman.
2 CONT
2 CONT (son till kaptenlöjtnant Petter Isaksson Loffman i Luleå gamla stad och hh Brita Gran)
2 CONT
2 CONT bou 1743 18/2 FIIA:3 nr 17
2 CONT
2 CONT g m
2 CONT
2 CONT Sara Öman, död 1760 21/12 (bg. 1761 13/1) 86 år gammal.
2 CONT
2 CONT (dotter till bonden Olof Eriksson i Ås 2, Högsjö sn, och hh Brita Eriksdotter)
2 CONT
2 CONT bou (testamente) 1760 FIIA:1 nr 50
2 CONT
2 CONT Barn:
2 CONT
2 CONT a)      Erik, f. 1701 (dop 24/11) i Nederluleå lfs. Död ung.
2 CONT
2 CONT b)      Jonas, f. 1703 (dop 26/2), d. 1728 16/12 (bg. 22/12).
2 CONT
2 CONT c)      Brita, f. 1705 (dop 14/4).                                                                till familj 148
2 CONT
2 CONT d)      Petter, f. 1707 12/1 (dop 14/1), d. 1745 22/5 (bg. 28/5). Handelsman.
2 CONT
2 CONT e)      Magdalena, f. 1708 1/4 (dop 3/4). g m rektor Zackris Sundén i Umeå stad (d. 1756 9/1)
2 CONT
2 CONT f)        Erik, f. 1711 23/3 (dop 25/3), d. 1711 25/7 (bg. 2/8).
2 CONT
2 CONT g)      Olof, f. 1712 29/7 (dop 2/8) i Nederluleå. Död 1712 (bg. 7/9) i Nederluleå.
2 CONT
2 CONT h)      Lars, f. 1713 2/11 (dop 3/11), död ung.
2 CONT
2 CONT i)        Sara, f. 1718 5/8 (dop 6/8) i Nederluleå lfs.
2 CONT
2 CONT g 1747 6/10 m komm. Magnus Ahlstedt i Skellefteå (d. 1781 30/3 i Piteå stad)
2 CONT
2 CONT http://familjenbostrom.se/genealogi/norrbotten/antonius/11-169_34.htm
2 CONT
2 CONT ...
