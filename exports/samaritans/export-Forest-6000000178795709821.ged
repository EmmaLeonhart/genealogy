2 CONT [http://he.wikipedia.org/wiki/%D7%90%D7%9C%D7%9B%D7%A1%D7%A0%D7%93%D7%A8_%D7%94%D7%A9%D7%A0%D7%99_%28%D7%A9%D7%9C%D7%99%D7%98_%D7%97%D7%A9%D7%9E%D7%95%D7%A0%D7%90%D7%99%29   '''אלכסנדר השני - שליט חשמונאי''']
