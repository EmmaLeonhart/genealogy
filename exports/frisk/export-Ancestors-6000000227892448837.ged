0 @N6000000003796325210@ NOTE STIRNET
1 CONT URL:  http://www.stirnet.com/HTML/genie/ancient/ae/capet01.htm#link1
1 CONT
1 CONT  ((D))  Robert I, King of France (b 866, d 15.06.923)
1 CONT   m1. Aelis (d by930)
1 CONT   ((i)) Liegarde (Hildebrande) (b 895, d 931) 
1 CONT EGHJRSWY
1 CONT   m. (by 907) Heribert II, Count of Vermandois (b 884, d 943) 
1 CONT EGHJRSWY
1 CONT   ((ii)) Emma (b c894, d 935)
1 CONT   m. (910) Raol of Burgundy, King of France (b 890, d 15.01.936)
1 CONT m2. Beatrix de Vermandois (b 880, a 931, dau of Herbert I)
1 CONT   ((iii)) Hugues I, Count of Paris (b c895, d 16.06.956)
1 CONT   m1. (922) Judith (d 925)
1 CONT   m2. (926/7) Edhild (d 937, dau of Edward 'the Elder', King of England)
