2 CONT * 2. Kirsti, dpt. 23/2 1777.
2 CONT * 3. Maria, dpt. 9/8 1779.
2 CONT * 4. Johanna, dpt. 29/11 1781.
2 CONT * 5. Sven, dpt. 23/10 1785.
2 CONT * 6. Elias, dpt. 9/12 1787, grl. 16/5 1790.
2 CONT i andre ekteskapet
2 CONT * 7. Elias, dpt. 27/5 1792.
2 CONT
