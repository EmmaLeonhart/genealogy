1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 234, nr. 22.a
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 234, nr. 22'''
2 CONT Ola Sveison, son åt nr. 21, f. 7/1 1846, d. 2/3 1935,
2 CONT G. 21/2 1878 m. Grete Maria Ivarsd., Hole nr. 10c, f. 15/2 1845, d. 3/11 1918.
2 CONT Born:
2 CONT * a. Sven, f. 14/12 1878, d. 16/1 1901.
2 CONT * b. Elen Maria, f. 29/1 1881, USA.
2 CONT * c. Ivar, f. 9/2 1883, bonde på farsgarden.
2 CONT * d. Enevald, f. 1/12 1884, bonde på ein part av farsgarden.
2 CONT * e. Elisabet, f. 2/4 1887, g. m. Gabriel Gabrielson nr. 40e.
2 CONT Ola fekk skøyte på farsbruket 11/7 1873, fråskilt alle 6 bruka, i alt 8 l. nr., skyld 2,94 mark, førd 1900 og 1906.
2 CONT
