1 NOTE {geni:about_me} * https://www.slektogdata.no/gravminner/grav/fc0745ab-f359-473d-ab75-132e20fad163
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sveinsvoll, side 267, nr. 41.a
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sveinsvoll, side 267, nr. 42
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sveinsvoll, side 267, nr. 41'''
2 CONT Tollef Tollefson, son åt nr. 37, f. 6/10 1823, d. 13/10 1879,
2 CONT G. I. 16/3 1852 m. Anna Jørgine Torkelsd. nr. 53, f. 10/3 1834, d. 2/10 1866.
2 CONT Born:
2 CONT * a. Tønnes Adolf, f. 5/4 1853, nr. 42.
2 CONT * b. Tobias, f. 24/5 1856, Tjøtta nr. 85.
2 CONT * c. Anna Severine, f. 10/10 1858, USA.
2 CONT * d. Kirsten Maria, f. 11/6 1864, USA.
2 CONT G. II. 21/11 1867 m. Guri Ivarsd., s. Braut nr. 17c, f. 22/5, d. 4/4 1926.
2 CONT Born:
2 CONT * e. Jørgen, f. 15/6 1874, Stavanger, skomakar.
2 CONT * f. Taletta Gedine, f. 9/2 1878, g. m. Ola Nygård, Sandnes.
2 CONT Tollef fekk skøyte på halve farsgarden 25/11 1848, 13 1/2 sp. seinare lagt til 12 skilling frå br. nr. 8, samla skyld 4,36, førd til 1879.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sveinsvoll, side 267, nr. 42'''
2 CONT Tønnes Adolf Tønnesson, son åt nr. 41, f. 5/4 1853, d. 18/1 1830,
2 CONT G. 11/2 1880 m. Taletta Jonasd., Engelsvåg nr. 23b, f. 10/11 1853, d. 15/7 1929.
2 CONT * a. Alfred, f. 4/5 1896, bonde på ein part av farsgarden.
2 CONT * b. Arne Mangor, f. 14/5 1898, bonde på farsgarden.
2 CONT Adolf fekk skøyte på farsgarden 2/6 1883, førd 1900 og 1906, skyld 4,36.
