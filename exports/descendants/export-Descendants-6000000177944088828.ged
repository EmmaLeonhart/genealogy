2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Sørbø, side 278, nr. 42'''
2 CONT Joakim Johannesson, Kleppe nr. 60, f. 26/5 1849, d. 21/4 1922,
2 CONT G. I. 29/5 1873 m. Ingeborg Malena Rasmusd., Hobberstad, Varhaug, f. 4/11 1850, d. 27/1 1885.
2 CONT Born:
2 CONT * a. Gurina, f. 28/11 1878, g. m. Ola Karlson Årrestad, Time.
2 CONT * b. Regina, f. 1/2 1881, g. m. Hans Ellingson, Braut nr. 57a.
2 CONT G. II. 13/12 1887 m. Ane Martinsd. nr. 33, f. 8/2 1864, d. 16/2 1950.
2 CONT * c. Ingebjørg Malena, f. 16/1 1889, g. m. Enevald Karlson, Grude nr. 69.
2 CONT * d. Johannes, f. 28/4 1891, bonde på farsgarden.
2 CONT * e. Magda, f. 12/10 1893, g. m. Oskar Håland, handelsstyrar, Klepp.
2 CONT * f. Tora, f. 16/5 1896, g. m. Tønnes Karlson Anda.
2 CONT * g. Marit, f. 30/1 1899, g. m. Emil Gustavson Skår, Kleppe.
2 CONT * h. Astrid, f. 9/10 1901, g. m. Martin Sivertson, Anda nr. 83b.
2 CONT * i. Magne, f. 3/9 1905, bonde på Laland.
2 CONT * j. Rut, f. 28/1 1910, g. m. Garman Ingebretson, Grude nr. 60c.
2 CONT Joakim fekk skøyte på dette bruket 18/10 1889, utskilt frå br. nr. 1 med skyld 2,30 mark. Dei gamle husa fylgde med dette bruket og ny prestebustad var bygt lenger nede.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Grude, side 108, nr. 69'''
2 CONT Enevald Karlson, son åt nr. 61, f. 26/2 1876,
2 CONT G. I. 1/9 1898 m. Maria Jonasd., Lura, Stangeland nr. 55, f. 15/5 1873, d. 19/4 1910.
2 CONT Born:
2 CONT * a. Jon, f. 24/2 1903, bonde på ein part av farsgarden.
2 CONT * b. Dortea, f. 31/3 1906, husstellærarinna, Stabekk.
2 CONT * c. Karl, f. 15/2 1909, bonde på farsgarden.
2 CONT G. II. 20/12 1929 m. Ingebjørg Malena Joakimsd., Klepp, n. Sørbø nr. 42c, f. 16/1 1889, d. 17/10 1952. Ingi born.
2 CONT Enevald fekk skøyte på halve farsgarden 24/8 1906, skyld 3,03 mark.
2 CONT
2 CONT ----
2 CONT
