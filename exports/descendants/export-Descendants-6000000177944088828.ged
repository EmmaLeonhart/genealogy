2 CONT # Bertel, f. 11/3 1848, Bore, Klepp g. og æ. s. 48, nr. 44.
2 CONT # Lars, f. ikr. 1850, Sømme, bruk 5, huslyd 14.
2 CONT # Salmund, f. ikr. 1852, Klingshei, bruk 5, huslyd 1.
2 CONT # Enok, f. 23/1 1855, Sola, dette bruket, huslyd 14.
2 CONT # Tomas, f. 5/10 1857, Stavanger, foretningsmann.
2 CONT # Elen Serina, f. 9/5 1861, Sømme, bruk 2, huslyd 2.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 48, nr. 44'''
2 CONT Bertel Salomonson, son åt Salomon Larsson Kyrkje-Sola, Håland, f. 11/3 1848, d. 13/4 1940,
2 CONT G. 24/3 1874 m. Elisabet Serina Hansd. nr. 43, f. 24/6 1846, d. 23/4 1921.
2 CONT Born:
2 CONT * a. Hanna Elisabet, f. 3/12 1874, d. 3/12 1890.
2 CONT * b. Seline Emelie, f. 28/11 1878, g. m. nr. 65.
2 CONT * c. Berta Elisabet Hansine, f. 13/7 1890, g. m. Rasmus Sikiniusson, n. Sørbø, nr. 41b. Dei overtok farsgarden hennar.
2 CONT Bertel fekk skøyte på konegarden 20/10 1883, skyld 9,64 mark, og er førd til 1906, då skylda er 6,43 etter at br. nr. 9 er skifta frå.
2 CONT
2 CONT --------------------
2 CONT
2 CONT Bertel fikk skjøte på konegarden 20.10. 1883, ført til 1906.
2 CONT
