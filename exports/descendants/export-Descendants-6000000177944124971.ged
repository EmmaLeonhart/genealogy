2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 233, nr. 8'''
2 CONT Tjærand Jonson, son åt nr. 7, f. 1718, d. 1790,
2 CONT G. m. Kirsten Jonsd., Reke, Håland, f. 1716, d. 30/7 1797.
2 CONT Born:
2 CONT * a. Ola, f. 1748, Stavanger.
2 CONT * b. Berta, f. 1741, g. m. Jan Eilefson, Grude nr. 55.
2 CONT * c. Jon, f. 1760, nr. 9.
