1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 314, nr. 32.a
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 314, nr. 34
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 314, nr. 32'''
2 CONT Asbjørn Asbjørnson, son åt Asbjørn Sivertson, Skeie nr. 21, f. 2/2 1820, d. 12/7 1857,
2 CONT G. 30/6 1846 m. Berta Maria Gunnarsd., Sveinsvoll nr. 51, f. 21/12 1828, d. 3/8 1923, g. 2. m. nr. 33.
2 CONT Born:
2 CONT * a. Gabriel, f. 22/6 1848, nr. 34.
2 CONT * b. Elen Bergitte, f. 26/3 1851, g. m. Jon Sveinson, Erga nr. 12.
2 CONT * c. Asbjørn, f. 27/2 1854, USA.
2 CONT * d. Andreas, f. 29/9 1856, Skeie nr. 24.
2 CONT Asbjørn budde først på konegarden på Sveinsvoll nr. 52, men bytta bruk med nr. 31, og flytta til Vik.
2 CONT Førd 1850-1860. Han fekk skøyte på 12 sp. frå nr. 31 9/7 1850, og på 9 sp. frå Jan Olson 7/7 1852, samla skyld 8,22.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 314, nr. 34'''
2 CONT Gabriel Asbjørnson, son åt nr. 33, f. 22/6 1848, d. 20/10 1884,
2 CONT G. 3/11 1874 m. Johanna Hansd., ø. Åse nr. 10d, f. 12/3 1851, g. 2. m. Jon Sveinson, Erga nr. 12.
2 CONT * a. Berta Maria, f. 24/10 1875, g. m. Andreas Asbjørnson, Skeie nr. 24.
2 CONT * b. Anna Margrete, f. 1/11 1877, g. m. Ole Johannes Olson, Horpestad 40d.
2 CONT * c. Aksliane Amalie, f. 15/7 1879, g. m. Ole Einarson Gjesteland, Stavanger.
2 CONT * d. Asbjørn, f. 22/5 1881, nr. 35.
2 CONT Gabriel fekk skøyte på farsgarden 5/4 1862, førd til 1897. Etter frådrag for br. nr. 8, vart skylda 6,98.
2 CONT
2 CONT ----
2 CONT
2 CONT Gabriel fikk skjøte på farsgarden 5.4.1862, ført til 1897. 
