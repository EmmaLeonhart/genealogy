2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Ytre Salte, side 230, nr. 27'''
2 CONT Henrik Henrikson, son åt nr. 24, f. 31/12 1855, d. 12/7 1941,
2 CONT G. 1/4 1880 m. Martine Tønnesd., Anda nr. 15c, f. 1/4 1857, d. 13/3 1931.
2 CONT Born:
2 CONT * a. Margit, f. 6/9 1884, g. m. Torvald Konrad Ludvigsen, Bergen.
2 CONT * b. Henrik, f. 20/3 1886, bonde på farsgarden.
2 CONT * c. Torvald, f. 3/2 1888, Bryne, malar.
2 CONT * d. Ommund Teodor, f. 21/5 1890, Bryne, malar.
2 CONT * e. Anna, f. 21/1 1892, ug.
2 CONT * f. Magnhild, f. 7/10 1893, g. m. Kristoffer Torkelson Norheim, Bryne.
2 CONT * g. Sigurd, f. 10/9 1895, Bryne, møllearbeidar.
2 CONT * h. Jon, f. 3/1 1902, småbrukar, Rossaland, Time.
2 CONT Henrik fekk skøyte på halve farsgarden 9/8 1879, førd 1900 og 1906, skyld 3,10 mark.
