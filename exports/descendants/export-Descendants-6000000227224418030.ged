2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 177, nr. 52'''
2 CONT Jon Sveinson, son åt nr. 51, f. 1756, d. 7/10 1832,
2 CONT G. 22/11 1795 m. Sara Monsd., Erga nr. 8c, f. 1764, d. 29/10 1845.
2 CONT Born:
2 CONT * a. Hans, f. 25/11 1798, nr. 53.
2 CONT Jon fekk bøgsel på farsgarden 6/11 1792, førd til 1832, enkja til 1848.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 177, nr. 53'''
2 CONT Hans Jonson, son åt nr. 52, f. 25/11 1798, d. 13/1 1870,
2 CONT G. 28/12 1827 m. Helga Olsd., Høyland, Hå, sjå ø. Sørbø nr. 5b, f. 2/1 1809, d. 21/9 1890.
2 CONT Born:
2 CONT * a. Maren Serina, f. 20/10 1827, d. 11/6 1860, ug.
2 CONT * b. Jon, f. 16/10 1830, d. 27/10 1852.
2 CONT * c. Ola, f. 29/6 1833, nr. 58.
2 CONT * d. Andreas, f. 10/6 1836, Stavanger, skippar.
2 CONT * e. Johan Eilert, f. 25/1 1841, Stavanger, skreddar.
2 CONT * f. Svein, f. 13/7 1844, sjømann, bleiv.
