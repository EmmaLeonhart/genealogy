2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 68
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 67'''
2 CONT Ola Olson, son åt nr. 66, f. 17/2 1823, d. 24/3 1915,
2 CONT G. I. 21/6 1859 m. Tabitta Pedersd., Tårland, Nærbø, f. 25/11 1826, d. 7/7 1871.
2 CONT Born:
2 CONT * a. Ola, f. 27/5 1861, nr. 68.
2 CONT * b. Malena, f. 1/3 1866, g. m. Bernt Berntson Bryne, Time.
2 CONT G. II. 21/3 1872 m. Anna Berta Johannesd., Høyland, Nærbø, f. 1/12 1840, d. 6/8 1924.
2 CONT Born:
2 CONT * c. Tabitta, f. 3/5 1872, g. m. Martin Olson, Erga nr. 16b, g. 2. m. Karl Jonson, Pollestad nr. 34.
2 CONT * d. Elisabet Justine, f. 9/1 1875, g. m. Rasmus Gabrielson Høyland, Nærbø.
2 CONT * e. Maria, f. 13/1 1880, ug., d. 14/1 1898.
2 CONT * f. Olava Bertine, f. 29/10 1885, g. m. Nils Nilsson Re, Time.
2 CONT Ola fekk skøyte på 9 sp. frå faren 26/10 1860, skøyte frå Kongen på 8 sp. s. d. førd til 1890.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 68'''
2 CONT Ola Olson, son åt nr. 67, f. 27/5 1861, d. 26/7 1841,
2 CONT G. 22/4 1887 m. Kirstine Marie Andreasd., Søyland, Nærbø, f. 27/10 1867.
2 CONT Born:
2 CONT * a. Tabitta, f. 14/7 1887, Stavanger.
2 CONT * b. Anna, f. 14/4 1889, Stavanger.
2 CONT * c. Ole, f. 10/4 1891, Bryne.
2 CONT * d. Ommund, f. 10/1 1893, Stavanger.
2 CONT * e. Martin, f. 22/10 1895, Bryne.
2 CONT Ola fekk skøyte på farsgarden 17/5 1890, førd til 1892, flytta til Bryne.
2 CONT
