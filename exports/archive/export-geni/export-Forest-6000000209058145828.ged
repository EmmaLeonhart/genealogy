2 CONT http://books.google.com/books?id=AY25QuPMkmMC&pg=PA63&lpg=PA63&dq=scota+mother&source=bl&ots=a6EgmJZSbx&sig=SKUYOlfrcRT0dqT1GnQF9GJ2ihk&hl=en&sa=X&ei=lGJYUrWTD7KkyAGv9oHwAQ&ved=0CDAQ6AEwATgK#v=onepage&q=scota%20mother&f=false
