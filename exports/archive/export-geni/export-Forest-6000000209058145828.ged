2 CONT
2 CONT ------------------------------------------------------------------------
2 CONT
2 CONT Consort(s) Nefertiti, Kiya, Meritaten?, possibly Ankhesenpaaten 
2 CONT
2 CONT Children Smenkhkare? Meritaten, Meketaten, Ankhesenpaaten, Neferneferuaten Tasherit, Neferneferure, Setepenre, Tutankhamun, Ankhesenpaaten-ta-sherit? 
2 CONT
