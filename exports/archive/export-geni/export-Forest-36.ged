1 NOTE {geni:about_me} https://ru.wikipedia.org/wiki/%D0%9C%D1%81%D1%82%D0%B8%D1%81%D0%BB%D0%B0%D0%B2_%D0%A0%D0%BE%D1%81%D1%82%D0%B8%D1%81%D0%BB%D0%B0%D0%B2%D0%B8%D1%87_%D0%A5%D1%80%D0%B0%D0%B1%D1%80%D1%8B%D0%B9
