2 CONT http://books.google.com.bo/books?id=n5Cx1ku7gPcC&pg=PA14&lpg=PA14&dq=Tadeo+Fernandez+Davila+Eyzaguirre&source=bl&ots=5bADmyzQ9o&sig=bwRRy_lCxOBBLOpXBcNrVvKxvhg&hl=es&sa=X&ei=ubEhUdXZE4200QGp6oC4Cw&ved=0CFMQ6AEwBw#v=onepage&q=Tadeo
2 CONC %20Fernandez%20Davila%20Eyzaguirre&f=false
