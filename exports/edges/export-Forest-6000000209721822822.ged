2 CONT https://books.google.com.ar/books?id=vME2AAAAMAAJ&pg=PA334&lpg=PA334&dq=Suero+V%C3%A1zquez+de+Mosquera+y+Moscoso&source=bl&ots=DAkTlWo72Q&sig=0IUKQL8Ol5R-TtPD6_ydEkN9Ky8&hl=es-419&sa=X&ei=jgUZVferM63IsQTLhILYBg&ved=0CCMQ6AEwAg#v=o
