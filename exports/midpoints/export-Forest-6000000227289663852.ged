2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Horpestad, side 132, nr. 21'''
2 CONT Østen Knutson, son åt Knut Øysteinson, Kleppe nr. 85, f. 7/7 1823, d. 20/10 1915,
2 CONT G. 14/4 1852 m. Else Kirstine Ellingsd., Årrestad, Helleland, f. 8/10 1828, d. 17/5 1901.
2 CONT Born:
2 CONT * a. Maren Kirstine, f. 5/7 1852, g. m. Hans Ellingson, ø. Horpestad nr. 22.
2 CONT * b. Karen Valette, f. 23/11 1853, g. m. Ola Olson Stavnheim, Varhaug.
2 CONT * c. Elling, f. 23/5 1857, nr. 22.
2 CONT * d. Malena, f. 3/5 1862, USA.
2 CONT * e. Østen, f. 12/7 1864, ug., d. 29/11 1938.
2 CONT * f. Johan Gabriel, f. 23/4 1866, Stavanger.
2 CONT * g. Eilert Marselius, f. 25/7 1868, sjømann, drukna i Hull, England 10/8 1889.
2 CONT Østen er førd som husmann på Stokholen 1865-1900.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øvre Horpestad, side 135, nr. 22'''
2 CONT Hans Ellingson, son åt Elling Hansson Ivesdal, Bjerkreim, f. 25/11 1859, d. 21/11 1952,
2 CONT G. I. 25/4 1884 m. Gurine Bergitte Johannesd. nr. 19, f. 23/5 1862, d. 13/11 1895.
2 CONT Born:
2 CONT * a. Inga Serina, f. 6/11 1884, g. m. Ola Jakobson Salhus.
2 CONT * b. Anna, f. 7/6 1886, g. m. Lerbrekk, Varhaug.
2 CONT * c. Elen, f. 13/9 1888, g. m. Alfred Sjurson, Hana 87B, Høyland.
2 CONT * d. Johanna, f. 29/7 1890, g. m. Jonas Danielson Tjelta, Vigrestad.
2 CONT * e. Hans, f. 31/8 1892, USA.
2 CONT * f. Gurine, f. 26/7 1894, g. m. Laurits Abrahamson Ueland, Nærbø.
2 CONT G. II 7/11 1896 m. Maren Kirstine Østensd., n. Horpestad nr. 21a, f. 5/7 1852, d. 2/7 1922. Ingi born.
2 CONT G. III. 27/10 1923 m. Inger Johannesd., Østli, Fister, f. 30/5 1877, d. 28/8 1959. Ingi born.
2 CONT Hans fekk skøyte 9/7 1895, førd til 1899, budde seinare på Gjeishaug u. n. Horpestad, og var den siste husmann i Klepp.
