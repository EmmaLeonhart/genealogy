2 CONT * g. Guri, f. 1762, ug., d. 13/11 1825.
2 CONT Svein fekk bøgsel på farsgarden 10/3 1744, førd til 1791.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Erga, side 84, nr. 67'''
2 CONT Ola Svenson, son åt Sven Olson Orre nr. 51, f. 1753, d. 30/6 1827,
2 CONT G. m. Anna Kirstine Jansd., Kleppe nr. 92a, f. 1756, d. 7/5 1848.
2 CONT Born:
2 CONT * a. Sven, f. 1790, nr. 68.
2 CONT * b. Ingeborg, f. 31/3 1793, ug., d. 21/12 1860, legdslem.
