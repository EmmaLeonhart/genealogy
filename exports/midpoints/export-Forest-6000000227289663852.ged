1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hodne, side 124, nr. 34.g
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øystre Bore, side 54, nr. 30
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øystre Bore, side 54, nr. 31
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hodne, side 124, nr. 34'''
2 CONT Kristoffer Person, son åt nr. 4, f. 1651,
2 CONT G. I. m. enkja etter nr. 33, Karen Gunnarsd., d. 1695.
2 CONT Born:
2 CONT * a. Tore, Stavnheim, Varhaug.
2 CONT * b. Per, f. 1684.
2 CONT * c. Ivar, f. 1688.
2 CONT * d. Søren, f. 1690.
2 CONT G. II. m. Malena Klausd., Anda nr. 21a, enkja etter Ola Torgerson Eikeland, Fjermestad, Time.
2 CONT Born:
2 CONT * e. Klaus, f. 1702.
2 CONT * f. Ola, f. 1705, nr. 35.
2 CONT * g. Karen, g. 1. m. Johannes Olson, ø. Bore nr. 30, g. 2. m. Tolleiv Øysteinson, ø. Bore 31.
2 CONT * h. Karen.
2 CONT Kristoffer er førd i manntallet 1701, og 1706 og 1723 brukar han 12 sp. Tiendeskatten 1683-1687. Lagrettemann 1685-1719. Førd til 1727.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øystre Bore, side 54, nr. 30'''
2 CONT Johannes Olson, son åt Ola Husvegg, Varhaug, f. 1667, d. 1746,
2 CONT G. I. m. Helga Villumsd.
2 CONT Born:
2 CONT * a. Ola, Nese, nr. 9.
2 CONT * b. Ola, f. 1716, Hodne, nr. 7.
2 CONT * c. Kari, g. m. Ola Kristofferson Hodne 35, g. 2. m. Albret Erikson Hodne 6.
2 CONT G. II. m. Kari Kristoffersd., Hodne nr. 34, g. 2. m. nr. 31.
2 CONT Born:
2 CONT * d. Ola, f. 1732.
2 CONT * e. Villum, f. 1736.
2 CONT * f. Johannes Kristoffer, f. 1744.
2 CONT * g. Helga, f. 1728, g. m. Eivind Pederson Reve nr. 40.
2 CONT * h. Malena, f. 1730.
2 CONT * i. Inger, f. 1737.
2 CONT Johannes fekk bøgsel på 16 sp. 13/12 1720, førd til 1746. Førd frå 1711.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øystre Bore, side 54, nr. 31'''
2 CONT Tolleiv Øysteinson, son åt Øystein Tolleivson, v. Bore nr. 30, f. 1725, d. 8/10 1809,
2 CONT G. I. m. enkja etter nr. 30, Kari Kristoffersd., som d. 1759. Ingi born.
2 CONT G. II. m. Jorun Jonsd., Kvalbein, Ogna, f. 1732, d. 1778.
2 CONT Born:
2 CONT * a. Kari, f. 1760, g. m. Jon Gunnarson Sveinsvoll 36.
2 CONT * b. Jon, f. 1762, nr. 32.
2 CONT * c. Øystein, f. 1764, Grude, nr. 65.
2 CONT * d. Eli, f. 1770, g. m. Tollak Larsson, n. Sørbø 31.
2 CONT Tolleiv er førd 1748-1781. Han fekk skøyte på 16 sp. 16/9 1771. 30/6 1749 er det sak om steinkasting mot Kari Bore og Tosten Bore. Tosten var død og Kari mødte ikkje.
