2 CONT xxxx
2 CONT Far                                          Mor	
2 CONT Mogens Joensson 	Elisabeth Eriksdatter 	
2 CONT Ekteskap 1	Barn	
2 CONT Omk 1580 - Jens Pederson 	- - NN Jensson   
2 CONT
