2 CONT http://books.google.com/books?id=kKoHAAAAQAAJ&pg=PA567&dq=emerentia+Rydelius&hl=en&ei=7VJoTpHmLcrksQL6-IykDg&sa=X&oi=book_result&ct=result&resnum=1&ved=0CCwQ6AEwAA#v=onepage&q=lysing&f=false
