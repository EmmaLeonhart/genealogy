2 CONT *Kjønn 	Mann 
2 CONT *Død 	1614 
2 CONT *Far 	Nils Kristenson Gjersvik,   f. 1570,   d. 1614 
2 CONT *Mor 	Anna Johannesdtr Galtung,   f. 1575,   d. 1647 
2 CONT
2 CONT Barn>
2 CONT
2 CONT *1. Gunnbjørg Nilsdtr Medhus
2 CONT
