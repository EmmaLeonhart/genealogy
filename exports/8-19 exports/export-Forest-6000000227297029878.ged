1 NOTE {geni:about_me} Anna Cathrina (Jürgens) Irgens
2 CONT
2 CONT Far:	Johannes (Jürgens) Irgens
2 CONT
2 CONT Mor:	Elisabeth Sophie Anna Arnisaeus
2 CONT
2 CONT Født:	ca 1640	 Itzehoe, Holstein, Tyskland 1 2
2 CONT
2 CONT Død:	1669	3
2 CONT
2 CONT Begravelse:	12 Mar 1669	 Aker kirke, Aker, Akershus, Norge 4
2 CONT
2 CONT Familie 1
2 CONT
2 CONT Ektefelle/Partner:	Henrich Sigismund Hassius	 f. 1630 d. 17 Okt 1698
2 CONT
