2 CONT ''Historiska kartor Lantmäteriet'', https://historiskakartor.lantmateriet.se/hk/viewer/internal/V3/4c4d535f5633/lms2/LMS/%C3%96ver%20h%C3%A4lsingland%20och%20medelpad/Karta
