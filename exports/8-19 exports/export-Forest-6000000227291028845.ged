2 CONT * Lund historie I, Gårdens og slektens liv, Kjørmo, side 551, nr. II
2 CONT
2 CONT '''Lund historie I, Gårdens og slektens liv, Kjørmo, side 551, nr. I'''
2 CONT Omund Olsen. F. 29-7-1790, sønn av Ole Omundsen Rusdal, br. nr. 2.
2 CONT G. 18-10-1813 m. Berte Helene Rasmusdatter, f. 14-10-1788, dtr. av Rasmus Knutsen Kjørmo, br. nr. 1.
2 CONT De fikk skj. av Rasmus på 13 1/2 bm., dat. 6-4-1813. Folge 1860.
2 CONT Berte Helene d. 25-3-1855, Omund d. 27-12-1869.
2 CONT Barn:
2 CONT # Ole, dpt. 2-1-1814, d. som spebarn.
2 CONT # Peder, dpt. 26-3-1815, grl. 25-6 s. a.
2 CONT # Berte, f. 2-7-1817, d. som spebarn.
2 CONT # Berte, f. 21-5-1819, d. 3-9-1820.
2 CONT # Johannes, f. 7-9-1821, d. 31-7-1822.
2 CONT # Rakel, f. 30-6-1824.
2 CONT # Berte, f. 28-2-1826, d. 14-4 s. a.
2 CONT # Reinert, se nedenfor.
2 CONT # Berte, f. 26-9-1852, g. 26-6-1860 m. enkemann Karl Larssen Kjørmo, br. nr. 3.
2 CONT
2 CONT '''Lund historie I, Gårdens og slektens liv, Kjørmo, side 551, nr. II'''
2 CONT Reinert Omundsen. F. 8-4-1829, fikk skj. 31-5-1860, men faren forbeholdt seg gjenkjøpsrett om Reinert solgte gården.
2 CONT G. 17-12-1863 m. Inger Lisabet Tønnesdatter, f. 22-7-1839, dtr. av Tønnes Larssen Austreim. Hun døde 10-6-1873, sk. 25-2-1819.
2 CONT G. II g. 21-6-1879 m. Anna Olsdatter, f. 13-1-1849, dtr. av Ole Larssen Steinberg, br. nr. 1.
2 CONT Barn i I ekteskap:
2 CONT * 1. Berte, f. 16-1-1864.
2 CONT * 2. Tønnes, f. 22-9-1867.
2 CONT * 3. Anders, f. 12-9-1870.
2 CONT * 4. Gabriel Mikal, f. 12-9-1870.
2 CONT * 5. Ole Johan, f. 3-6-1873, d. 29-5-1877.
2 CONT Barn i II ekteskap:
2 CONT * 6. Oline Sofie, f. 28-3-1880.
2 CONT Hele familien, smått og stort, flyttet til Grøssfjell, Heskestad i 1883.
