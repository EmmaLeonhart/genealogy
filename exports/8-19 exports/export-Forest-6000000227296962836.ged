1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 286, nr. 30.d
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 291, nr. 88
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 286, nr. 30'''
2 CONT Ola Johannesson, son åt nr. 29, f. 9/1 1803, d. 26/4 1870,
2 CONT G. 12/2 1832 m. Dortea Kristine Eriksd., sjå Friestad nr. 62e, f. i Stavanger 1811, d. 27/6 1881.
2 CONT Born:
2 CONT * a. Johannes, f. 3/9 1832, g. m. Johanna Kristiansd. nr. 108d Baker, 1900 bur dei på Anda. Ingi born.
2 CONT * b. Andreas, f. 1/4 1837, nr. 31.
2 CONT * c. Erik, f. 10/4 1841.
2 CONT * d. Berta Malena, f. 13/6 1844, g. m. nr. 88.
2 CONT * e. Serina, f. 5/7 1851, g. m. nr. 88.
2 CONT * f. Kirsten Dortea, f. 1/4 1848.
2 CONT Ola fekk feste etter faren 8/11 1830 og skøyte på bruket 13/7 1846, fråskilt alle tri bruka og 29/10 1850 fekk han skøyte på 1 sp. frå bruk nr. 6. Samla skyld 1,51 mark, førd til 1869.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 291, nr. 88'''
2 CONT Ivar Sveinson, son åt Svein Sveinson, Rosland nr. 88, f. 14/10 1834, d. 19/5 1920,
2 CONT G. I. 9/11 1871 m. Serina Olsd. nr. 30, f. 5/7 1851, d. 1/8 1876.
2 CONT Born:
2 CONT * a. Svein, f. 29/1 1872, nr. 89.
2 CONT * b. Ole Johannes, f. 12/6 1873, USA, d. på Rosland 30/10 1951.
2 CONT G. II. 16/4 1878 m. Berta Malena Olsd. nr. 30, f. 13/6 1844, d. 15/1 1932.
2 CONT * c. Anna Jørgine, f. 2/12 1878.
2 CONT Ivar fekk skøyte 11/7 1873, førd 1900.
2 CONT
2 CONT ----
2 CONT * Reference: [https://www.myheritage.com/research/record-1-321691821-1-504239/berta-malena-olsdatter-tjotta-rosland-born-resfnes-in-myheritage-family-trees?indId=externalindividual-74568d4fc567f7eac3667369603c1ad2&mrid=ff8bff9c14d
