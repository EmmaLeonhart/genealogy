1 NOTE {geni:about_me} Daniel Olofsson
2 CONT
2 CONT Blev högst 68 år. 
2 CONT
2 CONT Far:
2 CONT
2 CONT Olof Israelsson Smed (1703 - 1773)
2 CONT
