1 NOTE {geni:about_me} 1801 https://www.digitalarkivet.no/census/person/pf01058238001018
2 CONT
2 CONT Alm nordre Gnr. 84, bnr. 3 med Hommerstad vestre, gnr. 85, bnr. 3
2 CONT
2 CONT Det er skifte etter Kjeld 15/1 1734, brt. 148, netto 111 rdr. 13/11 1749 får hans sønn, Østen Kjeldsen (1729-21/2 1794) bygselen, og 16/3 1792 overdrar Østen - formedelst alderdom - bygselen til svigersønn Jens Mortensen Skavhauge
2 CONC n av Elverum.
2 CONT
2 CONT I 1803 gir Ole Jonsen som føderåd til Jens Mortensen og kone Marte Østensdtr. en plass under Alm (avlyst 6/10 1857).
2 CONT
2 CONT Østen Kjeldsen, f. 1729, begr. 21/2 1794, g. m. 1. Marte Mogensdtr. (1720 -20/7 1768). Barn:
2 CONT 1) Kirsti, dp. 5/8 1750,
2 CONT 2) Kjeld (1751-54).
2 CONT 3) Kjeld, dp. 7/12 1755, 22/4 1784 g. m. Berte Engebretsdtr.
2 CONT 4) Lisbeth, dp. 31/7 1757.
2 CONT - Østen Kjeldsen, g. m. 2. 31/3 1769 Sofie Kristofersdtr. Løken: Barn:
2 CONT 5) Marte, dp. 5/11 1769, g. m. neste bruker.
2 CONT 6) Thomes, dp. 25/7 1773, 26/8 1796 g. m. Berte Olsdtr. Frangstøen,
2 CONT 7) Ole, dp. 4/2 1776,
2 CONT 8) Kristofer, dp. 6/6 1779.
2 CONT Sofie Kristofersdtr. hadde vært g. m. 1. en Lars, og disses datter, Lisbeth, ble gift med Ole Jonsen, som er eier i 1801. Lisbeth Larsdtr. var g. m. 1. Ole, og hadde i dette ekteskap en datter, Mari Olsdtr., f. 1781, og Mari ble 1
2 CONC 802 g. m. Halvor Rasmussen Lund s.
2 CONT
2 CONT Marte Østensdtr., dp. 5/11 1769, 18/3 1791 g. m. Jens Mortensen Skavhaugen, Elverum. Barn:
2 CONT 1) Johanne, dp. 2/9 1792,
2 CONT 2) Sofie, dp. 16/2 1794.
2 CONT 3) Morten, dp. 31/1 1796,
2 CONT 4) Ingeborg, dp. 23/2 1800.
