2 CONT http://raggragg.dyndns.org/anor/mis/pb60a5bb5.html <nowiki>--------------------</nowiki> Erik Mårtensson
2 CONT
2 CONT Bonde på Skråmträsk 3, Skellefteå sn 15/32 mtl skatte. Blev högst 95 år.
2 CONT
2 CONT Far:
2 CONT
2 CONT Mårten Jönsson (1602 - 1676)
2 CONT
2 CONT Mor:
2 CONT
2 CONT N N (- 1671)
2 CONT
