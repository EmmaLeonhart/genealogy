2 CONT
2 CONT Källor 
2 CONT
2 CONT  1)  Husförhörsvolym FAMREG (1720 - 1742), sid 333 
2 CONT
2 CONT  2)  Erik Holmlund 
2 CONT
2 CONT  3)  Thord Byström, Härnösand, Rötter 
2 CONT
2 CONT   4)  Rolf Lindberg 
