1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Engelsvåg, side 75, nr. 23.h
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Friestad, side 98, nr. 75
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Engelsvåg, side 75, nr. 23'''
2 CONT Ole Johannes Halvorson, son åt Halvor Ivarson, ø. Bore nr. 38, f. 19/6 1833, d. 24/3 1916,
2 CONT G. 4/6 1857 m. Berta Serina Torkelsd., Pollestad 28f, f. 30/10 1830, d. 13/10 1924.
2 CONT Born:
2 CONT * a. Helmik, f. 5/9 1857, ug., d. 10/2 1940.
2 CONT * b. Johanna, f. 18/3 1859, g. m. Gabriel Gabrielson Høyland, Time.
2 CONT * c. Tønnes, f. 24/12 1860, USA.
2 CONT * d. Tolleiv Emanuel, f. 8/5 1863, USA.
2 CONT * e. Bergitte Olava, f. 22/1 1865, USA, g. m. Adolf Johanesson, Tananger.
2 CONT * f. Olaus, f. 31/12 1866, USA, g. m. Ingeborg Josefsd., Kvål, Høyland.
2 CONT * g. Karl, f. 15/12 1870, bonde på ein part av farsgarden.
2 CONT * h. Justine, f. 18/4 1872, g. m. Daniel Danielson Bore, Friestad, nr. 75.
2 CONT * i. Johan, f. 13/6 1876, bonde på farsgarden.
2 CONT Ole Johannes fekk skøyte på 1 1/2 sp. skyld 1,22, og etter fråsal av br. nr. 10, 1,12. Førd 1863, til 1906. Skøyte 24/4 1869.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Friestad, side 98, nr. 75'''
2 CONT Daniel Schive Danielson, son åt Daniel Danielson, v. Bore nr. 36, f. 28/12 1867, d. 11/7 1955,
2 CONT G. 18/11 1898 m. Justine Olsd., Engelsvåg nr. 25h, f. 18/4 1872.
2 CONT Born:
2 CONT * a. Donkard, f. 18/5 1900, bonde på v. Bore.
2 CONT * b. Bertine Olava, f. 2/2 1903, g. m. Lukas Jonasson Skretting, Tjøtta.
2 CONT * c. Ella Sigfrida, f. 17/12 1906, g. m. Knut Larsson Næss, ø. Bore.
2 CONT * d. Johanna, f. 23/10 1913, g. m. Johan Isakson Valdeland, Varhaug.
2 CONT Daniel fekk skøyte 10/7 1897, førd til 1906.
