2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Erga, side 81, nr. 18'''
2 CONT Laurits Velasson, son åt nr. 17, f. 9/1 1851, d. 4/7 1939,
2 CONT G. 5/4 1881 m. Berta Maria Paulsd., Borsok nr. 30b, f. 29/3 1851, d. 25/5 1936.
2 CONT Born:
2 CONT * a. Valdemar, f. 26/7 1883, d. 19/5 1910.
2 CONT * b. Petter Berner, f. 1/5 1885, USA.
2 CONT * c. Antin, f. 22/8 1886, bonde på Orre.
2 CONT * d. Bertel, f. 11/4 1890, d. 24/6 1909.
2 CONT * e. Inga, f. 7/11 1891, g. m. Johannes Jonasson, s. Salte 52e.
2 CONT * f. Bekka, f. 8/3 1894, g. m. Tollef Jensson Re, Bryne, bakar.
2 CONT * g. Leonard, f. 24/4 1897, bonde på farsgarden.
2 CONT Laurits var først husmann, men fekk skøyte på bruket, 46 øre frå br. nr. 1, 4/10 1880, førd 1906.
