2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Friestad, side 96, nr. 54'''
2 CONT Andreas Enokson, son åt nr. 53, f. 20/4 1871, d. 4/11 1960,
2 CONT G. 18/3 1899 m. Johanna Arntsd., Re, Time, f. 19/5 1875, d. 28/7 1932.
2 CONT Born:
2 CONT * a. Erling, f. 29/5 1899, Bryne, d. 20/12 1943.
2 CONT * b. Alma Elisa, f. 7/6 1901, USA, g. m. Kvam.
2 CONT * c. Valborg, f. 25/11 1904, g. m. Bernhard Vagle, Sandnes, tannlækjar.
2 CONT * d. Arne, f. 31/7 1906, timremann, Reke, Håland.
2 CONT * e. Alfred, f. 31/12 1908, bonde på Friestad.
2 CONT * f. Johanna, f. 18/10 1910, g. m. Per Selvig, Tjensvoll.
2 CONT * g. Leif, f. 3/1 1913, bonde på Friestad.
2 CONT * h. Trygve, f. 18/10 1914, Fosse, Time.
2 CONT * i. Bjarne, f. 18/12 1917, ug., heime.
2 CONT * j. Tor, f. 9/10 1919, bonde på Friestad.
2 CONT Andreas fekk skøyte på bruket 6/3 1889, førd 1906. Skyld etter fråsal av 7 øre til br. nr. 6, og 98 øre til br. nr. 15, vart 2,32.
