2 CONT
2 CONT François (July 5, 1487, Pont-à-Mousson) (died at birth)
2 CONT
2 CONT Antoine, Duke of Lorraine (1489–1544)
2 CONT
2 CONT Nicholas (April 9, 1493, Nancy), d. young
2 CONT
2 CONT Claude, Duke of Guise (1496–1550), first Duke of Guise
2 CONT
2 CONT John, Cardinal of Lorraine and Bishop of Metz (1498–1550)
2 CONT
2 CONT Louis, Count of Vaudémont (1500–1528)
2 CONT
2 CONT Francis, Count of Lambesc (1506–1525)
2 CONT
2 CONT Anne (December 19, 1490, Bar-le-Duc – 1491)
2 CONT
2 CONT Isabelle (November 2, 1494, Lunéville – bef. 1508)
2 CONT
2 CONT Claude and Catherine (twins) (November 24, 1502, Bar-le-Duc), d. young
