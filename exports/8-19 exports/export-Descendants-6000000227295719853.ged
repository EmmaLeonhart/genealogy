2 CONT
2 CONT Grafen von Waldeck-Wildungen
2 CONT
2 CONT     * Philipp I.
2 CONT
2 CONT     * Heinrich VIII.
2 CONT
2 CONT     * Philipp IV.
2 CONT
2 CONT     * Daniel
2 CONT
2 CONT     * Heinrich IX.
2 CONT
2 CONT     * Günther
2 CONT
2 CONT     * Wilhelm Ernst
2 CONT
2 CONT     * Christian
2 CONT
