1 CONT
1 CONT Halfdan "The Aged" Sveidansson
1 CONT b. abt 700,  in Oppland, Norway
1 CONT
1 CONT Sveidi "The Sea King" Svidrasson
1 CONT b. abt 650, in Raumsdal, Norway
1 CONT
1 CONT Svidri Heytsson
1 CONT b. abt 600, in Norway
1 CONT
1 CONT Heytir Gorrsson
1 CONT b. abt 425 (!!!) in Raumsdal, Norway
1 CONT
1 CONT Gorr Thorrasson
1 CONT b. abt 365 in Raumsdal, Norway
1 CONT
1 CONT Thorri Snaersson, King in Kvenland
1 CONT b. abt 320, in Raumsdal, Norway
1 CONT
1 CONT Snaer Jokulsson, King in Kvenland
1 CONT b. abt 275, in Finland
1 CONT
1 CONT Jokull Frostasson
1 CONT b. abt 240, in Finland
1 CONT
1 CONT Frosti Karasson, King in Kvenland
1 CONT b. abt 210, in Finland
1 CONT
1 CONT Kari Fornjotsson, King in Kvenland
1 CONT b. abt 185, in Finland
1 CONT
1 CONT Fornjotur, King in Kvenland
1 CONT b. abt 160
