2 CONT
2 CONT 2.2.3.1. Musel II (+ca. 592) 
2 CONT
2 CONT 2.2.3.1.1. Kahan Gail (fl. 592-604) 
2 CONT
2 CONT 2.2.3.1.1.1. Smbat the Valiant (fl. 604) 
2 CONT
2 CONT 2.2.3.1.1.1.1. Musel III (+640) 
2 CONT
2 CONT 2.2.3.1.1.1.1.1. Grigor I (fl. 650) 
