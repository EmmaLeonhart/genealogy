2 CONT https://books.google.es/books?id=o8wnTykH3FYC&pg=PA144&lpg=PA144&dq=II+conde+de+Monterroso&source=bl&ots=V_6YFfpXEI&sig=ACfU3U2xwgVdZTzVbBWv9-qaYCruHdTZUA&hl=en&sa=X&redir_esc=y#v=onepage&q=II%20conde%20de%20Monterroso&f=false
2 CONT
