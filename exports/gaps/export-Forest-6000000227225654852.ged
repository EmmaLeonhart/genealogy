2 CONT https://books.google.pt/books?id=mnVS7V2RdQcC&pg=PA171&lpg=PA171&dq=armentario+Muniz&source=bl&ots=27e1TQNZfr&sig=ACfU3U3lQIcijjebYGQ5aWBG2NRefM-q_g&hl=pt-PT&sa=X&ved=2ahUKEwjH6s2U34fhAhVb5eAKHX4tC8wQ6AEwAnoECAQQAQ#v=onepage&q=arm
