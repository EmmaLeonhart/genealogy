2 FILE https://media.geni.com/p14/ae/dd/0f/e3/534448673fdc6046/naphtali_neumark_heller_mirels_compiler_cherson_adam_01dec2024_original.jpg?hash=ed79f0d6780598a0c49f57e0c544826e22010c2a563505e3802296fd5fd24b66.1794643199
