2 CONT Quellen / Sekundärliteratur
2 CONT sk, S. 348, Nr. 39
2 CONT MF, S. 37, Nr. 4 (ET: 44-11)
2 CONT ET 20.IX.1659
2 CONT Dietz, S. 257ff. (zum Vater und zum Gatten)
2 CONT NoHo
