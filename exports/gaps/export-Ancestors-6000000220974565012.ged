2 CONT http://books.google.no/books?id=zBurLat60hIC&pg=PA83&lpg=PA83&dq=Gaius+Lucilius+Hirrus&source=bl&ots=geKppVT-2_&sig=WH46M9Tl7qk7ckBJb9kkBmIBhGY&hl=en&sa=X&ei=NBs8T_CAHaeB4ATXq72kBg&redir_esc=y#v=onepage&q=Gaius%20Lucilius%20Hirrus
