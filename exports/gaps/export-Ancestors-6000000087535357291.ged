2 CONT
2 CONT   Gertrud
2 CONT
2 CONT   um 1030/35-4.8.1115
2 CONT
2 CONT     1050
2 CONT
2 CONT   1. oo Florenz I. Graf von Holland
2 CONT
2 CONT                  -28.6.1061
2 CONT
2 CONT     1063
2 CONT
2 CONT   2. oo Robert I. der Friese Graf von Flandern
