1 NOTE {geni:about_me} 806 *  Thore  Eriksen  Huusbonde  30  Gift 1ste gg  Bonde og gaardbruger  M   
2 CONT
2 CONT 807  Siri  Thorsdtr  Hs kone  32  Gift 1ste gg   K   
2 CONT
2 CONT 808  Thore  Thorsen  Deres børn  8    M   
2 CONT
2 CONT 809  Thore  Thorsen  Deres børn  5    M   
2 CONT
2 CONT 810  Ragnil  Thorsdtr  Deres børn  2    K   
2 CONT
