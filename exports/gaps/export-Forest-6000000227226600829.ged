2 CONT http://books.google.com/books?id=4KRAAAAAcAAJ&pg=PA150&lpg=PA150&dq=Elizabeth+Danvers+Poure&source=bl&ots=eQKYPXK-Bl&sig=x7IGc0gDBC6X4wQ_sUZ4Fim5Oos&hl=en&ei=nTO7TIGmO4TQsAOa-IWwDw&sa=X&oi=book_result&ct=result&resnum=10&ved=0CC8Q
