2 CONT # Eggert	Heytmann	1463-1483
2 CONT # Oluf	Sebbisen	1500-1504
2 CONT # Clawes	Ankersen	1503
2 CONT # Nic.	Krøger	1509
2 CONT # Jürgen	Anckersen	1510 ,,,,,
