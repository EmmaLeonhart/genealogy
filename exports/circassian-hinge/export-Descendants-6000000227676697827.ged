1 NOTE {geni:about_me} https://ru.wikipedia.org/wiki/%D0%9C%D0%B5%D0%BB%D0%B8%D0%BA%D0%BE%D0%B2,_%D0%9D%D0%B8%D0%BA%D0%BE%D0%BB%D0%B0%D0%B9_%D0%9B%D0%B5%D0%B2%D0%B0%D0%BD%D0%BE%D0%B2%D0%B8%D1%87#:~:text=%D0%9A%D0%BD%D1%8F%D0%B7%D1%8C%20%
2 CONC D0%9D%D0%B8%D0%BA%D0%BE%D0%BB%D0%B0%D0%B9%20%D0%9B%D0%B5%D0%B2%D0%B0%D0%BD%D0%BE%D0%B2%D0%B8%D1%87%20%D0%9C%D0%B5%D0%BB%D0%B8%D0%BA%D0%BE%D0%B2%20(%D0%B3%D1%80%D1%83%D0%B7,%D0%BF%D0%BE%D0%BB%D0%BA%D0%B0%20(1915%E2%80%941917).
