1 NOTE {geni:about_me} Anne Jensdatter Bagge
2 CONT
2 CONT http://finnholbek.dk/genealogy/getperson.php?personID=I17982&tree=2
2 CONT
2 CONT ABT 1440 - ____
2 CONT
2 CONT BIRTH: ABT 1440 
2 CONT
2 CONT ? Father: Jens Mortensen SEEFELD 
2 CONT
2 CONT ? Mother: Birthe Nielsdatter BANNER 
2 CONT
2 CONT Family 1 : Jens Madsen MUNK 
2 CONT
2 CONT +Ellen Jensdatter MUNK 
2 CONT
2 CONT Køn  Kvinde  
2 CONT
2 CONT Person-ID  I17982  Skeel, Holbek, Santasilia and Muckadell 
2 CONT
2 CONT Sidst ændret  21 Aug. 2008  
2 CONT
2 CONT    OGSÅ KALT BAGGE
2 CONT
2 CONT Familie  Jens Madsen Munk (Vinranke),   f. Ca. 1416,   d. 1501  
2 CONT
2 CONT Børn  > 1. Elne Jensdatter Munk (Vinranke),   d. Eft. 1511, Skovgaard  
2 CONT
2 CONT > 2. Marine Jensdatter Munk (Vinranke),   d. Eft. 1511 
2 CONT
2 CONT   3. Julien Munk (Vinranke),   d. Eft. 1503 
2 CONT
