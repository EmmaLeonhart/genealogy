2 CONT
2 CONT Niels Munk (Vinranke)[1]
2 CONT
2 CONT  - 1650 Død før 21 jul. 1650 
2 CONT
2 CONT
2 CONT Far 	Peder Munk (Vinranke),   d. eft. 1610 
2 CONT
2 CONT Mor 	Anne Madsdatter Skade II. 
2 CONT
2 CONT Familie 1 	Kirsten Jørgensdatter Harbou 
2 CONT
2 CONT Familie 2 	Sidsel Mortensdatter Skinkel (med Lillien),   d. før 24 nov. 1642 
2 CONT
2 CONT Børn 	
2 CONT
2 CONT  	1. Peder Munk (Vinranke),   d. før 1650
2 CONT
2 CONT  	2. Morten Munk (Vinranke),   d. før 1650
2 CONT
2 CONT  	3. Claus Munk (Vinranke),   d. eft. 1650
2 CONT
2 CONT  	4. Didrik Munk (Vinranke),   d. før 1650
2 CONT
2 CONT  	5. Poul Munk (Vinranke),   d. eft. 1650
2 CONT
2 CONT >	6. Niels Munk (Vinranke),   d. eft. 1650
2 CONT
2 CONT >	7. Laurids Munk (Vinranke),   d. 2 mar. 1702, København (Copenhagen) 
2 CONT
