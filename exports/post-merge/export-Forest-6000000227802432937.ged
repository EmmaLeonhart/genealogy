2 CONT
2 CONT
2 CONT =Sources=
2 CONT
2 CONT *  1)  Gustaf Elgenstierna, Den introducerade svenska adelns ättartavlor  
2 CONT
2 CONT *  2)  Dick Harrison - Karl Knutsson  
2 CONT
