2 CONT
2 CONT d. 1183, age: 63 
2 CONT
2 CONT ali.	 
2 CONT
2 CONT Sigrid Torkjell daughter of Bird
2 CONT
2 CONT b. 1120 
2 CONT
2 CONT d. 1150, age: 30 
2 CONT
2 CONT ali.
2 CONT
2 CONT Children
2 CONT
