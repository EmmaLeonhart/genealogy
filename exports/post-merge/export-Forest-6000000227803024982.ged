2 CONT
2 CONT Alias/AKA 	Anders Larsson
2 CONT
2 CONT Father 	Laurits Andersen (1535-ca1600)
2 CONT
2 CONT Mother 	Kirsten Jakobsdatter
2 CONT
2 CONT Marriage 	1593, Talle, Luster
2 CONT
2 CONT Children 	
2 CONT
