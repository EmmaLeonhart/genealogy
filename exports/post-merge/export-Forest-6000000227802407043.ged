2 CONT
2 CONT [2] Aktstk N Stænd M. I 45
2 CONT
2 CONT [3] NRR III 297
2 CONT
2 CONT [4] ALR 10 I, Hadelands fogderegnsk. 1599/1600, dat. 19.4.1600
2 CONT
2 CONT [5] Edsprot. s. 44
2 CONT
2 CONT [6] Aktstk. n. Stænd. M. I, 131
2 CONT
2 CONT [7] NHD 2R IV 30
2 CONT
2 CONT --------------------
2 CONT Hågen Mogensen Gyldenaar, hadde vært sogneprest i Vang prestegjeld i 1591- 1610. 
2 CONT --------------------
2 CONT Haakon Mogenssøn Gyldenaar
2 CONT
2 CONT 1552 - 31 Jul 1610
2 CONT
