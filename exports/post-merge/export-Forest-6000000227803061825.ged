2 CONT
2 CONT --------------------
2 CONT
2 CONT MORGENSTIERNE, Christopher d.e.
2 CONT
2 CONT 3 Jan 1619 - 12 Nov 1679
2 CONT
2 CONT     * TITLE: d.e.
2 CONT
2 CONT     * BIRTH: 3 Jan 1619, Flahammer, Luster, Sogn og Fjordane, Norway
2 CONT
2 CONT     * DEATH: 12 Nov 1679, Flahammer, Luster, Sogn og Fjordane, Norway
2 CONT
2 CONT     * BURIAL: Dale, Luster, Sogn og Fjordane, Norway
2 CONT
2 CONT     * EVENT: Occupation: fogd 
2 CONT
2 CONT Father: MORGENSTIERNE, Giert
2 CONT
2 CONT Mother: GLAD, Birgitte
2 CONT
2 CONT Family 1 : MUNTHE, Birgitte
2 CONT
2 CONT     * MARRIAGE: 1657, Bergen, Hordaland, Norway
2 CONT
2 CONT    1. +MUNTHE, Ludvig
2 CONT
2 CONT    2. +MUNTHE, Otto
2 CONT
