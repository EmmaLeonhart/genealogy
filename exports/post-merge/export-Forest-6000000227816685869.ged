2 FILE https://media.geni.com/p14/8c/78/82/d1/53444862e3c5a04c/function_of_tghe_ynglinga_saga_original.pdf?hash=447c2857a900f5836dfeb3064c4ca2ed6b3bf852dcbcfc3e73a882eaec666fd4.1797667199
