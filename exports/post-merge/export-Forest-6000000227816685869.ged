2 CONT http://books.google.com/books?id=sARnqncdK48C&pg=PA13&lpg=PA13&dq=Viga-Rapp+Sumarlid&source=bl&ots=AQbloSzOWj&sig=CIrlHJrdxLHnFkpVL3xs_8zCz70&hl=en&ei=CP3DTI-3OI7qOajHgYkM&sa=X&oi=book_result&ct=result&resnum=4&ved=0CCEQ6AEwAw#v=o
