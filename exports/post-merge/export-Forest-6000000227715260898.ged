1 NOTE KNOWN AS "THE GREAT"; COUNT OF VALOIS & VEXIN
1 NOTE 	1  NAME the Great //
2 CONT 	2  GIVN the Great
2 CONT 	2  SURN
2 CONT 	2  NICK the Great
1 NOTE 	1  NAME the Great //
