2 CONT Estrid
2 CONT
2 CONT Född:   979
2 CONT
2 CONT --------------------------------------------------------------------------------
2 CONT
2 CONT Familj med Olof >> Skötkonung (Eriksson) (980 - 1022)
2 CONT
