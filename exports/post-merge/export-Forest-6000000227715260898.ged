2 CONT #Yaroslav Vladimirovich
2 CONT #Mstivslav Vladimirovich "the Brave"
2 CONT #Vsevolod Vladimirovich
2 CONT #2 unnamed daughters (first)
2 CONT #second
2 CONT #Sviatopolk Vladimirovich
2 CONT #Vysheslav Vladimirovich
