2 CONT # https://www.nb.no/items/83fc76dbac197483ddb601b890e2fa98?page=119&searchText=%C3%A6tt%20og%20heim%201972
2 CONT --------------------
2 CONT http://vagshaug.no/allslekt/1214.htm
