1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 173, nr. 6.d
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nord-Braut, side 63, nr. 26
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nord-Braut, side 63, nr. 27
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 173, nr. 6'''
2 CONT Lars Erikson, son åt Erik Ormson Nærland, Nærbø, sjå Kleppe nr. 3c, d. 1692,
2 CONT G. m. Guri Bjørnsd., Hognestad, g. 2. m. nr. 7.
2 CONT Born:
2 CONT * a. Erik, f. 1681, Vik nr. 7.
2 CONT * b. Guri, g. m. Ingebret Ingebretson, n. Braut 7, g. 2. m. Elling Torgerson, n. Braut 8.
2 CONT * c. Ingeborg, g. m. Frants Jonson Høyland, Nærbø.
2 CONT * d. Lisbet, g. m. Torger Kristofferson, n. Braut 26, g. 2. m. Mons Olson ,n. Braut nr. 27.
2 CONT Lars er førd i tiendeskatten 1681-1683.
2 CONT Han vart gravlagt i Kyrkja og det kosta 3 rdl.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nord-Braut, side 63, nr. 26'''
2 CONT Torger Kristofferson, son åt nr. 24, f. 1643, d. 1711,
2 CONT G. I. m. Barbro Larsd., Tårland, Nærbø, d. 1700.
2 CONT Born:
2 CONT * a. Elling, f. 1669, nr. 8.
2 CONT * b. Laurits, d. før 1711, vanfør.
2 CONT * c. Malena, g. m. Ola Nilsson Erga, nr. 54.
2 CONT * d. Mari, g. m. Rasmus Sveinson Fosse, Time.
2 CONT * e. Barbro, f. 1691, g. m. Gunnar Rasmusson Garborg, Time.
2 CONT G. II. m. Lisbet Larsd., Orre nr. 6d, g. 2. m. nr. 27.
2 CONT Born:
2 CONT * f. Guri, f. 1704, d. før 1711.
2 CONT * g. Lars, f. 1706, Tu, nr. 43.
2 CONT Torger er førd i skattemanntall 1681-83, lagrettemann 1688-1707. Førd i manntallet 1701. Enkja er førd 1711.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nord-Braut, side 63, nr. 27'''
2 CONT Mons Olson, son åt Ola Monson, n. Øksnevad nr. 6, f. 1688-1748,
2 CONT G. 1711 m. enkja etter nr. 26, Lisbet Larsd.
2 CONT Born:
2 CONT * a. Ola, f. 1717, Tårland, Nærbø.
2 CONT * b. Gabriel, f. 1721, Skeie, nr. 7.
2 CONT * c. Lars, f. 1720, n. Øksnevad, nr. 9.
2 CONT Mons fekk bøgsel på 24 sp. 17/12 1711 då han gifta seg med enkja.
2 CONT Han er førd som brukar 1712-1728, flytta seinare heim til farsgarden, n. Øksnevad nr. 8.
