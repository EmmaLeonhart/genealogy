2 CONT G. 12/11 1829 m. Olina Olsd., Malmeim 54, Høyland, f. 28/5 1809, d. 1/3 1888.
2 CONT Born:
2 CONT * a. Ivar, f. 16/12 1830, USA.
2 CONT * b. Ola, f. 7/3 1835, nr. 12.
2 CONT * c. Jon, f. 18/5 1840, nr. 16.
2 CONT * d. Jens, f. 14/1 1843, nr. 14.
2 CONT * e. Kornelius, f. 1/9 1844, d. 18/11 1862.
2 CONT * f. Karen, f. 7/4 1832, d. 13/7 1849.
