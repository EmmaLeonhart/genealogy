1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nord-Braut, side 63, nr. 27.b
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Skeie, side 249, nr. 7
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nord-Braut, side 63, nr. 27'''
2 CONT Mons Olson, son åt Ola Monson, n. Øksnevad nr. 6, f. 1688-1748,
2 CONT G. 1711 m. enkja etter nr. 26, Lisbet Larsd.
2 CONT Born:
2 CONT * a. Ola, f. 1717, Tårland, Nærbø.
2 CONT * b. Gabriel, f. 1721, Skeie, nr. 7.
2 CONT * c. Lars, f. 1720, n. Øksnevad, nr. 9.
2 CONT Mons fekk bøgsel på 24 sp. 17/12 1711 då han gifta seg med enkja.
2 CONT Han er førd som brukar 1712-1728, flytta seinare heim til farsgarden, n. Øksnevad nr. 8.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Skeie, side 249, nr. 7'''
2 CONT Gabriel Monson, son åt Mons Olson, n. Øksnevad nr. 8, f. 1719, d. 1774,
2 CONT G. m. Berta Jonsd. nr. 6, f. 1723, d. 1/6 1794.
2 CONT Born:
2 CONT * a. Jon, f. 1758, nr. 8.
2 CONT * b. Mons, f. 1760, Tananger, Håland.
2 CONT * c. Ola, f. 1764, Kolnes, Håland, g. m. Malena Sveinsd., Kolnes.
2 CONT Dei fekk heimel ved gavebrev frå Jon Tollakson til dottera Berta 4/2 1752 på 1 pd., halve Skeie, førd til 1777.
2 CONT Gabriel fekk bestalling son lensmann i Haugland 1755.
2 CONT
2 CONT
2 CONT ----
2 CONT
2 CONT Lensmann i Hougland.
