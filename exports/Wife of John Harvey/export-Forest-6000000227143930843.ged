2 CONC gR&sig=iRGYB4q_drpLfwaN27I94QJQnSY&hl=en&sa=X&ved=2ahUKEwjt8qGglYXeAhXF5p8KHc29CdUQ6AEwBHoECAEQAQ#v=onepage&q=Captain%20William%20Shelton%20%26%20Katherine%20Nutting&f=false
