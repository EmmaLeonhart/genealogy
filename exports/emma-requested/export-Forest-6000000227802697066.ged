2 CONT
2 CONT mother: Schanche, Karen Knudsdtr. (1482 - b1578) 
2 CONT
2 CONT spouse: Fridag, Axel Fredriksen (*1546 - ~1585) 
2 CONT
2 CONT spouse: Hård, Jon Nilsson (~1550 - ) 
2 CONT
2 CONT ----------child: Hård, Anna Jonsdtr. (~1510 - 1569) 
2 CONT
2 CONT ----------child: Hård, Jon Jonson (*1591 - ) 
2 CONT
2 CONT spouse: Hovland, Anders Mowat til (1530 - 1606) 
2 CONT
2 CONT - m. 1586 
2 CONT
2 CONT ----------child: Mowat, Kristoffer (*1569 - 1628) 
2 CONT
2 CONT ----------child: Mowat, Karen Andersdtr. (1592 - 1679) 
