2 CONT --------------------------------------------------------------------------------
2 CONT
2 CONT  Kyrkoherde Paulus Erici Wirestadius,
2 CONT
2 CONT född 158? i Fagerhult gård?, Markaryd (G), död 1634 i Ulvsbäck prästgård, Markaryd (G). Kyrkoherde <1602 i Virestad i Ulvsbäck <1612, Markaryd (G). 
2 CONT
2 CONT Värd vid freden i Knäred samt vid Kungamötet 1629.
2 CONT
2 CONT Gift med 
2 CONT
2 CONT Anna Pedersdotter, född 158? i Ulvsbäck prästgård, Markaryd (G). Bosatt i Ulvsbäck, Markaryd (G). 
2 CONT
2 CONT Barn:
2 CONT
2 CONT Magnus (Måns) Paulin Hilletan, född 1601ca, död 1646 (50)
2 CONT
2 CONT Gunilla Påvelsdotter Paulina, född 1603?, död 1650-06-30
2 CONT
2 CONT Petrus Peder Paulinus d ä Paulin, född 1606 ca, död 1669>02-21
2 CONT
2 CONT Kyrkoherde Erlandus Paulinus Paulin, född 1606 ca, död 1663
2 CONT
2 CONT Gift med 
2 CONT
2 CONT Ester Eriksdotter, född 159?. Bosatt i Ulvsbäck, Markaryd (G). 
2 CONT
2 CONT Barn:
2 CONT
2 CONT Paulus Paulinus Ulfsbeckius, född 161?, död 164?
2 CONT
2 CONT Petrus Paulinus Ulfsbeckius, född 162?
2 CONT
2 CONT Erik Paulin Ulfsbeckius, född 162?, död 1679
2 CONT
