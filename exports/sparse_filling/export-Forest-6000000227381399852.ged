2 CONT
2 CONT Husband of Joyce (Cherleton) Tiptoft — married 28 Feb 1422 [location unknown]
2 CONT
2 CONT
2 CONT
2 CONT DESCENDANTS 
2 CONT
2 CONT Father of Philippa (Tiptoft) Grimston, Joan (Tiptoft) Grey, John Tiptoft KG and Joyce (Tiptoft) Sutton
2 CONT
2 CONT Died about 31 Jan 1443 at about age 60 in Enfield, Edmonton, Middlesex, England
