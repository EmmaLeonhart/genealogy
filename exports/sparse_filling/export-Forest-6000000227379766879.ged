2 CONT
2 CONT BEARSE CHILDREN
2 CONT _________________________________________
2 CONT
2 CONT Mary Hallett (Bearse) 1640-1694
2 CONT
2 CONT Priscilla Hall (Bearse) 1643-1712
2 CONT
2 CONT Martha Bearse 1642-1643
2 CONT
2 CONT Sarah Hamblin (Bearse) 1646-1712
2 CONT
2 CONT Abigail Nichols (twin-Bearse) 1647-1670
2 CONT
2 CONT Hannah Bearse 1649-1719
2 CONT
2 CONT Joseph Bearse 1651-1728
2 CONT
2 CONT Hester Bearse 1653-1723
