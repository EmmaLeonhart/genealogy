2 CONT
2 CONT Jan Lensen
2 CONT
2 CONT Jan Luykens
2 CONT
2 CONT Hugh Masland and wife, servant to Claypoole
2 CONT
2 CONT Abraham Op Den Graeff
2 CONT
2 CONT Derick Op Den Graeff
2 CONT
2 CONT Hermann Op Den Graeff
2 CONT
