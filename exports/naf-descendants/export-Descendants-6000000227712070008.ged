2 CONT
2 CONT       7 spand korn i Hetland, Bjerkreim,
2 CONT     *
2 CONT
2 CONT       1 spand korn i Mysse,
2 CONT     *
2 CONT
2 CONT       2 pund (hele) i Kolestrand, Heskestad,
2 CONT     *
2 CONT
2 CONT       2 løp i Østbø,
2 CONT     *
2 CONT
2 CONT       2 løp i Midtbø,
2 CONT     *
2 CONT
2 CONT       ½ løp smør i Solbjør, Lund,
2 CONT     *
2 CONT
2 CONT       ½ pund i Egeli,
2 CONT     *
2 CONT
2 CONT       1 pund 3 mark i Saurdal,
2 CONT     *
2 CONT
2 CONT       2 pund i Moi
2 CONT     *
2 CONT
2 CONT       1 hud 4 mark i Arnstad i Lund 
2 CONT
2 CONT I 1639 hadde han følgende :
2 CONT
2 CONT     *
2 CONT
2 CONT       1 ½ løb 1 pund smør i I. Mydland,
2 CONT     *
2 CONT
2 CONT       ½ løb 1 pund i Mysse,
2 CONT     *
2 CONT
2 CONT       7 spand korn i Hetland, Bjerkreim,
2 CONT     *
