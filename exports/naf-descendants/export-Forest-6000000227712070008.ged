1 NOTE {geni:about_me} http://finnholbek.dk/genealogy/getperson.php?personID=I69071&tree=2
2 CONT
2 CONT Gift före 1508 
2 CONT
2 CONT Ingeborg Larsdotter. 
2 CONT
2 CONT Arvskifte 1537-05-23. 
2 CONT
2 CONT Hon gav år 1523 till Helge Ands kloster i Söderköping åtskilliga gårdar för sig, sin man samt sina avlidna barn, Tisdom och Anna. 
2 CONT
2 CONT Tisdom Nilsson (Banér). 
2 CONT
2 CONT Död ung. 
2 CONT
2 CONT Karin Nilsdotter (Banér). 
2 CONT
2 CONT Död ogift. 
2 CONT
2 CONT Axel Nilsson (Banér). 
2 CONT
2 CONT Riksråd. 
2 CONT
2 CONT Död 1554. 
2 CONT
