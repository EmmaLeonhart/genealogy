2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nese, side 171, nr. 64'''
2 CONT Oluf Olson, son åt nr. 63, f. 20/9 1879, d. 1/1 1940,
2 CONT G. 16/12 1905 m. Elisabet Jonsd. nr. 16, f. 7/1 1887, d. 2/10 1956.
2 CONT Born:
2 CONT * a. Ola, f. 3/3 1906, bonde på farsgarden.
2 CONT * b. Johannes, f. 20/8 1907, d. 4/6 1932.
2 CONT * c. Jonas, f. 15/11 1909, bonde på Friestad.
2 CONT * d. Einar Johan, f. 2/2 1912, bonde på Friestad.
2 CONT * e. Ragnvald, f. 5/6 1914, bonde på farsgarden.
2 CONT * f. Johanna, f. 16/4 1917, g. m. Jon Salomonson, Hodne.
2 CONT * g. Maria, f. 17/5 1920, g. m. Jostein R. Salte.
2 CONT * h. Astrid, f. 8/5 1923, g. m. Olaf Olson Salte.
2 CONT Oluf fekk skøyte på farsgarden 21/1 1899, førd 1900 og 1906. Skyld 4,42.
2 CONT
2 CONT ----
2 CONT
2 CONT * '''Census''': 1910 - Nese, Klepp, Rogaland, Norway
