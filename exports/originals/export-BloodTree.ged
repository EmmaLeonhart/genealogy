1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 176, nr. 45.a
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 178, nr. 60
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 176, nr. 45'''
2 CONT Ola Kristofferson, son åt Kristoffer Olson, Grude nr. 40, f. 1829,
2 CONT G. 9/7 1857 m. Sara Gabrielsd., Pollestad nr. 13a, f. 2/2 1833, d. 29/4 1881.
2 CONT Born:
2 CONT * a. Kristoffer, f. 29/11 1857, nr. 60.
2 CONT * b. Gabriel, f. 11/1 1859, Stavanger.
2 CONT * c. Martin, f. 9/3 1860, Reve nr. 28.
2 CONT * d. Karl, f. 27/10 1861, nr. 46.
2 CONT * e. Marta Kirstine, f. 10/4 1863, g. m. Karl Olson, Lura 61A, Høyland.
2 CONT * f. Ole Severin, f. 26/9 1867, USA.
2 CONT G. II. 23/9 1883 m. Anna Johanna Assersd., Risa, Håland, f. 13/2 1856, d. 18/9 1899.
2 CONT Born:
2 CONT * g. Anna Elisabet, f. 16/4 1885, g. m. Hans Løge, telegrafist, Sandnes.
2 CONT * h. Ole Severin, f. 1/2 1888, USA.
2 CONT * i. Johanna, f. 3/4 1895, Stavanger.
2 CONT Ola fekk skøyte på 48 øre fråskilt br. nr. 3, 1/7 1868, førd til 1902.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 178, nr. 60'''
2 CONT Kristoffer Olson, son åt nr. 45, f. 29/11 1857, d. 4/4 1939,
2 CONT G. 20/3 1883 m. Jørgine Bergitte Paulsd., Borsok nr. 30c, f. 16/3 1854, d. 6/1 1945.
2 CONT Born:
2 CONT * a. Sara, f. 24/12 1883, g. m. Abraham Andreasson, Erga nr. 47.
2 CONT * b. Ommund, f. 28/4 1886, USA.
2 CONT * c. Berta Serina, f. 28/4 1889, g. m. Peder Petterson, y. Salte nr. 14a.
2 CONT * d. Paul, f. 23/2 1891, bonde på Grødeland.
2 CONT * e. Karl Johan, f. 21/8 1895, bonde på farsgarden.
2 CONT * f. Sina, f. 2/6 1900, g. m. Torlund Toreson, Lunde 56k, Høyland.
2 CONT Kristoffer fekk skøyte på 24 øre frå br. nr. 5 og 1,26 mark frå br. nr. 6 6/12 1890, førd 1900 og 1906, skyld 1,40.
