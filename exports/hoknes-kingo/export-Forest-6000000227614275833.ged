2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Erga, side 81, nr. 17'''
2 CONT Velas Velasson, son åt Velas Toreson Re, Time, f. 10/10 1813, d. 23/8 1894,
2 CONT G. I. 13/4 1845 m. Ingeborg Malena Torgersd., Erga nr. 59a, f. 25/10 1818, d. 10/5 1864.
2 CONT Born:
2 CONT * a. Torger, f. 25/3 1847, Stavanger, køyrar. G. m. Berta Oline Olsd. Skjæveland 96, Høyland.
2 CONT * b. Marta, f. 27/1 1849, g. m. Ola Knutson Holen, Time. Ho døydde på s. Salte, 26/6 1876.
2 CONT * c. Laurits, f. 9/1 1851, nr. 18.
2 CONT * d. Henrik, f. 11/1 1854, Stavanger. Skomakarmeistar.
2 CONT * e. Ingeborg Malena, f. 14/8 1856, g. m. Ola Eilefson Orre, nr. 43, g. 2. m. Ola Jonasson Orre, nr. 44.
2 CONT * f. Vilhelm, f. 20/10 1859, Stavanger, køyrar.
2 CONT G. II. 23/8 1865 m. Olina Knutsd., Hatteland nr. 23c, f. 2/9 1809, d. 7/7 1874.
2 CONT Velas fekk feste på eit stykke mark 5/11 1844.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Erga, side 81, nr. 18'''
2 CONT Laurits Velasson, son åt nr. 17, f. 9/1 1851, d. 4/7 1939,
2 CONT G. 5/4 1881 m. Berta Maria Paulsd., Borsok nr. 30b, f. 29/3 1851, d. 25/5 1936.
2 CONT Born:
2 CONT * a. Valdemar, f. 26/7 1883, d. 19/5 1910.
2 CONT * b. Petter Berner, f. 1/5 1885, USA.
2 CONT * c. Antin, f. 22/8 1886, bonde på Orre.
2 CONT * d. Bertel, f. 11/4 1890, d. 24/6 1909.
2 CONT * e. Inga, f. 7/11 1891, g. m. Johannes Jonasson, s. Salte 52e.
2 CONT * f. Bekka, f. 8/3 1894, g. m. Tollef Jensson Re, Bryne, bakar.
2 CONT * g. Leonard, f. 24/4 1897, bonde på farsgarden.
2 CONT Laurits var først husmann, men fekk skøyte på bruket, 46 øre frå br. nr. 1, 4/10 1880, førd 1906.
2 CONT
2 CONT ----
2 CONT folketelling 1865; tjenestekarl hos John Sivertsen Vik folketelling 1875; sjømann,matros, i Ostindia
