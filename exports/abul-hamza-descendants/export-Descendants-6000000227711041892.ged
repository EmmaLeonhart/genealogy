2 CONT
2 CONT -3. Maximilian Graf von Sternberg b. 1766, d. 1779
2 CONT
2 CONT -4. Leopold Graf von Sternberg b. 1767, d. 1768
2 CONT
2 CONT -5. Auguste Gräfin von Sternberg b. 1768
2 CONT
2 CONT -6. Maria Walburga Gräfin von Sternberg-Manderscheid+ b. 11 May 1770, d. 16 Jun 1806
2 CONT
2 CONT -7. Philipp Graf von Sternberg b. bt 1772 - 1773, d. 1778
2 CONT
2 CONT -8. Christine Gräfin von Sternberg b. 1773, d. 1773
2 CONT
