2 CONT
2 CONT Rinaldo d'Este
2 CONT
2 CONT Duca di Modena e Reggio
2 CONT
2 CONT Regno 		1695 - 1737
2 CONT
2 CONT Predecessore 		Francesco II d'Este
2 CONT
2 CONT Successore 		Francesco III d'Este
2 CONT
2 CONT Nascita 		Modena, 25 aprile 1655
2 CONT
2 CONT Morte 		Modena, 26 ottobre 1737
2 CONT
