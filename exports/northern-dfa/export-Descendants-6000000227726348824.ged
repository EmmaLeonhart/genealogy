2 CONT * .... etc.
2 CONT *i. George Buchanan of that ilk, 15th of Buchanan (d 1561)
2 CONT *  m1. Margaret Edmonstone (dau of Sir Archibald Edmonstone, 3rd of Duntreath)
2 CONT **a. John Buchanan, younger of Buchanan (dvp)
2 CONT **   m1. (03.02.1543-4) Elizabeth Livingston (dau of Alexander Livingston, 5th Lord of Callendar)
2 CONT ***(1) John Buchanan of that ilk, 16th of Buchanan (d by 03.1599)
2 CONT ***  m. (01.1560-1) Mary Graham (dau of John Graham, 4th Earl of Menteith)
2 CONT ****(A) John Buchanan of that ilk, 17th of Buchanan (a 1629)
2 CONT ****  m. Annabel Erskine (dau of Adam Erskine, Commendator of Cambuskenneth)
2 CONT *****'''(i) George Buchanan of that ilk, 18th of Buchanan (d before 1653)
2 CONT *****'''  m. Elizabeth Preston (dau of Sir George Preston of Craigmillar)
2 CONT ****** .... etc.
2 CONT *****(ii) Walter Buchanan
2 CONT ****(B) Helen Buchanan
2 CONT ****  m. (mcrt 18.08.1595) Alexander Colquhoun of Luss (d 23.05.1617)
2 CONT ****(C) Susanna Buchanan (dsp)
2 CONT ****  m. John Macfarlane of that ilk of Arrochar (d 1624)
2 CONT **   m2. Helen Chisholme
2 CONT ***(2)  Janet Buchanan
2 CONT ***  m. Thomas Buchanan, 2nd of Ibert (d before 20.02.1582-3)
2 CONT ***(3)  Elizabeth Buchanan
2 CONT *  m2. Janet Cunynghame
2 CONT **b. William Buchanan, 1st of Auchmar (d before 20.11.1588)
2 CONT **  m. (mcrt 20.02.1559-60) Elizabeth Hamilton (dau of Robert Hamilton of Eglismachan)
2 CONT *** .... etc.
2 CONT **c. Margaret Buchanan
2 CONT **  (?)m1. _ Cuninghame of Robertland
2 CONT **  m1/2. (before 06.08.1544) George Stirling of Glorat (d Pinkie 10.09.1547)
2 CONT **  m2/3. Matthew Douglas, 7th of Mains (a 1549)
2 CONT * .... etc.
2 CONT *Main source(s):
