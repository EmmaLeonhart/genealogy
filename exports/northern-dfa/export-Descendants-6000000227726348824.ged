1 NOTE {geni:about_me} Spouse:
2 CONT 	Marjory Ross,   b. Est 1615, Sutherland, Scotland,   d. Abt 1648, Scotland  (Age 33 years) 
2 CONT
2 CONT Children:
2 CONT 	1. John Munro,   b. 1637, Evanton, , Ross and Cromarty, Scotland,   d. 10 Oct 1691, Bristol, Bristol Co., Rhode Island, Colonial America  (Age 54 years)
2 CONT 	2. Hugh Munro,   b. 1639, Evanton, , Ross and Cromarty, Scotland,   d. Aft 1665  (Age 27 years)
2 CONT  	3. David Munro,   b. 1641, Evanton, , Ross and Cromarty, Scotland,   d. Yes, date unknown
2 CONT
2 CONT Father:
2 CONT 	William Munro, of Mid-Swordale,   b. Abt 1556, Evanton, , Ross and Cromarty, Scotland,   d. 1616  (Age 60 years) 
2 CONT Mother:	Euphemia Ross, of Achnacloich,   b. Abt 1565, Rosskeen, , Ross and Cromarty, Scotland
2 CONT
