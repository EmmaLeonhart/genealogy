2 CONT
2 CONT Robert Glanfield (abt. 1643 - 1702)
2 CONT Born about 1643 [uncertain] in Maine 
2 CONT Died 1702 at about age 59 in Salem, Massachusetts 
2 CONT
2 CONT Family Tree of Robert Glanfield
2 CONT
2 CONT ROBERT
2 CONT
2 CONT Captain Robert Glanfield
2 CONT
2 CONT Son of Peter Glanfield and Margaret (Palmer) Glanfield
2 CONT
2 CONT Brother of Ruth Glanfield, Peter Glanfield and Abigail Glanfield
2 CONT
2 CONT Husband of Lydia Ward — married 12 Jul 1665 in Salem, Massachusetts map icon
2 CONT
2 CONT Father of Lydia (Glanfield) Carkeet, Abigail Glanfield, Peter Glanfield, Robert Glanfield and Sarah Glanfield
2 CONT
2 CONT PARENTS
2 CONT
