1 NOTE {geni:about_me} Fra http://www.slektsdata.com/Bygdeboeker/Jelsa/Nadland/JBrukNa.htm
2 CONT
2 CONT Kjøper Nådland gård i 1886:
2 CONT
2 CONT f. 1861 i Sandvik, Erfjord, var gift med Rasmine Larsdtr. Jårvik f. 1866. Dei set med bruket i 1900 og har då barna:
2 CONT
2 CONT a.Bjørn Bjørnson f. 1886.
2 CONT
2 CONT b.Lars Bjørnson f. 1887.
2 CONT
2 CONT c.Johanna Bjørnsdtr. f. 1889.
2 CONT
2 CONT d.Rasmus Bjørnson f. 1892, seinare bonde i Hagen, g. m. Ingeborg Byrkja i Årdal.
2 CONT
2 CONT e.Bernhard Bjørnson f. 1894, grosserer i Stavanger.
2 CONT
2 CONT f.Marie Bjørnsdtr. f. 1897.
2 CONT
2 CONT g.Ola Bjørnson f. 1898, bonde Kaltveit.
2 CONT
2 CONT h.Severin Bjørnson f. 1900, var lenge handelsstyrar i Vikedal.
2 CONT
2 CONT Etter 1900: i. Henning, j. Karen, k. Hanna, 1. Birgit.
