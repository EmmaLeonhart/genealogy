1 NOTE {geni:about_me} # Navn	Arne O. Ueland
2 CONT # Født dato	3011 1878
2 CONT # Død dato	0512 1960
2 CONT # Begravet dato	0912 1960
2 CONT # Felt	M
2 CONT # Rad	03
2 CONT # Gravnr	024
