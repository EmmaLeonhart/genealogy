1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 47, nr. 36.b
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 49, nr. 64
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 47, nr. 36'''
2 CONT Daniel Schive Danielson, son åt nr. 33, f. 14/3 1834, d. 13/5 1901,
2 CONT G. 10/7 1862 m. Elen Serine Pedersd., Kolnes, Håland, f. 13/8 1843, d. 20/11 1926.
2 CONT * a. Maren Dortea, f. 3/5 1863, ug., d. 29/10 1940.
2 CONT * b. Peder Gabriel, f. 26/1 1865, nr. 64.
2 CONT * c. Daniel Schive, f. 28/12 1867, Friestad, nr. 75.
2 CONT * d. Garman Enevald, f. 19/9 1870, kjøpmann, Vikedal.
2 CONT * e. Tønnes, f. 22/2 1874, bonde på farsgarden, d. 4/12 1914.
2 CONT * f. Laurits, f. 27/4 1876, bakar på Stord, g. m. Berta Kirstine Larsd., Skår, Høyland. Han døde 20/9 1937.
2 CONT * g. David, f. 14/4 1879, bonde på Sveinsvoll, seinare Sele.
2 CONT * h. Enevald, f. 16/5 1881, ug., bonde på farsgarden.
2 CONT * i. Severin, f. 17/6 1885, Møllar, Stangeland, Høyland.
2 CONT Daniel fekk skøyte på ein part av farsgarden 26/10 1860, skyld 5,94, seinare vart bruket skifta i 2 like store bruk, 2,97 mark kvar.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 49, nr. 64'''
2 CONT Peder Gabriel Danielson, son åt nr. 36, f. 26/1 1865, d. 25/6 1947,
2 CONT G. 27/8 1897 m. Teoline Samuelsd., Raustad 17B, Høyland, f. 25/3 1875, d. 12/2 1956.
2 CONT Born:
2 CONT * a. Sverre Donkart Emil, f. 3/3 1898. Telefonmontør.
2 CONT * b. Dagfinn Enevald, f. 16/2 1900, bonde på farsgarden.
2 CONT * c. Magnus, f. 17/3 1905, småbrukar på Kleppe.
2 CONT * d. Tella Pauline, f. 2/8 1909, g. m. Ragnvald Sigfredson, Tårland.
2 CONT * e. Sigfrida Elisa, f. 21/4 1912, ug.
2 CONT * f. Dagny, f. 7/12 1916, g. m. Arne Birgerson Kvia, Ganddalen.
2 CONT * g. Peder Georg, f. 7/12 1916, bonde på farsgarden.
2 CONT Peder fekk skøyte på 2,97 mark av farsgarden 10/8 1901, førd 1906.
