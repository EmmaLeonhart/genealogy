2 CONT    Henry I
2 CONT
2 CONT    Robert I, Duke of Burgundy
2 CONT
2 CONT Henry I
2 CONT
2 CONT    Philip I
2 CONT
2 CONT    Hugh, Count of Vermandois
2 CONT
2 CONT Philip I
2 CONT
2 CONT    Louis VI
2 CONT
2 CONT Louis VI
2 CONT
2 CONT    Louis VII
2 CONT
2 CONT    Robert I of Dreux
2 CONT
2 CONT Louis VII
2 CONT
2 CONT    Marie, Countess of Champagne
2 CONT
2 CONT    Alix, Countess of Blois
2 CONT
2 CONT    Marguerite, Queen of Hungary
2 CONT
2 CONT    Alys, Countess of the Vexin
2 CONT
2 CONT    Philip II
2 CONT
2 CONT    Agnes, Empress of Constantinople
2 CONT
2 CONT Philip II
2 CONT
2 CONT    Louis VIII
2 CONT
2 CONT Louis VIII
2 CONT
2 CONT    Louis IX
2 CONT
2 CONT    Robert I, Count of Artois
2 CONT
2 CONT    Alphonse, Count of Poitou and Toulouse
2 CONT
2 CONT    Saint Isabel of France
2 CONT
2 CONT    Charles I of Anjou and Sicily
2 CONT
2 CONT Louis IX
2 CONT
2 CONT    Philip III
2 CONT
2 CONT    Robert, Count of Clermont
2 CONT
2 CONT   Agnes, Duchess of Burgundy
2 CONT
2 CONT Philip III
2 CONT
2 CONT    Philip IV
2 CONT
2 CONT    Charles III, Count of Valois
2 CONT
2 CONT    Louis d'Evreux
2 CONT
2 CONT    Margaret, Queen of England
2 CONT
2 CONT Philip IV
2 CONT
2 CONT    Louis X
2 CONT
2 CONT    Philip V
2 CONT
2 CONT    Isabella, Queen of England
