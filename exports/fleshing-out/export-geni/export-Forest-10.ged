2 CONT https://books.google.com/books?id=Wuf-AgAAQBAJ&pg=PA232&lpg=PA232&dq=%D0%A7%D1%83%D0%B1%D0%B5%D0%B9+%D0%A5%D0%B0%D0%BD&source=bl&ots=ICsiNYnpwi&sig=W4cs4eWIFZHzYUGELktssvCrfJ4&hl=en&sa=X&ved=0ahUKEwi5psKOyarMAhUCFT4KHQH6DzkQ6AEIOj
