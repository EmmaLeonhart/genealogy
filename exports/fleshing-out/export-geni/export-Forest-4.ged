2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Storhaug, side 263, nr. 11'''
2 CONT Lars Larsson, son åt nr. 8, f. 31/3 1840, d. 6/9 1912,
2 CONT G. I. 1/11 1866 m. Stine Larsd., Håland nr. 15c, f. 7/1 1846, d. 22/8 1889.
2 CONT Born:
2 CONT * a. Karen Sofie, f. 28/9 1867, g. m. Petter Petterson Netland, Time.
2 CONT * b. Laurits, f. 26/12 1870, Meland nr. 29.
2 CONT * c. Fredrikke Severine, f. 28/2 1872, g. m. Karl Ivarson, Hauge nr. 43.
2 CONT * d. Lars Johan, f. 17/6 1874, nr. 10.
2 CONT * e. Sina, f. 18/3 1878, g. m. Johannes Abrahamson, Tjøtta 83g.
2 CONT * f. Elen Marie Gabrielle, f. 13/12 1880, g. m. Abraham Kristianson Tjensvoll, Tu 21b.
2 CONT * g. Samuel, f. 2/9 1883, USA, d. 6/4 1934.
2 CONT * h. Lisa, f. 2/5 1887, g. m. Sigvald Olson Skjold, Stavanger.
2 CONT G. II. 9/4 1903 m. Karen Margrete Larsd., Folkvor 68, Høyland, f. 9/9 1857, d. 18/4 1906. Ingi born.
2 CONT Lars fekk skøyte på halve farsgarden 9/12 1868, førd 1900 og 1906, skyld 3,32 mark.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Storhaug, side 262, nr. 10'''
2 CONT Lars Johan Larsson, son åt nr. 11, f. 17/6 1874, d. 31/12 1934,
2 CONT G. 29/10 1898 m. Josefine Bergitte Johannesd., Knudsen, sjå ø. Øksnevad nr. 22g, Stavanger, f. 8/12 1880, d. 12/12 1945.
2 CONT Born:
2 CONT * a. Sara, f. 5/1 1899, g. m. Nils Skjerping, heradsagronom, Klepp.
2 CONT * b. Louis, f. 15/9 1900, bonde på farsgarden.
2 CONT * c. Berta, f. 15/7 1902, g. m. Magnus Haraldson Grude, Kleppe.
2 CONT * d. Tilla Teodora, f. 23/8 1904, g. m. Øyvind Tuntland, Hjelmeland.
2 CONT * e. Johanna, f. 7/12 1906, g. m. Magnus Tønnesson Skretting.
2 CONT * f. Sigvald Arnold, f. 7/1 1909, bonde på ein part av farsgarden.
2 CONT * g. Levin Johan, f. 16/5 1912, bonde på Friestad.
2 CONT * h. Jens, f. 19/9 1914, sjåfør, Kyllingstad plog, Kleppe.
2 CONT * i. Bernt, f. 12/10 1916, lausarbeidar, Odda.
2 CONT * j. Odd, f. 13/1 1919, Håland, pelsdyrfarm.
2 CONT * k. Bergit, f. 28/4 1921, g. m. Taksdal, paktar, Austlandet.
2 CONT * l. Lylly, f. 27/1 1923, Stavanger, handelsmann.
2 CONT Lars er førd som brukar 1906, skøyte 4/1 1911.
