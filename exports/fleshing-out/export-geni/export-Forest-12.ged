2 CONT Buried 	Møborg Kirke  
2 CONT
2 CONT Father 	Malte Jensen Sehested,   b. 1529,   d. 1592 
2 CONT
2 CONT Mother 	Sophie Clausdatter Bille,   b. 21 Nov 1529, Baahus ,   d. 12 Apr 1587, Holmgaard Gods   
2 CONT
2 CONT Married 	1550 	Malmø  
2 CONT
2 CONT Family 	Anne Nielsdatter Lykke,   b. 02 Nov 1568, København / Copenhagen Denmark ,   d. 20 Mar 1645, Mullerup Gods  
2 CONT
2 CONT Married 	1593 	Viborg  
2 CONT
2 CONT Children 	
2 CONT
