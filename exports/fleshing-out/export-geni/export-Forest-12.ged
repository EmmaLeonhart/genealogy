1 NOTE {geni:about_me} http://www.kulturarv.dk/1001fortaellinger/da_DK/saeby-kirke-og-voldsted
2 CONT
2 CONT http://www.denstoredanske.dk/Danmarks_geografi_og_historie/Danmarks_historie/Danmark_f%C3%B8r_Reformationen/Esbern_Snare
2 CONT
2 CONT http://www.visitvestsjaelland.dk/vestsjaelland/korsfareren-esbern-snare
2 CONT
2 CONT http://finnholbek.dk/genealogy/getperson.php?personID=I10498&tree=2
