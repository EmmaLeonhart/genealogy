1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øvre Øksnevad, side 331, nr. 33.c
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Laland, side 161, nr. 31
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øvre Øksnevad, side 331, nr. 33'''
2 CONT Reier Rasmusson, son åt nr. 32, f. 25/7 1823, d. 13/2 1892,
2 CONT G. 31/3 1853 m. Elen Kirstine Ådnesd., Anda nr. 101b, f. 1/12 1831, d. 3/11 1924.
2 CONT Born:
2 CONT * a. Rasmus, f. 1/1 1854, Stavanger, handelsmann, d. 30/8 1878.
2 CONT * b. Maria Regina, f. 18/3 1856, g. m. nr. 34.
2 CONT * c. Ingeborg Kirstine, f. 16/2 1860, g. m. Jon Jonson, Laland nr. 31.
2 CONT * d. Arnt, f. 15/2 1863, Skjæveland nr. 123, Høyland.
2 CONT * e. Rikke Elisa, f. 3/9 1868, g. m. Andreas Jonson Lea 58, Høyland.
2 CONT * f. Martine, f. 1/7 1871, g. m. Ole Johannes Jensson, Laland 23.
2 CONT * g. Reier, f. 11/1 1875, USA.
2 CONT Reier fekk skøyte på halve farsgarden 12/7 1849, førd til 1894. Etter frådrag for 4 sp. til br. nr. 2, vart det 13 sp. på kvar av brødrene.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Laland, side 161, nr. 31'''
2 CONT Jon Jonson, son åt nr. 30, f. 19/7 1852, d. 26/12 1916,
2 CONT G. 7/7 1881 m. Ingeborg Kirstine Reiersd., ø. Øksnevad nr. 33c, f. 16/2 1860, d. 15/11 1913.
2 CONT Born:
2 CONT * a. Inga Gurina, f. 13/11 1882, g. m. Ivar Olson Kydland, Varhaug.
2 CONT * b. Jon, f. 2/12 1884, bonde på farsgarden.
2 CONT * c. Reidar, f. 25/11 1886, bonde på v. Bore, seinare timremann.
2 CONT * d. Jens, f. 13/12 1888, Bryne.
2 CONT * e. Klara, f. 4/10 1890, d. 9/5 1906.
2 CONT * f. Johan, f. 29/11 1892, USA.
2 CONT * g. Ingrid, f. 22/12 1895, g. m. Martin Kydland, Varhaug.
2 CONT * h. Ragna, f. 25/10 1897, g. m. Mikal Gabrielson Edland, Orstad.
2 CONT * i. Karl, f. 15/7 1901, USA.
2 CONT Jon fekk skøyte på farsgarden 15/5 1853.
2 CONT Farbroren dreiv bruket til 1876, då vart bruket delt mellom deim, og Jon sin part vart 3,78, førd 1900 og 1906, skyld 3,76.
