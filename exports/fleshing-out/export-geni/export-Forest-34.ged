1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vashus, side 309, nr. 29.d
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vashus, side 309, nr. 30
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vashus, side 309, nr. 29'''
2 CONT Halvard Reierson, son åt nr. 28, f. 1783, d. 31/10 1875,
2 CONT G. I. 16/3 1815 m. Elisabet Kirstine Gulliksd., Heigre 27, Høyland, f. 20/3 1785, d. 20/7 1824.
2 CONT * a. Kirstine, f. 15/3 1818.
2 CONT * b. Marta Maria, f. 24/8 1820.
2 CONT G. II. 13/4 1825 m. Anna Nilsd., Byberg, Håland, f. 26/12 1791, d. 28/7 1860.
2 CONT * c. Johanna, f. 6/11 1825, g. m. Johan Sveinson Eikeland, Time.
2 CONT * d. Nils, nr. 30.
2 CONT * e. Elisabet Kirstine, g. m. nr. 31.
2 CONT * f. Gabriel, f. 10/2 1831, nr. 32.
2 CONT Halvor fekk bøgsel på 36 sp. 9/7 1810, skøyte på 1 1/2 sp. i Njole 7/7 1812 og kongeskøyte på 36 sp. 12/11 1851, førd til 1860.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vashus, side 309, nr. 30'''
2 CONT Nils Halvorson, son åt nr. 29, f. 13/8 1827, d. 4/5 1878,
2 CONT G. 1868 m. Serina Hansd., Stangeland nr. 52a, f. 9/3 1847, d. 12/1 1922, g. II. m. nr. 31.
2 CONT Born:
2 CONT * a. Anna Kirstine, f. 29/1 1868, USA.
2 CONT * b. Alette, f. 9/10 1871, g. m. Olaus Johannesson Dysjeland, Håland.
2 CONT * c. Halvard, f. 16/2 1877, ug., bonde på farsgarden.
2 CONT Nils fekk skøyte på halve farsgarden 30/6 1862, skyld 3,66, førd til 1882.
2 CONT
2 CONT ----
2 CONT Nils fikk skjøte på halve farsgarden i 1862, ført til 1882.
