1 NOTE {geni:about_me} * [http://www.disnorge.no/gravminner/bilde.php?id=2527541   Gravminner i Norge]
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orstad, side 188, nr. 99.b
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orstad, side 188, nr. 99'''
2 CONT Gabriel Mikalson Edland, son åt Mikal Gabrielson, Skjæveland 112, Høyland, f. 13/9 1871, d. 9/12 1943,
2 CONT G. m. Jorina Olsd., Foss-Eikeland, 91, Høyland, sjå nr. 91f, f. 13/10 1877, d. 2/4 1950.
2 CONT Born:
2 CONT * a. Astrid, f. 27/4 1899, g. m. Laurits Larsson Engelsvoll.
2 CONT * b. Mikal, f. 2/6 1900, bonde på Orstad.
2 CONT * c. Ole, f. 25/12 1901, industriarbeidar, Ålgård.
2 CONT * d. Gabriel, f. 17/2 1904, USA.
2 CONT * e. Jonas, f. 18/5 1905, Skjæveland, Høyland.
2 CONT * f. Jon, f. 18/8 1906, bonde på Orstad.
2 CONT * g. Gunda Malena, f. 29/7 1907, g. m. Sven Olausson Skjæveland, Bryne.
2 CONT * h. Ingrid, f. 18/7 1909, g. m. Konrad Samuelson Risa, Håland.
2 CONT * i. Sigrid, f. 18/7 1909, g. m. Lars Samuelson Risa, Håland, g. 2. m. Rasmus Rasmusson Madsgård.
2 CONT * j. Martin Emil, f. 8/9 1913, industriarbeidar, Orstad.
2 CONT * k. Toralf Magnus, f. 15/11 1911, bonde på Riskjell.
2 CONT * l. Trygve, f. 9/9 1914, Lier.
2 CONT * m. Marit Ingebjørg, f. 14/9 1915, g. m. Knut R. Sviland.
2 CONT * n. Torvald Godtfred, f. 21/8 1916, snikkar, Bryne.
2 CONT * o. Torleiv Olav, f. 17/9 1917, bonde på farsgarden.
2 CONT * p. Sverre, f. 15/11 1918, Lier.
2 CONT * q. Anna, f. 8/2 1920, g. m. Asbjørn Asbjørnson Pollestad.
2 CONT * r. Arvid Dagfinn, f. 11/1 1922, bonde på farsgarden.
2 CONT Gabriel fekk skøyte på bruket 24/3 1900, førd 1900 og 1906, skyld 1,99.
