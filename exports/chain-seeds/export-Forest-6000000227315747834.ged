1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 210, nr. 78
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 210, nr. 79
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 210, nr. 80
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 210, nr. 78'''
2 CONT Tollak Kristofferson, son åt Kristoffer Tollakson Grødeim, Time, f. 19/3 1786, d. 30/5 1841,
2 CONT G. 26/3 1829 m. Anna Jakobsd., Norheim, Time, f. 1/3 1806, d. 27/4 1882, g. 2. m. nr. 79.
2 CONT Born:
2 CONT * a. Marta, f. 28/7 1829.
2 CONT * b. Ingeborg, f. 30/8 1831, g. m. Ole Tobias Olson, Engelsvåg 43.
2 CONT * c. Kristoffer, f. 7/12 1835, Erga nr. 73.
2 CONT * d. Marta Maria, f. 22/10 1841, g. m. Jens Olson Dysjaland, Håland.
2 CONT Tollak kom frå Serikstad, Time, 1831.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 210, nr. 79'''
2 CONT Ola Olson, son åt Ola Larsson, Engelsvåg nr. 40, f. 3/11 1817, d. 30/8 1862,
2 CONT G. 26/11 1847 m. enkja etter nr. 78, Anna Jakobsd., g. 3. m. nr. 80.
2 CONT Born:
2 CONT * a. Inger, f. 6/10 1848, g. m. Rasmus Nilsson, Stangeland nr. 38.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 210, nr. 80'''
2 CONT Svein Eivindson, frå Re, Time, f. 1815, d. 31/1 1890,
2 CONT G. 22/3 1863 m. enkja etter nr. 79, Anna Jakobsd. Ingi born.
