2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sørbø, side 279, nr. 47'''
2 CONT Salomon Olson, son åt nr. 46, f. 1781, d. 16/9 1868,
2 CONT G. 4/3 1810 m. Anna Pedersd., Meland nr. 10b, f. 1791, d. 8/10 1867.
2 CONT Born:
2 CONT * a. Ola, f. 13/1 1811, skulelærar i Høyland, seinare Kristiansand, g. m. Maria Jonsd., Soma 59.
2 CONT * b. Peder, f. 14/5 1813, Orstad nr. 32.
2 CONT * c. Rakel Kirstine, f. 22/10 1815, ug., d. 10/8 1865.
2 CONT * d. Juditte, f. 11/1 1821, ug., d. 24/2 1907.
2 CONT * e. Inger, f. 17/4 1826, ug., d. 16/10 1905.
2 CONT * f. Jan, f. 27/8 1823, nr. 48.
2 CONT * g. Anna Maria, f. 19/6 1829, ug., d. 19/11 1881.
2 CONT * h. Rasmus, f. 28/5 1837, nr. 59.
2 CONT Salomon fekk grundesetel på Vådeland 14/3 1809.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sørbø, side 279, nr. 48'''
2 CONT Jan Salomonson, son åt nr. 47, f. 29/8 1823, d. 22/5 1918,
2 CONT G. 3/4 1862 m. Rakel Pernille Rasmusd., Norheim, Time, f. 8/9 1837, d. 13/3 1923.
2 CONT Born:
2 CONT * a. Peder Adolf, f. 12/5 1864, Kleppe nr. 114.
2 CONT * b. Anna, f. 7/9 1867, g. m. Andreas Hansson Haugland, Kleppe 114.
2 CONT * c. Sven, f. 29/6 1870, bonde på n. Sørbø.
2 CONT * d. Rasmus, f. 1/7 1874, nr. 49.
2 CONT * e. Regina Justine, f. 12/2 1878, ug., d. 13/5 1957.
2 CONT Jan fekk feste 30/6 1862, førd 1865, 1875 og 1900.
