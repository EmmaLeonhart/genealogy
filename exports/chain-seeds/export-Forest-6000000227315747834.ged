2 CONT 1 NAME Jørgen /Halvardson Tekse/
2 CONT
2 CONT 1 SEX M
2 CONT
2 CONT 1 BIRT
2 CONT
2 CONT 2 PLAC Njå, Time
2 CONT
2 CONT 1 DEAT
