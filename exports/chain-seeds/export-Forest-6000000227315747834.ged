2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Stangeland, side 260, nr. 72'''
2 CONT Tore Olson, son åt Ola Halvardson, Austvoll 20, Høyland, f. 2/4 1786, d. 21/6 1824,
2 CONT G. 26/2 1818 m. Marta Reiersd., Vashus nr. 28, f. 1791, d. 5/3 1872, g. 2. m. nr. 73.
2 CONT Born:
2 CONT * a. Lars, f. 29/11 1818, Hole nr. 13.
2 CONT * b. Serina, f. 8/3 1822, g. m. Karl Torjusson, Sele nr. 102.
2 CONT Tore budde først på Anda, seinare Stangeland.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sørbø, side 278, nr. 35'''
2 CONT Lars Toreson, sjå Hole nr. 13.
2 CONT Lars fekk feste på Solbrekk etter verfaren 7/3 1849, flytta til Hole.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hole, side 128, nr. 13'''
2 CONT Lars Toreson, son åt Tore Olson, Stangeland nr. 72, f. 29/11 1818, d. 9/11 1907,
2 CONT G. 12/10 1848 m. Anna Berta Jansd., n. Sørbø nr. 34, f. 25/12 1822, 26/6 1895.
2 CONT Born:
2 CONT * a. Ane Kirstine, f. 2/8 1849.
2 CONT * b. Maria, f. 2/8 1849.
2 CONT * c. Tore, f. 26/5 1851, USA.
2 CONT * d. Johan, f. 11/11 1854, Tjelta, Håland.
2 CONT * e. Berta, f. 2/4 1857, g. m. Jens Rasmusson, Borsok nr. 17.
2 CONT * f. Lars, f. 13/1 1860, USA.
2 CONT * g. Ola, f. 3/6 1864, USA.
2 CONT * h. Tønnes Enevald, nr. 14.
2 CONT * i. Elen, f. 7/12 1855, g. m. Ole Mandius Tolleivson, Malmeim 72b.
2 CONT Lars budde på n. Sørbø, Friestad og frå 1853 i Hole, der han var husmann i Tjeldsnes, førd 1865, og 1875, 1900 oppsettmann.
