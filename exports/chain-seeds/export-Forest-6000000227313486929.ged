2 CONT https://books.google.fi/books?id=H5jPqbFL81wC&pg=PA126&lpg=PA126&dq=Ottone+I+Guglielmo+di+Borgogna&source=bl&ots=dfSg_ld2Io&sig=J9B1d-4irX5MLfgRmlaIKe1cc44&hl=fi&sa=X&ved=0ahUKEwjY8orLjMjPAhWKBSwKHdjGALMQ6AEIdDAJ#v=onepage&q=Otton
