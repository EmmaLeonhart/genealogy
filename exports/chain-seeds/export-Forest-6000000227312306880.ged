2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 311, nr. 6'''
2 CONT Sivert Monson, son åt Mons Gitleson, n. Øksnevad nr. 4, f. 1648, g. m. Maria Nils., ø. Bore nr. 4c, d. 1715.
2 CONT Born:
2 CONT * a. Mons, f. 1681, Hauge nr. 7.
2 CONT * b. Guri, f. 1679, d. 1741.
2 CONT * c. Kirsti, g. m. Torger Mortenson Tegle, Time, g. 2. m. Johannes Monson Tegle, Time.
2 CONT * d. Malena, f. 1688, g. m. nr. 15.
2 CONT * e. Johanna, f. 1693, d. før 1741.
2 CONT * f. Berta, g. m. nr. 7.
2 CONT * g. Anna, innstemna 1691 for samleie med soldat Ommund Isakson Sele.
2 CONT Sivert er førd som lagrettemann 1673-1696, førd i manntallet 1701, og 1706 brukar han 2 pd., førd til 1722.
2 CONT Tiende 1681-1683.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 312, nr. 15'''
2 CONT Ivar Klausson, son åt Klaus Klausson, Reve nr. 12, f. 1657, d. 1735,
2 CONT G. m. ? men 1713 er han innstemna for <<leyermål i sit ægteskab med quindfolket Randvi Jertesd. som forleden år tiente ham>>.
2 CONT G. II. m. Malena Sivertsd. nr. 6d, f. 1688, d. 1769.
2 CONT Born:
2 CONT * a. Klaus, d. før mora.
2 CONT * b. Sivert, f. 1725, nr. 17.
2 CONT * c. Gjertrud, f. 1717, g. m. Erik Erikson Tvihaug, Varhaug, g. 2. m. Knut Sveinson.
2 CONT * d. Malena, g. m. Gitle Ommundson, s. Salte nr. 46.
2 CONT * e. Helga, d. før mora.
2 CONT * f. Karen, f. 1724, g. m. Samuel Person, Åse 32A, Høyland.
2 CONT * g. Ragnhild, f. 1730.
2 CONT * h. Berit, f. 1732, g. m. Nils Nilsson, Skjæveland 40, Høyland, g. 2. m. Elling Eivindson, Grødeland nr. 23.
2 CONT Ivar er førd 1701, 1706 brukar han 12 sp. 1723 18 sp. førd til 1735.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vik, side 313, nr. 16'''
2 CONT Ola Olson, f. 1710, d. 1770,
2 CONT G. m. enkja etter nr. 15, Malena Sivertsd. Ingi born.
2 CONT Ola er førd 1735-1763. Budde seinare på Trones nr. 19, Høyland.
