1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hodne, side 124, nr. 35
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hodne, side 121, nr. 6
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øystre Bore, side 54, nr. 30.c
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øystre Bore, side 54, nr. 30'''
2 CONT Johannes Olson, son åt Ola Husvegg, Varhaug, f. 1667, d. 1746,
2 CONT G. I. m. Helga Villumsd.
2 CONT Born:
2 CONT * a. Ola, Nese, nr. 9.
2 CONT * b. Ola, f. 1716, Hodne, nr. 7.
2 CONT * c. Kari, g. m. Ola Kristofferson Hodne 35, g. 2. m. Albret Erikson Hodne 6.
2 CONT G. II. m. Kari Kristoffersd., Hodne nr. 34, g. 2. m. nr. 31.
2 CONT Born:
2 CONT * d. Ola, f. 1732.
2 CONT * e. Villum, f. 1736.
2 CONT * f. Johannes Kristoffer, f. 1744.
2 CONT * g. Helga, f. 1728, g. m. Eivind Pederson Reve nr. 40.
2 CONT * h. Malena, f. 1730.
2 CONT * i. Inger, f. 1737.
2 CONT Johannes fekk bøgsel på 16 sp. 13/12 1720, førd til 1746. Førd frå 1711.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hodne, side 124, nr. 35'''
2 CONT Ola Kristofferson, son åt nr. 34, f. 1705, d. 1742,
2 CONT G. 1734 m. Karen Johannesd., ø. Bore nr. 30c,
2 CONT G. 2. m. nr. 6.
2 CONT Born:
2 CONT * a. Kristoffer, f. 1735, nr. 37.
2 CONT * b. Helga, f. 1737.
2 CONT * c. Malena, f. 1739.
2 CONT Ola fekk skøyte på 12 sp. 15/3 1737, førd som brukar 1728-1743, så enkja.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hodne, side 121, nr. 6'''
2 CONT Albret Erikson, son åt nr. 5, f. 1697, d. 1769,
2 CONT G. I. m. Berit Anfinnsd., Skas nr. 24e, d. 1741.
2 CONT Born:
2 CONT * a. Anna, f. 1741, ikkje nemnd i skifte etter faren.
2 CONT * b. Bertel, f. 1741, nr. 21.
2 CONT G. II m. enkja etter nr. 35, Kari Johannesd.
2 CONT Born:
2 CONT * c. Anna Maria, f. 10/5 1748.
2 CONT Albret fekk bøgsel på 1 pd. 13/12 1720, førd til 1743.
2 CONT
2 CONT ----
2 CONT
2 CONT Ho var datter til Johannes Olsen Østre Bore og kona Helga Villumsdtr.  Karen er også kalla Kari.  Ho vart som enke gift med enkemannen Albert Eriksen Hodne på Hodne br 1. De hadde 1 barn.
