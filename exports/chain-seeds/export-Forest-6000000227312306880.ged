2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orstad, side 182, nr. 27'''
2 CONT Ole Johan Toreson, son åt nr. 26, f. 10/4 1862, d. 10/2 1960,
2 CONT G. 10/4 1897 m. Olina Petersd., Vagle 39, Høyland, f. 9/7 1876, d. 23/1 1959.
2 CONT Born:
2 CONT * a. Maria, f. 15/2 1898, g. m. Søren Toreson Oftedal, Lima.
2 CONT * b. Tore, f. 16/6 1899, USA, d. 1926.
2 CONT * c. Olina, f. 16/1 1901, g. m. Aleks Pederson Egeland, Bryne, bakar.
2 CONT * d. Ane, f. 10/6 1902, g. m. Johan Jakobson Friestad, Ogna, industriarbeidar, Orstad.
2 CONT * e. Petter, f. 6/7 1904, Korgen, Mo i Rana.
2 CONT * f. Olivia, f. 8/7 1906, ug., hushaldar.
2 CONT * g. Martine, f. 27/12 1907, g. m. Torvald Time, Lister.
2 CONT * h. Ottar Johannes, f. 14/9 1909, bonde på farsgarden.
2 CONT * i. Gudrun, f. 4/4 1911, d. 21/2 1938.
2 CONT * j. Margit, f. 30/8 1912, g. m. Lars Andreasson Risa, Hognestad.
2 CONT * k. Rakel, f. 10/1 1914, g. m. Georg Gustavson Lode, Time.
2 CONT * l. Jonas, f. 28/4 1916, paktar, Orstad.
2 CONT * m. Anna Dagny, f. 10/12 1919, g. m. Gunvald Lode, paktar.
2 CONT Ola fekk skøyte på farsgarden, 6/5 1905, førd 1900 og 1906.
