2 CONT
2 CONT A2. (ex 1°) '''Maso''' (* 4-2-1426 + 13-4-1491), 
2 CONT
2 CONT *dei X di Libertà nel 1453 e 1479, 
2 CONT *Gonfaloniere di compagnia nel 1458,
2 CONT *Camerlengo di Pisa nel 1459, 
2 CONT *Console della zecca nel 1461, degli VIII di Guardia e Balìa nel 1469 e 1478, dei XII Buonomini nel 1471, 
2 CONT *Gonfaloniere di Giustizia della Repubblica di Firenze nel 1474, 
2 CONT *Capitano di Volterra nel 1475, 
2 CONT *Podestà di Pisa nel 1477, 
2 CONT *ambasciatore a Roma nel 1480, 
2 CONT *Capitano di Pistoia e Volterra nel 1488, 
2 CONT *Riformatore del Monte Comune nel 1490. 
2 CONT
2 CONT #a)      = 1451 Albiera, figlia di Orlando de’ Medici (+ 28-5-1455) (vedi/see)
2 CONT
2 CONT #b)      = 1457 Caterina, figlia di Tommaso Soderini e di Dianora Tornabuoni (+ 29-3-1511) (vedi/see)
