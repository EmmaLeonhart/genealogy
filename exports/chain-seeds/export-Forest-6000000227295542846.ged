1 NOTE {geni:about_me} {{https://encrypted-tbn0.gstatic.com/images?q=tbn:ANd9GcTWSyh8LjKqfARXvfCaHlce00dN_Z_1miyeh7FPGTreAocGmFWBN5AoapiGri4VxqgSE8Q&usqp=CAU|right|90px|border|link=//en.wikipedia.org/wiki/The_Profession_of_Arms_(2001_fil
2 CONC m)}}
