2 CONT '''Familie'''	
2 CONT
2 CONT Jørgen Daa,   f. 11 nov. 1532, Vollerup, Gimlinge (Vester Flakkebjerg H., Sorø) ,   d. 1598, Snedinge, Ørslev (Vester Flakkebjerg H., Sorø)   (Age 65 år) 
2 CONT
2 CONT '''Børn''' 	
2 CONT
2 CONT * 1. Dorte Jørgensdatter Daa,   f. 1563,   d. 20 nov. 1624, Roskilde Købstad   (Age 61 år)
2 CONT * 2. Erik Daa,   d. Portugal
2 CONT * 3. Herluf Trolle Daa, i Snedinge,   f. 1565, Bergen, Hordaland, Norge  ,   d. 7 feb. 1630, Snedinge, Ørslev (Vester Flakkebjerg H., Sorø)   (Age 65 år)
2 CONT * 4. Margrethe Jørgensdatter Daa,   f. 17 apr. 1567, Bergenhus, Bergen, Hordaland, Norge  ,   d. 24 maj 1633, Agnäs, Skatelöv, Smaaland, Norge   (Age 66 år)
2 CONT * 5. Karen Jørgensdatter Daa,   d. eft. 1655
2 CONT * 6. Lene Jørgensdatter Daa,   f. 1573,   d. 15 jul. 1649, Öretorp, Sverige   (Age 76 år)
2 CONT * 7. Ellen Jørgensdatter Daa,   d. før 1615
2 CONT * 8. Anne Jørgensdatter Daa,   d. før 1634
2 CONT * 9. Else Jørgensdatter Daa
