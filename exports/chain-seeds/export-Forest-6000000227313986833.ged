2 CONT
2 CONT Jesper Heiberg    (1701 - 1762) 
2 CONT
2 CONT Søffren Andersen Heiberg giftet seg ABT 1703 med Birgitte Margrethe Gabrielsdtr Linde
2 CONT
2 CONT Barn:
2 CONT
2 CONT Mette Maria Heiberg    (1706 - 1746) 
2 CONT
2 CONT Gabriel Heiberg    (1708 - 1768) 
2 CONT
2 CONT Foreldre og besteforeldre:
2 CONT
2 CONT         Søffren Lauritzsøn Heiberg
2 CONT
2 CONT         |
2 CONT
2 CONT     Anders Søfrenssøn Heiberg
2 CONT
2 CONT     |   |
2 CONT
2 CONT     |   Anne Madsdtr
2 CONT
2 CONT     |
2 CONT
2 CONT Søffren Andersen Heiberg
2 CONT
2 CONT     |
2 CONT
2 CONT     |   Giert Morgenstierne
