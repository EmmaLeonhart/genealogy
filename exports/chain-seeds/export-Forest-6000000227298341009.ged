1 NOTE {geni:about_me} ='''Olof Eriksson Wijk'''=
2 CONT
2 CONT '''Född''':	 9 januari 1719 
2 CONT Vikan Mellangård, Vikan, Björlanda, Bohuslän, Sverige
2 CONT
2 CONT '''Yrke''':	Kofferdistyrman
2 CONT
2 CONT '''Död''':	 27 april 1800 (81)  Vikan Mellangård, Vikan, Björlanda, Bohuslän, Sverige (Ålderdom) 
2 CONT
2 CONT '''Son''' till Erik Nilsson Wijk och Maria Eriksdotter 
2 CONT
2 CONT '''Make''' till Anna Jacobsdotter 
2 CONT
2 CONT '''Fader''' till Eric Olofsson Wijk; Cornelia Olofsdotter Wijk; Ingeborg Olofsdotter Wijk; Maria Olofsdotter Wijk; Cornelius Olofsson Wijk och Anders Olofsson Wijk 
2 CONT
2 CONT '''Bror''' till Erik Eriksson; Anders Eriksson Hising; Kerstin Eriksdotter; Helena Eriksdotter; Elin Eriksdotter; och Cornelius Eriksson 
2 CONT ----
2 CONT
2 CONT =='''Källor:'''==
2 CONT
2 CONT Olof, född i januari 1719, nämnd ogift hemma i mtl 1754, var gift 1755 och död 1800 21/5 i Viken Mellangård
2 CONT
2 CONT "Wijk, Viken och Siöhierta" av Henrik Karlsson 2020
2 CONT
2 CONT https://docplayer.se/208255397-Wijk-viken-och-siohierta.html
2 CONT
2 CONT https://www.adelsvapen.com/genealogi/Wijk_nr_2342
2 CONT
2 CONT ----
2 CONT '''Död:'''
