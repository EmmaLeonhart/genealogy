1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Sørbø, side 277, nr. 32.c
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Sørbø, side 277, nr. 33
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Sørbø, side 277, nr. 32'''
2 CONT Tollef Tollakson, son åt nr. 31, f. 5/8 1798, d. 29/1 1885,
2 CONT G. 18/3 1823 m. Anna Tollefsd., Håland nr. 12f, f. 13/11 1799, d. 26/5 1888.
2 CONT Born:
2 CONT * a. Tønnes, f. 24/2 1826, Stangeland nr. 53.
2 CONT * b. Elling Johan, f. 22/11 1828, Stavanger, handelsmann, d. 1868.
2 CONT * c. Martin, f. 10/9 1834, nr. 33.
2 CONT * d. Svein, f. 16/9 1831, Stavanger, bakarmeistar.
2 CONT * e. Taletta, f. 12/12 1838, g. m. Øystein Bendiksson, Nese nr. 35.
2 CONT * f. Anna Serina, f. 7/6 1842, g. m. Jon Eivindson, Sveinsvoll nr. 39.
2 CONT Tollef er førd som brukar 1824-1861, kongeskøyte på 11 mark smør 12/11 1851, skyld 3,73 mark.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Sørbø, side 277, nr. 33'''
2 CONT Martin Tollefson, son åt nr. 32, f. 10/9 1834, d. 29/1 1927,
2 CONT G. I. 26/3 1863 m. Anna Maria Eivindsd., Sveinsvoll nr. 38d, f. 12/6 1841, d. 24/9 1881.
2 CONT Born:
2 CONT * a. Anna, f. 8/2 1864, g. m. nr. 42.
2 CONT * b. Tollef, f. 22/3 1871, USA.
2 CONT G. II. 5/9 1883 m. Jorine Rasmusd., Håland, Time, sjå Ravndal 41, Gjestal, f. 18/5 1851, d. 19/6 1925.
2 CONT Born:
2 CONT * c. Arne, f. 25/6 1884, bonde på farsgarden.
2 CONT * d. Ragnvald, f. 6/3 1886, USA, d. 9/1 1960 i Montana.
2 CONT * e. Martin, f. 23/1 1888, USA.
2 CONT * f. Maria, f. 31/8 1890, g. m. Georg Gustavson Lode, ø. Sørbø.
2 CONT * g. Marta, f. 18/1 1892, USA.
2 CONT * h. Anna, f. 10/4 1894, g. m. Sven Karlson Taksdal, jordbruksskulestyrar, Tveit, Rogaland.
2 CONT * i. Svein, f. 22/5 1899, bonde på s. Braut.
2 CONT Martin fekk skøyte på farsgarden 30/6 1862, førd 1900 og 1906, 3,73 mark.
