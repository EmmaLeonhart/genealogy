1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Engelsvåg, side 75, nr. 24.e
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Engelsvåg, side 75, nr. 24'''
2 CONT Tollef Larsson, son åt Lars Tollefson, ø. Øksnevad nr. 22, f. 1826, d. 4/7 1896,
2 CONT G. 11/4 1855 m. Berta Larsd., ø. Øksnevad nr. 15c, f. 9/6 1835, d. 30/6 1932.
2 CONT Born:
2 CONT * a. Lena Serina, f. 13/6 1857, USA, g. m. Andreas Olai Gabrielson, n. Sørbø nr. 58b.
2 CONT * b. Lars, f. 23/1 1859. Han fekk skøyte på farsgarden 9/8 1879, men for til USA.
2 CONT * c. Laurits, f. 23/2 1861, USA.
2 CONT * d. Arnt, f. 29/4 1863, nr. 25.
2 CONT * e. Anna Maria, f. 18/4 1865, g. m. Andreas Olson Tegle, Time.
2 CONT * f. Tollef, f. 21/7 1867, USA.
2 CONT * g. Elisabet Johanna, f. 24/1 1870, USA.
2 CONT * h. Bernhardine, f. 20/3 1872, g. m. Tollef Martinson Tjøtta 45b.
2 CONT * i. Anna Elisabet, f. 15/12 1875, g. m. Martin Rasmusson Skjæveland, bonde på Laland, seinare Sele.
2 CONT * j. Tomas Teodor, f. 30/5 1878, Laland, nr. 17.
2 CONT * k. Berta Elisabet, f. 17/12 1880, g. m. Emil Andreasson Åse 60, Høyland.
2 CONT * l. Ludvig, f. 7/3 1883, d. 14/3 1905.
2 CONT Tollef fekk skøyte på 1 1/2 sp. av br. nr. 1, 29/6 1860, førd til 1894. Skyld 1,42.
