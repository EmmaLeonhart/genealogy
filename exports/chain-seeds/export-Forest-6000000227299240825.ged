1 NOTE {geni:about_me} * https://www.slektogdata.no/gravminner/grav/480ada8b-3b9c-4751-b906-b76a63833591
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 285, nr. 17.b
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Borsok, side 58, nr. 15
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Borsok, side 58, nr. 16
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 285, nr. 17'''
2 CONT Ola Sveinson, son åt Svein Norheim, Time, f. 1832, d. 2/10 1918,
2 CONT G. I. 30/3 1853 m. Guri Larsd., n. Braut nr. 37d, f. 10/3 1836, d. 11/5 1861.
2 CONT Born:
2 CONT * a. Lars, f. 11/3 1860, nr. 18.
2 CONT * b. Gustine, f. 22/5 1858, g. m. Ola Rasmusson, Borsok nr. 15.
2 CONT * c. Svein, f. 11/3 1860, Rossaland, Time.
2 CONT Ola budde først på Norheim og Rossaland, Time, fekk skøyte på dette bruket, 46 øre frå br. nr. 1, 11/7 1873, budde seinare på br. nr. 28.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Borsok, side 58, nr. 15'''
2 CONT Ola Rasmusson, son åt nr. 14, f. 28/10 1844, d. 9/5 1886,
2 CONT G. 16/3 1880 m. Gustine Olsd., Tjøtta 17b, f. 22/5 1858, d. 19/6 1926.
2 CONT Born:
2 CONT * a. Karen Pernille Bolette, f. 11/2 1881, USA.
2 CONT * b. Gurina Maria, f. 14/3 1883, g. m. Lars Olson Tollefson, Stavanger.
2 CONT * c. Regina, f. 15/5 1885, g. m. Endre Endreson, Hellesøy, Hetland.
2 CONT Ola fekk skøyte på farsgarden fråskilt br. 3, så skylda vart 1,47.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Borsok, side 58, nr. 16'''
2 CONT Ola Martinson, sjå Johannes Johannesson, ø. Bore nr. 36, f. 26/2 1862, d. 15/2 1945,
2 CONT G. 30/11 1886 m. enkja etter nr. 15, Gustine Olsd.
2 CONT Born:
2 CONT * a. Bertine Olava, f. 27/8 1887, g. m. Reidar Jonson, Laland 31c.
2 CONT * b. Martine Maria, f. 30/7 1889, USA.
2 CONT * c. Johanna Sofie, f. 29/3 1893, g. m. Kristian Hagbartson Skjerven, Asker.
2 CONT * d. Oluf Emil, f. 27/7 1898, bonde på farsgarden, seinare USA.
2 CONT Ola fekk skøyte på konegarden 13/4 1901, 1,47 mark.
2 CONT
2 CONT ----
2 CONT
2 CONT Gurine (Olesdtr.) Tjøtta (1858-1926) frå bnr. 2 av Tyøtta I Klepp, enke etter Ola (Rasmusson) Borsheim (1844-1886), bonde på farsgarden bnr. 2 av Borsok frå 1882 Reidar budde seinar hos dottera Ragna på Tu.
