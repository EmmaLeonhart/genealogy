2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 208, nr. 55'''
2 CONT Gabriel Bårdson, son åt Bård Bårdson, Friestad nr. 43, f. 1773, d. 4/8 1844,
2 CONT G. I. 7/3 1808 m. Kirsti Andersd., Tjøtta nr. 79, f. 1770, d. 28/8 1814, enkja etter Erik Erikson, Tjøtta nr. 80.
2 CONT Born:
2 CONT * a. Ingeborg, f. 15/1 1809, g. m. nr. 56.
2 CONT * b. Eilert Bendiks, f. 28/4 1811, nr. 59.
2 CONT * c. Adriane, f. 10/10 1813, g. m. Peder Rasmusson, Friestad nr. 45.
2 CONT G. II. 8/6 1817 m. Marta Pedersd., i. Lima 37, Gjestal, f. 19/10 1788, d. 15/5 1857.
2 CONT * d. Kirsti, f. 7/7 1841, g. m. Svein Eivindson Re, Time.
2 CONT * e. Peder, f. 15/8 1820, nr. 35.
2 CONT * f. Gabriel, f. 13/4 1826, nr. 63.
2 CONT * g. Jens Berner, f. 27/8 1829, nr. 92.
2 CONT Gabriel fekk skøyte på 18 + 2/3 sp. 15/3 1814, og på 9 + 1/3 sp. 13/11 1827, så er bruket samla att. Førd til 1838.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Rosland, side 211, nr. 92'''
2 CONT Jens Berner Gabrielson, son åt nr. 55, f. 27/8 1829, d. 19/2 1886,
2 CONT G. I. 13/4 1852 m. Marta Serina Eriksd., Haugland, Time, f. 13/9 1819, d. 27/1 1874.
2 CONT * a. Justine, f. 29/8 1854, USA., d. 1943.
2 CONT * b. Grete Maria, f. 9/6 1856, g. m. Peder Pederson, n. Sørbø nr. 63.
2 CONT * c. Elen, f. 28/10 1857, g. m. Karl Edvardsen i Høyland, g. 2. m. Peder Ellingson, Tjøtta nr. 116.
2 CONT * d. Ingeborg Marie, f. 11/10 1860, USA.
2 CONT * e. Kirsten, f. 28/1 1863, USA.
2 CONT G. II. 11/5 1876 m. Maria Olsd., Elvestrøm, Sokndal, f. 1840, d. 25/6 1910.
2 CONT * f. Oluf, f. 1/12 1876, Trones, USA.
2 CONT * g. Maren Serine, f. 16/2 1879, g. m. Simmer Gabrielson, bakar, Pollestad.
2 CONT * h. Eilert Bendiks, f. 28/10 1880, småbrukar, ø. Åse.
2 CONT * i. Berner, f. 8/8 1885.
2 CONT Jens er førd i folketelling 1865 som husmann.
