2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Øksnevad, side 324, nr. 25'''
2 CONT Jon Person, son åt nr. 24, f. 1767, d. 15/4 1843,
2 CONT G. 7/2 1808 m. Marta Ommundsd., Tjensvoll, Time, f. 11/9 1785, d. 4/5 1861.
2 CONT Born:
2 CONT * a. Grete, f. 1/1 1809, g. m. Gabriel Samuelson, Kleppe nr. 12.
2 CONT * b. Ingeborg Margrete, f. 10/3 1811, g. m. Velle Mortenson, Orstad nr. 58b.
2 CONT * c. Per, f. 29/11 1812, nr. 26.
2 CONT * d. Ommund, f. 11/12 1814, Stavanger, skipsførar.
2 CONT * e. Marta Maria, f. 28/9 1817, g. m. Ole Syvertson Rygg, Stavanger, styrmann. Dei fekk: Johanne Margrete, f. 28/9 1840.
2 CONT * f. Jonas, f. 8/10 1819, Stavanger, bøkkar.
2 CONT * g. Rasmus, f. 23/7 1822, Stavanger, skipsførar.
2 CONT * h. Ane Elisabet, f. 24/11 1824.
2 CONT * i. Eivind, f. 29/5 1827, d. 7/10 1853, ug.
2 CONT * j. Joakim, f. 29/5 1827, d. 13/6 1861, ug.
2 CONT * k. Aksliane, f. 26/9 1829, g. m. Ola Sveinson Hadland, Time.
2 CONT Jon fekk skøyte på farsgarden 7/7 1807, førd til 1840.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nedre Øksnevad, side 324, nr. 26'''
2 CONT Per Jonson, son åt nr. 25, f. 29/11 1812, d. 13/11 1890,
2 CONT G. 5/6 1845 m. Berta Sveinsd., Heigre 33, Høyland, f. 25/11 1825, d. 4/6 1895.
2 CONT Born:
2 CONT * a. Jon, f. 8/5 1846, nr. 27.
2 CONT * b. Margrete, f. 12/7 1848, g. m. Ommund Jørgenson Brådland, Stavanger, hermetikkfabrikkeigar.
2 CONT * c. Johan Sebulon, f. 26/2 1851, Egersund.
2 CONT * d. Eivind, f. 2/1 1854, USA.
