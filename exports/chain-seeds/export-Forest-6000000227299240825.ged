2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 286, nr. 29'''
2 CONT Johannes Tollefson, son åt Tollef Tollefson Høien, Varhaug, f. 1770, d. 9/1 1831,
2 CONT G. 23/11 1798 m. Berta Olsd., s. Salte nr. 12a, f. 1778, d. 14/5 1849.
2 CONT * a. Anna Gurina, f. 6/10 1799, g. m. nr. 21.
2 CONT * b. Ola, f. 9/1 1803, nr. 30.
2 CONT * c. Johannes, f. 6/6 1808, Kleppe nr. 59.
2 CONT * d. Berta Serina, f. 8/9 1811, g. m. Andreas Andreasson, n. Sørbø 60a.
2 CONT * e. Isak, f. 17/4 1818.
2 CONT * f. Lars, f. 25/10 1821, m. Salte nr. 24.
2 CONT Johannes fekk feste på Refsnes 12/11 1799.
2 CONT
2 CONT ----
2 CONT
2 CONT Konfirmert i 1788, 17 år gammel
2 CONT --------------------
