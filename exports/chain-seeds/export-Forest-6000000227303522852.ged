1 NOTE {geni:about_me} * Lund historie I, Gårdens og slektens liv, Hellesmark, side 113, nr. VIII.9
2 CONT * Lund historie I, Gårdens og slektens liv, Hellesmark, side 113, nr. IX
2 CONT * Lund historie I, Gårdens og slektens liv, Hellesmark, side 118, nr. V
2 CONT
2 CONT '''Lund historie I, Gårdens og slektens liv, Hellesmark, side 113, nr. VIII'''
2 CONT Anfinn Kristiansen. F. 1724, 34 år 1758. Fikk bygselbrev på 21 bm. dat. 21-1-1766 + 9 bm. som Peder Jenssen (se foran) hadde brukt, bygsel dat. 9-1-1776.
2 CONT Peders enke Ingrid Anstensdatter, fikk da folge.
2 CONT G. 5-12-1765 m. Berte Olsdatter, f. i Bakke sogn 1738, 20 år 1758, dtr. av Ole Stålesen, Setre/Ovedal.
2 CONT Anfinn grl. 30-1-1808, sk. 1-4 s. år. Berte grl. 14-11-1825.
2 CONT Barn:
2 CONT # Kristian, se br. nr. 2.
2 CONT # Ole, f. 12-3-1769, grl. 15-12-1771, kopper.
2 CONT # Siri, f. 31-1-1772, grl. 9-7 s. år, kopper.
2 CONT # Jens, f. 18-8-1773, d. 14-3-1846 ug.
2 CONT # Ole, f. samme dag, bodde i Flekkefjord.
2 CONT # Malene, f. 21-1-1775, g. 15-3-1810 m. Brynild Nilssen Haukland, br. 9.
2 CONT # Siri, f. 3-12-1777, d. 18-12-1823, ug.
2 CONT # Andreas, f. 12-1-1780, sk. 12-11-1817, ug.
2 CONT # Lars, se nedenfor.
2 CONT
2 CONT '''Lund historie I, Gårdens og slektens liv, Hellesmark, side 113, nr. IX'''
2 CONT Lars Anfinsen. F. 27-5-1783, fikk bygselbrev på halve farsbruket, 15 bm., dat. 19-10-1805.
2 CONT G. 15-6-1823 m. enke Lisabet Cicilie Kristiansdatter, f. 1794, dtr. av Kristian Asbjørnsen, N. Drivdal, enke etter Nils Andreas Nilssen Hellesmark, br. 4.
2 CONT Lisbet d. 24-4-1842, sk. 23-6 s. år. Lars d. 14-11-1857.
2 CONT Nå kunne brukere få løse inn sine gårder, men ingen av barna her fant høve til det. De forsvant hver til sin kant uten å søke utflytningsattest. En fremmed rykket inn på gården.
2 CONT Barn:
2 CONT # Anne Bergitte, f. 10-12-1823, g. 20-11-1846 m. Berent Zacharias Hans Kristiansen Djupedal.
2 CONT # Else Katrine, f. 15-9-1826, reiste til Mosterhavn 1863.
2 CONT # Andreas, f. 30-3-1829.
2 CONT # Karoline, f. 20-2-1832, d. 26-5-1834.
2 CONT # Berte, f. 14-4-1834, d. ug.
2 CONT # Kristen, f. 7-1-1836.
2 CONT
2 CONT '''Lund historie I, Gårdens og slektens liv, Hellesmark, side 118, nr. V'''
2 CONT Nils Andreas Nilssen. Dpt. 19-9-1798, fikk bygsel på 15 bm. 31-3-1819.
