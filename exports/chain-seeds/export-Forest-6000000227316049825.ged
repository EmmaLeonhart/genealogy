1 NOTE {geni:about_me} * [http://www.noord-hollandsarchief.nl/search/?mizig=210&miaet=1&micode=3237&minr=1221361 noord-hollandsarchief.nl...] ;
2 CONT
2 CONT '''Anthony de Glarges''', advocaat *  , schepen en burgemeester van Haarlem * ged. Haarlem 27-12-1654 begr. Haarlem 20-8-1723
2 CONT *trouwt 1e Haarlem o.t. 28-1/13-2-1680Catharina de Ridderged. Haarlem 2-7-1662 begr. Haarlem 25-3-1699dochter van Pieter de Ridder, koopman *  , en Susanna van Damme * 
2 CONT *trouwt 2e Haarlem o.t. 26-3./tr. 9-4-1702 Jacoba Sophia Huydekoper, weduwe van Arnout Druyvesteyn, eerder van Guiljelmo Bartolotti van den Heuvel geb. Amsterdam-begr. Haarlem 29-6-1714 
2 CONT *'''kinderen''', allen gedoopt te Haarlem
2 CONT *'''uit het 1e huwelijk'''
2 CONT ># 1. Philippus, ged. 13-5-1681, begr. Haarlem 7-5-1683
2 CONT ># 2. Susanna, ged. 13-1-1684, begr. Haarlem 15-3-1746, bleef ongehuwd * 
2 CONT ># 3. Cornelia, ged. 27-8-1687, begr. Haarlem 4-2-1727, bleef ongehuwd
2 CONT ># 4. Philips, ged. 3-4-1689, begr. Haarlem 24-12-1720, secretaris van Haarlem, bleef ongehuwd
2 CONT ># 5. Gilles, ged. 31-8-1695, begr. Haarlem 25-1-1743, secretaris, schepen en burgemeester van Haarlem, bleef ongehuwd
2 CONT ># 6. Catharina, ged. 19-8-1696, begr. Haarlem 30-4-1727, trouwt Haarlem o.t. 2-12/tr.26-12-1725 Cornelis Pieter van Brakel. Hieruit: Cornelis Anthony, ged. Haarlem 20-4-1727, begr. Haarlem 15-5-1728
2 CONT *'''uit het 2e huwelijk'''
2 CONT ># 7. Anthony, ged. 6-3-1699, begr. Haarlem 30-3-1699
2 CONT ># 8. Kind, begraven Haarlem 16-9-1704
