1 NOTE {geni:about_me} 
2 CONT Erik Andersson Tallqvist
2 CONT
2 CONT Yrke: 
2 CONT
2 CONT Soldat och torpare i Fyrås, Hammerdal 
2 CONT
2 CONT Far: 
2 CONT
2 CONT Anders Olofsson (1711 - 1752) 
2 CONT
2 CONT Mor: 
2 CONT
2 CONT Karin Eriksdotter (1716 - 1794) 
2 CONT
2 CONT Född: 
2 CONT
2 CONT 1748-08-15 Hammerdal, Fyrås, Z 1) 
2 CONT
2 CONT Soldatstart: 
2 CONT
2 CONT 1769-03-01 i Hammerdal, Z 4) 
2 CONT
2 CONT Soldatavsked: 
2 CONT
2 CONT 1789-08-04 i Hammerdal, Z 4) 
2 CONT
