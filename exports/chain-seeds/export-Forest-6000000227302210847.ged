1 NOTE {geni:about_me} 
2 CONT
2 CONT Kerstin Johansdotter
2 CONT
2 CONT Född:
2 CONT  1) 
2 CONT
2 CONT Död: 1767 Gevåg, Ragunda (Z) 1) 
2 CONT
2 CONT Familj med Sven Olofsson (1703 - 1791)
2 CONT
2 CONT Vigsel: Ragunda (Z) 
2 CONT
2 CONT Barn:
2 CONT
2 CONT Olof Svensson (~1733 - 1764)  Jonas Svensson Wågman (1735 - 1805)  Kerstin Svensdotter (1738 - 1812)  Ingeborg Svensdotter (1740 - 1819)  Johan Svensson (- 1772) 
2 CONT
2 CONT Källor
2 CONT
2 CONT 1) Familjer i Ragunda av Staffan Lindkvist 
2 CONT
