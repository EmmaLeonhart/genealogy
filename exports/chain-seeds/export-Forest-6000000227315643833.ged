2 CONT Sven Gabrielson, son åt nr. 13, f. 23/5 1836, d. 15/4 1896,
2 CONT G. I. 10/10 1865 m. Berta Jorina Kristoffersd., Orre, Grude nr. 40, f. 2/8 1843, d. 13/10 1875.
2 CONT Born:
2 CONT * a. Gabriel, f. 9/8 1866, n. Braut nr. 58.
2 CONT * b. Kornelius, f. 9/9 1869, USA.
2 CONT * c. Martin, f. 5/1 1872, Erga nr. 46.
2 CONT * d. Kirsten Bergitte, f. 10/7 1874, g. m. Kajus Berntson Taksdal, Time, g. 2. m. Svein Undheim, Time.
2 CONT G. II. m. Anna Berta Eriksd., Erga nr. 30a, f. 2/6 1848, d. 22/4 1893.
2 CONT Born:
2 CONT * e. Betuel Johan, f. 25/1 1880, Erga nr. 45.
2 CONT * f. Elen, f. 30/4 1884, g. m. Ole Taksdal, Time.
2 CONT * g. Sven, f. 26/8 1886, Erga nr. 46.
2 CONT * h. Berta, f. 28/12 1890, g. m. Torkel, Haugesund.
2 CONT Sven fekk bøgsel 3/7 1866, førd til 1899.
2 CONT
