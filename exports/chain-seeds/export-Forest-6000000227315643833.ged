1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vashus, side 309, nr. 28.a
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Storhaug, side 262, nr. 7
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Vashus, side 309, nr. 28'''
2 CONT Reier Halvorson, son åt Halvor Johannesson, Storhaug nr. 5, f. 1745, d. 6/1 1836,
2 CONT G. m. Johanna Larsd. nr. 27, f. 1750, d. 31/7 1840.
2 CONT Born:
2 CONT * a. Lars, f. 1781, Storhaug nr. 7.
2 CONT * b. Halvard, f. 1783, nr. 29.
2 CONT * c. Barbro, f. 1788, g. m. Sivert Sivertson. Sele nr. 83a.
2 CONT * d. Marta, f. 1790, g. m. Tore Olson, Stangeland nr. 72, g. 2. m. Sivert Tostenson, Stangeland nr. 73.
2 CONT Reier fekk bøgsel etter verfaren 21/10 1777, førd til 1810.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Storhaug, side 262, nr. 7'''
2 CONT Lars Reierson, son åt Reiar Halvorson Vashus, sjå nr. 5a, f. 1774, d. 8/11 1869,
2 CONT G. 7/8 1802 m. enkja etter nr. 6, Berta Ivarsd.
2 CONT Born:
2 CONT * a. Marta, f. 12/9 1802, g. m. Svein Rasmusson, Sele nr. 66.
2 CONT * b. Johanna, f. 5/6 1808, g. m. Reier Eilefson, Hauge nr. 13.
2 CONT * c. Berta Elisabet, f. 24/2 1811, g. m. Ådne Sivertson, Sele nr. 85.
2 CONT * d. Reier, f. 6/3 1814, ug., d. 19/3 1881.
2 CONT * e. Lars, f. 27/4 1817, nr. 8.
2 CONT Lars fekk bøgsel på plassen 11/11 1802 og skøyte på bruket frå Kongen 26/5 1828.
2 CONT Det var 6 sp. skyld, halve Meland. Førd til 1840.
2 CONT
