0 @N6000000001634087901@ NOTE <!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
1 CONT           "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
1 CONT <html  xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head>
1 CONT <title></title>
1 CONT <meta http-equiv="content-type" content="text/html;charset=utf-8"/>
1 CONT <meta http-equiv="Content-Style-Type" content="text/css"/>
1 CONT </head>
1 CONT <body>
1 CONT <div align="left"><font face="Verdana" size="1"><span style="font-size:9pt">In 1743.02.03 word hy eienaar van die leenplaas ``de Bruintjies Rivier over de Berg'', 
1 CONT later Bruintjiesrivier. Die naam is ontleen aan een van hul ou perde met die 
1 CONT naam &quot;Bruintjie''.</span></font></div>
1 CONT </body>
1 CONT </html>
