0 @N6000000001634162755@ NOTE <!DOCTYPE html PUBLIC "-//W3C//DTD XHTML 1.0 Transitional//EN"
1 CONT           "http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd">
1 CONT <html  xmlns="http://www.w3.org/1999/xhtml" xml:lang="en" lang="en"><head>
1 CONT <title></title>
1 CONT <meta http-equiv="content-type" content="text/html;charset=utf-8"/>
1 CONT <meta http-equiv="Content-Style-Type" content="text/css"/>
1 CONT </head>
1 CONT <body>
1 CONT <div align="left"><font face="Verdana" size="1"><span style="font-size:9pt">Stamvader.</span></font></div>
1 CONT <div align="left"><br />
1 CONT </div>
1 CONT <div align="left"><font face="Verdana" size="1"><span style="font-size:9pt">Sy van H&#252;bner verhollands na Huppenaar, waarskynlik alreeds toe hy as soldaat by die 
1 CONT VOC aansluit - hy arriveer in 1693 aan die Kaap as soldaat. Hy was oorspronklik vanaf 
1 CONT Hamburg in Duitsland. Word bu rger in 1693, woon op die plaas Honswyk in Paarl, in 
1 CONT 1698 verban weens onwettige veehandel.</span></font></div>
1 CONT </body>
1 CONT </html>
0 @N6000000000269706810@ NOTE Ancestral File Number:<AFN> b3
