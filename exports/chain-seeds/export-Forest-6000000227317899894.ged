2 CONT * 1 tesje
2 CONT * 1 stel theegoed
2 CONT * 1 spiegel
2 CONT * 1 lootleepel
2 CONT * 1 knijptang
2 CONT * 1 aarde stoofpot
2 CONT * 1 thee trommel
2 CONT * 2 bijlen
2 CONT * 1 dissel
2 CONT * 2 souspotjes
2 CONT * 1 kandelaar
2 CONT * 2 stoelen
2 CONT * 1 pan
2 CONT * 1 rooster
2 CONT * 1 vleesvork
2 CONT * 1 meel zift
2 CONT * 1 zijl
2 CONT * 6 sakken
2 CONT * 2 cannen
2 CONT * 2 schoppen
2 CONT * 1 tafel
2 CONT * 1 rak
2 CONT * 2 keetels
2 CONT * 3 roers
2 CONT * 1 cadel
2 CONT * 2 bedden
2 CONT * 1 zadel
2 CONT * 1 toom
2 CONT * 1 paar ploeg wielen
2 CONT * 1 vuurtang
2 CONT * 1 gemaakte cousijn en planken tot de deure
2 CONT * 1 driequartiers boor
2 CONT * 1 slaaf
2 CONT * 
2 CONT * Cabo de Goede Hoop den 6 Meij 1762
2 CONT * 
2 CONT * Dit is + de eygen handteekening van Hendrik Clopper
