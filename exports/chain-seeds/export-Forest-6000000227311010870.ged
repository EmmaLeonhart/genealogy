1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 47, nr. 31.e
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nese, side 169, nr. 32
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Bore, side 47, nr. 31'''
2 CONT Tollak Larsson, son åt Lars Gabrielson Dale, Hetland, f. 24/6 1731, d. 1789,
2 CONT G. m. Berit Øysteinsd., nr. 30, f. 1733, d. 9/8 1812.
2 CONT Born:
2 CONT * a. Anna, f. 1757, g. m. Østen Olson Reve, nr. 42.
2 CONT * b. Lars, f. 1758, nr. 32.
2 CONT * c. Øystein.
2 CONT * d. Elen, f. 1770, d. 24/8 1849 på Reve, g. m. Tollak Larssen, n. Sørbø 31.
2 CONT * e. Inger, f. 1767, g. m. Helge Torgerson Nese nr. 32.
2 CONT * f. Berta, f. 1774, g. m. Ole Johannes Samlomonson Hodne 43
2 CONT Tollak fek bøgsel på 20 sp. 29/12 1755, førd til 1783, og skøyte på 20 sp. 20/10 1778.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nese, side 169, nr. 32'''
2 CONT Helge Torgerson, son åt nr. 31, f. 1765, d. 7/3 1847,
2 CONT G. m. Inger Elen Tollaksd., v. Bore nr. 31e, f. 1769, d. 24/9 1849.
2 CONT Born:
2 CONT * a. Anna, f. 4/8 1793, g. m. Daniel Ellingson, Håland 50, Høyland.
2 CONT * b. Berta, f. 29/5 1796.
2 CONT * c. Rakel Helena, f. 24/3 1799, g. m. Eivind Gunnarson, Hognestad, Time.
2 CONT * d. Torger, f. 11/4 1802, nr. 33.
2 CONT * e. Inger Elen, f. 28/4 1805, g. m. Gunnar Tolleivson, Sveinsvoll 51.
2 CONT * f. Tollak, f. 13/8 1809, g. m. Kirsten Nilsd., Vik nr. 43a.
2 CONT * g. Taletta, f. 1792, g. m. Vidkun Jonson Steinsland, Time.
2 CONT Helge fekk skøyte 12/11 1789, førd til 1823.
2 CONT
2 CONT
2 CONT ----
2 CONT Ho vart gift med Helge Torgersen Nese, son til Torger Ellingsen Undheim og Anna 		Helgesdtr Nese, og budde på Nese br 5 i Klepp. Dei fekk 7 barn.
2 CONT
