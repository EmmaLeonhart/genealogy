1 NOTE {geni:about_me} * 1865 census for Tjøtte, Klep: http://digitalarkivet.arkivverket.no/ft/person/pf01038203001295
2 CONT * https://www.slektogdata.no/gravminner/grav/537d7de7-6361-4211-9a3c-8b3da5ee6257
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 285, nr. 15.b
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 285, nr. 16
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 285, nr. 15'''
2 CONT Ole Johannes Tolleivson, son åt nr. 14, f. 28/2 1819, d. 2/2 1884,
2 CONT G. 14/11 1843 m. Anna Kirstine Berntsd., ø. Sørbø nr. 7, f. 7/8 1822, d. 16/7 1887.
2 CONT Born:
2 CONT * a. Tønnes, f. 6/3 1845, d. 6/11 1880, sinnsjuk.
2 CONT * b. Bernt, f. 6/11 1847, nr. 16.
2 CONT * c. Elisabet, f. 2/4 1850, d. 6/6 1876, sinnsjuk.
2 CONT * d. Anna, f. 29/8 1852, d. 12/8 1898.
2 CONT * e. Andreas, f. 5/6 1859, nr. 115.
2 CONT * f. Maria, f. 7/3 1863, d. 8/10 1887.
2 CONT * g. Ole Johan, f. 28/12 1866, d. 3/1 1887.
2 CONT Ole Johannes fekk skøyte på halve farsgarden 18 sp. 13/7 1846. Det gjekk frå 6 sp. til Kåsen og 1 1/2 sp. til Refsnes, så skylda vart 10 1/2 sp. førd til 1873.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tjøtta, side 285, nr. 16'''
2 CONT Bernt Olson, son åt nr. 15, f. 6/11 1847, d. 6/5 1930,
2 CONT G. I. 13/11 1873 m. Marta Maria Halvorsd., Kleppe nr. 108, f. 20/6 1852, d. 10/11 1879.
2 CONT Born:
2 CONT * a. Olai, f. 19/12 1873, USA.
2 CONT * b. Hans, f. 1/3 1876, d. 17/1 1900.
2 CONT G. II. 8/4 1881 m. Berta Serina Larsd. nr. 68i, f. 24/9 1853, d. 5/8 1917.
2 CONT Born:
2 CONT * c. Marianne, f. 6/3 1882, g. m. Edvin Larson, Stavanger.
2 CONT * d. Lars, f. 29/5 1884, USA, g. m. Ingeborg Tomasd.
2 CONT * e. Bernt, f. 24/10 1886, USA, g. m. Elisabet Varhaug.
2 CONT * f. Birger, f. 19/4 1889, småbrukar på Tjøtta.
2 CONT * g. Signe, f. 25/3 1894, g. m. Hans P. Herigstad, Tjøtta.
2 CONT * h. Ole Johan, f. 2/6 1897, gardbrukar på Tjøtta.
2 CONT * i. Hans, f. 22/6 1902, snikkar, ug.
2 CONT Bernt fekk skøyte på farsgarden 10 1/2 sp. 11/7 1873, så var skilt frå br. nr. 2 og 3, og skylda vart 2,52, førd 1900 og 1906.
