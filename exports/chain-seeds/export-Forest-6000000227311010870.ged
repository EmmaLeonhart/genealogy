1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hauge, side 116, nr. 7.c
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hauge, side 116, nr. 8
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hauge, side 116, nr. 7'''
2 CONT Mons Sivertson, son åt Sivert Monson, Vik nr. 6, f. 1681, d. 1744,
2 CONT G. m. Malena Henriksd. nr. 5, d. 1742.
2 CONT Born:
2 CONT * a. Henrik, f. 1711, Vik nr. 8.
2 CONT * b. Malena, f. 1705, g. m. Erik Torgerson, Erga nr. 6, g. 2. m. Ivar Rasmusson, Erga nr. 7.
2 CONT * c. Kirsten, f. 1717, g. m. nr. 8.
2 CONT Mons fekk bøgsel 11/12 1720, førd til 1746. Etter manntallsrulle 1718 fekk han bøgsel 1704, og han er førd som brukar på Hauge 1711. Lagrettemann 1711-1739.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Hauge, side 116, nr. 8'''
2 CONT Hans Torson, son åt Tore Henrikson, n. Horpestad nr. 7, f. 1715, d. 19/1 1771,
2 CONT G. m. Kirsten Monsd. nr. 7, f. 1717, d. 1752.
2 CONT Kongeløyve 5/12 1745, dei var søskenborn.
2 CONT Born:
2 CONT * a. Tore, f. 1749, Rosland nr. 70.
2 CONT * b. Malena, f. 1751.
2 CONT G. II m. Karen Eriksd., Erga nr. 6c, f. 1728, g. 2. m. nr. 9.
2 CONT Born:
2 CONT * c. Erik, f. 1757, Tjøtta nr. 13.
2 CONT * d. Hans, f. 1767, y. Salte nr. 31.
2 CONT * e. Kirsten, f. 1754, g. m. Tore Sivertson, Stavanger.
2 CONT * f. Alet, f. 1760, g. m. Tore Nilsson Kalberg, Time.
2 CONT * g. Barbro, f. 1764, g. m. Hans Ingebretson Haugland, Time. Dei fekk i Klepp: Karen, f. 17/5 1801.
2 CONT Hans fekk bøgsel 25/6 1746, førd til 1771. Lagrettemann 1747-1763.
2 CONT
2 CONT ----
2 CONT
2 CONT Kirsten og Hans fekk Kongeløyve 5/12-1745, dei var søskenborn.
