1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 233, nr. 10.b
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 233, nr. 11
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 233, nr. 10'''
2 CONT Ivar Rasmusson, son åt Rasmus Rasmusson Hellestø, Håland, f. 13/3 1776, d. 12/11 1866,
2 CONT G. 25/3 1798 m. enkja etter nr. 9, Karen Assersd.
2 CONT Born:
2 CONT * a. Berta, f. 14/7 1799, g. m. Jens Anderson, Skas nr. 32.
2 CONT * b. Jon, f. 11/10 1801, nr. 11.
2 CONT * c. Rasmus, f. 7/12 1806, Stavanger, skippar.
2 CONT Ivar fekk bøgsel på 55 sp. 13/11 1798, førd til 1828. Skøyte på 27 1/2 sp. 12/11 1805.
2 CONT Skylda har ymsa noko, mellom 60 sp. 1706, 76 sp. 1731, og nå 55 sp.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Sele, side 233, nr. 11'''
2 CONT Jon Ivarson, son åt nr. 10, f. 11/10 1801, d. 24/12 1870,
2 CONT G. 12/11 1829 m. Olina Olsd., Malmeim 54, Høyland, f. 28/5 1809, d. 1/3 1888.
2 CONT Born:
2 CONT * a. Ivar, f. 16/12 1830, USA.
2 CONT * b. Ola, f. 7/3 1835, nr. 12.
2 CONT * c. Jon, f. 18/5 1840, nr. 16.
2 CONT * d. Jens, f. 14/1 1843, nr. 14.
2 CONT * e. Kornelius, f. 1/9 1844, d. 18/11 1862.
2 CONT * f. Karen, f. 7/4 1832, d. 13/7 1849.
2 CONT * g. Kirsten, f. 6/6 1846, d. 11/10 1862.
2 CONT * h. Karl, f. 17/9 1851, nr. 13.
2 CONT * i. Berta Justina, f. 7/7 1855, d. 30/5 1886.
2 CONT Jon fekk bøgsel på 27 1/2 sp. 21/3 1829, og skøyte på 27 1/2 sp. 15/7 1828, førd til 1870.
2 CONT Slekta Monsen i Tananger hadde skøyte på resten til 1870.
2 CONT
2 CONT ----
2 CONT Ekteparet hadde 10 born
