2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 225, nr. 101'''
2 CONT Erik Erikson, son åt Erik Olson Halleland, Varhaug, f. 6/7 1862, d. 15/7 1916,
2 CONT G. 27/11 1890 m. Anna Samuelsd. nr. 94, f. 29/9 1865, d. 28/4 1903.
2 CONT Born:
2 CONT * a. Ingeborg Marie, f. 17/4 1891, g. m. Henrik Andreasson Steinsland, Bryne.
2 CONT * b. Gina Bergitte, f. 9/7 1897, g. m. urmakar Helland, Bryne.
2 CONT * c. Eline, f. 3/5 1899, g. m. Paul Paulson Heigre, Herikstad.
2 CONT G. II. 30/1 1904 m. Anna Tønnesd. nr. 15, f. 27/8 1873.
2 CONT Born:
