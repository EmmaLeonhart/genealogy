2 CONT #'''www''': [http://www.polyjo.dk/navne_sogne/pe61a7a65.html polyjo.dk], [http://finnholbek.dk/genealogy/getperson.php?personID=I25474&tree=2 finnholbek.dk], [http://www.kreutzer.dk/140.html kreutzer.dk]
