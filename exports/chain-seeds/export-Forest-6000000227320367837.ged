2 CONT https://www.familysearch.org/library/books/viewer/263167/?page=7#page=41
2 CONT ''"Dottren Anna Paschilia"''
2 CONT -----
2 CONT '''Death record  6 p. Trin. 1699, 70 år:'''
2 CONT Filipstad (S) F:1 (1664-1758) Bild 61 / Sida 115
2 CONT http://www.arkivdigital.se/aid/show/v5821.b61.s115
2 CONT Filipstads kyrkoarkiv SE/VA/13110
2 CONT https://sok.riksarkivet.se/?postid=Arkis+{06359982-8d06-478f-a702-b72741328fb0}&s=Balder
