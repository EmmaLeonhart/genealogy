1 NOTE {geni:about_me} https://ancestors.familysearch.org/en/K2SV-SNK/mary-pidge-1624-1663
2 CONT
2 CONT Mary Pidge 25 December 1624–19 February 1663
2 CONT
2 CONT Birth   •   1 Sources 25 December 1624 Saffron Walden, Essex, England, United Kingdom
2 CONT
2 CONT Age 38 Death   •   3 Sources 19 February 1663 Middlesex, Massachusetts Bay Colony, British Colonial America
2 CONT
2 CONT Mary in entry for Jonathan Wood, "Massachusetts Births and Christenings, 1639-1915"
2 CONT
2 CONT SPOUSES AND CHILDREN
2 CONT
2 CONT Nicholas Wood 1595-1669 Marriage: 10 July 1639
2 CONT
2 CONT Medfield, Middlesex, Massachusetts Bay Colony, British Colonial America
2 CONT
2 CONT Mary Pidge 1624-1663
2 CONT
2 CONT Children (9)
2 CONT
2 CONT Sarah Wood 1642-1678
2 CONT
2 CONT Mary Wood 1642-1726
2 CONT
2 CONT Elizabeth Wood 1648-1682
2 CONT
2 CONT Jonathan Wood 1651-1675
2 CONT
2 CONT Mehitable Wood 1655-1681
2 CONT
2 CONT Abigail Wood 1657-1669
2 CONT
2 CONT Hannah Wood 1659-
2 CONT
2 CONT Bethiah Wood 1660-1731
2 CONT
2 CONT Eleazer Wood 1662-1704
2 CONT
2 CONT PARENTS AND SIBLINGS
2 CONT
2 CONT Thomas Pidge 1609-1643
2 CONT
2 CONT Marriage:
2 CONT
2 CONT Mary Sothy 1601-1800
2 CONT
