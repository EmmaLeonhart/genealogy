1 NOTE {geni:about_me} 1824 Ekteskap
2 CONT https://www.digitalarkivet.no/view/327/pv00000000701696
2 CONT
2 CONT FT1845
2 CONT https://www.digitalarkivet.no/census/person/pf01051236001405
2 CONT
2 CONT FT1865 Ole bor hos datteren Berethe Martha f.1836
2 CONT https://www.digitalarkivet.no/census/person/pf01038346002131
2 CONT
2 CONT FT1875 Ole bor hos sønnen (Ole) Andreas f.1827
2 CONT https://www.digitalarkivet.no/census/person/pf01052398002547
2 CONT
2 CONT FT1875 Olava bor hos sin datter Sirianna og hennes ektemann
2 CONT https://www.digitalarkivet.no/census/person/pf01052415003977
2 CONT
2 CONT '''Råum, Råmoen, Husmannsplass under bnr.2
2 CONT
2 CONT Adrianna dør 1823, og Ole gifter seg 1824 med sin søsterdatter Olava
2 CONT
2 CONT Benonidtr.,dtr. av Benoni Jensen, plassmann på Benonimoen, og hustru
2 CONT
2 CONT Gjertrud Ingebrigtsdtr. fra Råmoen.Ole Ingebrigtsen og Olava bodde på
2 CONT
2 CONT Råmoen til 1836, da de flyttet til plassen Benonimoen på Skarland.
2 CONT
2 CONT Kilde:Bygdebok for Høylandet Bind 1, s.274
2 CONT
2 CONT Olava Benonisdtr. reiste fra Høylandet i 1850-årene. Ole Ingebrigtsen
2 CONT
2 CONT flytter til sin sønn, Ole Andreas på "Joneset" Hammer, hvor han døde
2 CONT
2 CONT 25.09.1877.
2 CONT
2 CONT Kilde:Bygdebok for Høylandet Bind 1, s.302
2 CONT --------------------
2 CONT Ole ble gift for 2. gang 11.04.1824 med Olava Benonisdatter
2 CONT
2 CONT Opererer også med etternavn "Kjøglum" (ved ekteskapsinngåelse med Olava)
