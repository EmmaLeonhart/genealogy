1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øvre Øksnevad, side 331, nr. 32.e
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Øvre Øksnevad, side 331, nr. 32'''
2 CONT Rasmus Person, son åt nr. 31, f. 1790, d. 18/3 1869,
2 CONT G. 18/11 1819 m. Mari Reiersd., Frøyland, Time, f. 11/11 1798, d. 16/4 1880.
2 CONT Born:
2 CONT * a. Per, f. 17/7 1820, nr. 35.
2 CONT * b. Reier, f. 25/7 1823, nr. 33.
2 CONT * c. Andreas, f. 24/1 1826, Skjæveland 97, Høyland.
2 CONT * d. Karl, f. 23/2 1830, Sandnes, timremann.
2 CONT * e. Rasmus, f. 23/7 1832 Stavanger, handelsmann.
2 CONT * f. Martin, f. 30/12 1838, snikkar, d. 26/3 1867.
2 CONT * g. Jonas, f. 13/2 1841, Stavanger, bakar.
2 CONT * h. Anna Maria, f. 16/3 1844, g. m. Martin Reierson, Lunde 55, Høyland.
2 CONT Rasmus fekk skøyte på farsgarden 22/3 1819, førd til 1851.
2 CONT
2 CONT ----
