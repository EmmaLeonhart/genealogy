2 CONT # Berta, dpt. 4/9 1803, Dysjaland, husmpl. 5, huslyd 4.
2 CONT # Ole Johannes, dpt. 13/4 1806, Rægje, husmpl. 5, huslyd 1.
2 CONT # Per, dpt. 26/12 1809, Stavanger, gift 5/4 1838 med Stine Åsille Jansdtr. frå Håland i Klepp, Klepp g. og æ. s. 142, nr. 13a. I Klepp-boka er faren nemnd Jon.
2 CONT # Jorina, f. 28/9 1819, Austre Stangaland, husmpl. 6, huslyd 1.
2 CONT # Kristian, f. 25/9 1824, Håland, denne plassen, huslyd 2.
2 CONT
2 CONT '''Gard og ætt i Sola, Håland, bruk 5, side 167, nr. 2'''
2 CONT Kristian Johannesson vart gift 2/4 1846 med Ingeborg Hansdtr. frå Tjelta, husmpl. 2, huslyd 3,6, og dei tok over bygsla av Hedlebergjet etter foreldra hans. Festesetel var datert 19/2 1846. Ho døydde 18/4 1885, han 4/5 1907.
2 CONT Born:
2 CONT # Johannes, f. 28/9 1846, Håland, bruk 13, huslyd 1.
2 CONT # Hans, f. 20/2 1849, var sjømann, fall ned frå riggen og slo seg i hel.
2 CONT # Rasmus, f. 14/12 1850, Rægje, bruk 7, huslyd 1.
2 CONT # Karl, f. 5/6 1853, Håland, dette bruket, huslyd 3.
2 CONT # Rakel, f. 28/11 1854, Rægje, bruk 11, huslyd 1.
2 CONT # Ingeborg, f. 20/7 1858, Tjelta, bruk 24, huslyd 1.
2 CONT # Kristina, f. 20/7 1858, d. 27/12 1859.
2 CONT # Andreas, f. 10/4 1860, d. 18/11 1876.
2 CONT # Kristina, f. 5/9 1862, Rægje, bruk 18 og 19, huslyd 2.
2 CONT # Maria, f. 10/8 1864, Stavanger, gift med Erik Helland.
2 CONT # Lisebet, f. 27/2 1866, U.S.A. Sjå Gjesdal g. og æ. s. 144, nr. 60.
2 CONT
2 CONT ----
