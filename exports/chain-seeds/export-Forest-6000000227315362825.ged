2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Grude, side 107, nr. 67'''
2 CONT Peder Ivarson, son åt nr. 66, f. 9/9 1810, d. 12/2 1900,
2 CONT G. I. 4/11 1833 m. Marta Jonsd. nr. 10f, f. 8/5 1808, d. 6/9 1843.
2 CONT Born:
2 CONT * a. Justine Maria, f. 8/9 1834, USA.
2 CONT * b. Johanna, f. 11/12 1837, USA.
2 CONT * c. Joabine, f. 26/6 1841, g. m. Kristian Pederson, Folkvor 71, Høyland.
2 CONT G. II. 27/3 1849 m. Serina Halvorsd., ø. Bore nr. 38a, søskenbarn, f. 25/10 1821, d. 4/9 1907.
2 CONT Born:
2 CONT * d. Johan Helmik, f. 3/5 1855, nr. 68.
2 CONT * e. Peder Julius, f. 14/1 1862, ø. Bore nr. 40.
2 CONT Peder fekk festesetel 8/11 1833, førd i folketelling 1865 og 1875.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Grude, side 108, nr. 68'''
2 CONT Johan Pederson, son åt nr. 67, f. 3/5 1855, d. 23/12 1940,
2 CONT G. I. 6/1 1888 m. Justina Vinsensd., Byberg, Håland, f. 13/2 1865, d. 29/9 1890.
2 CONT Born:
2 CONT * a. Peder, f. 24/3 1888, d. 9/6 1905.
2 CONT G. II. 8/4 1893 m. Gina Serina Jørgensd., Sola, Håland, f. 3/3 1865, 1/3 1935.
2 CONT * b. Karl Johan, f. 2/6 1893, bonde på ø. Bore.
2 CONT * c. Joakim, f. 16/8 1896, bonde på farsgarden.
2 CONT Peder fekk skøyte på bruket 12/5 1892, førd 1906. Skylda vart 1,42 mark og det er utskilt frå br. nr. 1, 2, 6, 9 og 11.
2 CONT
2 CONT ----
2 CONT Johan fikk skjøte på bnr. 12, Ånå, i 1892, ført i 1906.
