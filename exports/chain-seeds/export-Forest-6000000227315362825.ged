1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 300, nr. 33.c
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 305, nr. 89
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 300, nr. 33'''
2 CONT Ola Rasmusson, son åt nr. 16, f. 6/2 1829, d. 5/2 1901,
2 CONT G. I. 14/6 1853 m. Anna Maria Olsd., Grødeland  nr. 15b, f. 12/10 1829, d. 27/9 1854. Ingi born.
2 CONT G. II. 9/7 1857 m. Johanna Larsd., Viste, Randaberg, f. 1832, d. 9/1 1882.
2 CONT Born:
2 CONT * a. Maren Regina, f. 30/9 1858, ug., d. 28/3 1838.
2 CONT * b. Berta Maria, f. 27/9 1860, g. m. Samuel Sveinson, ø. Øksnevad nr. 38.
2 CONT * c. Laura, f. 11/1 1864, g. m. nr. 89.
2 CONT * d. Rasmus, f. 5/2 1866, nr. 34.
2 CONT * e. Lena Justina, f. 25/9 1868, g. m. nr. 89.
2 CONT * f. Olina, f. 4/3 1875, ug., d. 15/2 1915.
2 CONT Ola fekk skøyte på ein part av farbroren sin gard ved testamente 12/7 1850, 7 + 2/3 sp. etter frådrag for Holen 2,60 mark, førd til 1900.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 305, nr. 89'''
2 CONT Rasmus Albretson, son åt nr. 83, f. 29/12 1860, d. 21/12 1946,
2 CONT G. I. 25/11 1886 m. Laura Olsd. nr. 33, f. 11/1 1864, d. 16/1 1891.
2 CONT Born:
2 CONT * a. Albret, f. 28/1 1889, Bryne, slaktar.
2 CONT G. II. 9/11 1894 m. Lene Justine Olsd. nr. 33, f. 25/9 1868, d. 14/4 1957.
2 CONT Born:
2 CONT * b. Olav, f. 21/1 1895, kjøpmann, O. R. Thu.
2 CONT * c. Martin, f. 21/2 1896, Bryne, slaktar.
2 CONT * d. Laura, f. 21/5 1899, Bryne, ug.
2 CONT * e. Ragnvald, f. 13/5 1901, d. 21/12 1950.
2 CONT * f. Johannes, f. 10/8 1903, bonde på farsgarden.
2 CONT * g. Borghild, f. 29/4 1906, g. m. Håkon Johannesson, Herikstad, Time.
2 CONT * h. Johan Rosenius, f. 29/10 1910, bonde på Tu.
2 CONT * i. Olena Maria, f. 12/7 1915, g. m. Toralv Gabrielson Edland, Riskjell.
2 CONT Rasmus er førd som brukar 1885, 1900 og 1906, skøyte 4/1 1913, skyld 2,65.
