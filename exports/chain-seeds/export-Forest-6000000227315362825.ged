2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Nese, side 172, nr. 69'''
2 CONT Ivar Johannesson, son åt Johannes Ivarson, Friestad nr. 62, f. 1766, d. 28/3 1846,
2 CONT G. I. m. Anna Dortea Olsd., Vik nr. 41d, f. 1764.
2 CONT Born:
2 CONT * a. Ola, f. 1797, Orre nr. 35.
2 CONT G. II. 12/12 1799 i Stavanger m. Ingeborg Malena Ellingsd.
2 CONT Born:
2 CONT * b. Johannes, f. 1805, Skjæveland 74, Høyland.
2 CONT * c. Elling, f. 25/2 1810, n. Øksnevad nr. 52.
2 CONT G. III. 2/3 1820 m. Sara Nilsd., Erga nr. 66, f. 1777, d. 9/9 1839.
2 CONT Ivar budde først i Stavanger og var matros, seinare husmann på Nes.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Orre, side 175, nr. 35'''
2 CONT Ola Ivarson, son åt Ivar Johannesson, Nese nr. 69, f. 1797, d. 22/7 1844,
2 CONT G. 2/6 1823 m. Berta Elisabet Sveinsd., Tu nr. 61a, f. 5/7 1807, d. 16/4 1871.
2 CONT * a. Eilef, f. 18/12 1824, nr. 36.
2 CONT * b. Dorte Serine, f. 16/5 1827, d. 15/1 1849.
