2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 304, nr. 83
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 304, nr. 82'''
2 CONT Lars Albretson, son åt Albret Olson Særheim nr. 18, f. 1790, d. 14/12 1874,
2 CONT G. 8/3 1812 m. Elen Rasmusd., Kleppe nr. 77a, f. 8/3 1795, d. 13/12 1858.
2 CONT Born:
2 CONT * a. Albret, f. 7/3 1813, nr. 83.
2 CONT * b. Ommund, f. 20/11 1815, nr. 86.
2 CONT * c. Rasmus, f. 18/4 1819, Søyland, Nærbø.
2 CONT * d. Ola, f. 5/9 1823, Anda nr. 57.
2 CONT Lars budde først i Hole nr. 7, så på n. Braut nr. 14, fekk skøyte ved makeskifte 13/11 1826, førd til 1831, brukar 21 1/2 sp., og til 1852 10 1/2 sp.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Tu, side 304, nr. 83'''
2 CONT Albret Larsson, son åt nr. 82, f. 7/3 1813, d. 19/5 1888,
2 CONT G. I. 2/4 1846 m. Berta Maria Pedersd., Erga nr. 29, f. 23/11 1821, d. 30/8 1866.
2 CONT Born:
2 CONT * a. Lars, f. 9/6 1847, ug., d. 27/11 1871.
2 CONT * b. Palle, f. 8/10 1848, nr. 84.
2 CONT * c. Albret, f. 16/8 1850, d. 14/4 1873.
2 CONT * d. Andreas, f. 27/11 1852, nr. 88.
2 CONT * e. Elen Maria, f. 25/9 1854, g. m. Ola Rasmusson Kvassheim, Ogna, g. 2. m. nr. 85.
2 CONT * f. Martin, f. 6/11 1856, USA.
2 CONT * g. Arnt Johan, f. 16/1 1859, ug., d. 27/9 1927.
2 CONT * h. Rasmus, f. 29/12 1860, nr. 89.
2 CONT * i. Enevald, f. 14/11 1863, Bryne, slaktar.
2 CONT * j. Ola, f. 3/4 1866, ug., d. 21/4 1944.
2 CONT G. II. 12/4 1867 m. Karen Malena Pedersd., Katteland nr. 12, f. 30/8 1818, d. 22/5 1887. Ingi born.
2 CONT Albret fekk skøyte på halve farsgarden 11/7 1831, førd til 1876, skyld 11 sp.
