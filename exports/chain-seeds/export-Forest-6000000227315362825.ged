1 NOTE {geni:about_me} * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 66.e
2 CONT * Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 67
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 66'''
2 CONT Ola Rasmusson, son åt nr. 65, f. 1791, d. 29/4 1878,
2 CONT G. 31/3 1816 m. Marta Pedersd., ø. Øksnevad nr. 31c, f. 26/3 1797, d. 21/9 1876.
2 CONT Born:
2 CONT * a. Rasmus, f. 2/5 1817, ug., d. 6/3 1869.
2 CONT * b. Per, f. 20/6 1819, ug., d. 17/9 1846.
2 CONT * c. Marta Dortea, f. 21/11 1821, g. m. Johannes Larsson, Friestad nr. 64, g. 2. m. Torkel Pederson, Tu nr. 29.
2 CONT * d. Anna Margrete, f. 21/8 1824, g. m. Erik Jonson, Friestad nr. 68.
2 CONT * e. Ola, f. 17/2 1823, nr. 67.
2 CONT * f. Marta, f. 30/10 1829, g. m. Kornelius Larsson, ø. Øksnevad nr. 20.
2 CONT * g. Jon, f. 14/4 1832, nr. 70.
2 CONT * h. Eilef, f. 13/1 1835, ø. Øksnevad nr. 12.
2 CONT * i. Rakel, f. 31/1 1838, g. m. nr. 118.
2 CONT * j. Martin, f. 22/3 1842.
2 CONT Ola fekk skøyte på 9 sp. 13/7 1813, og bøgsel på 8 sp. 10/11 1814, førd til 1861.
2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Store Salte, side 222, nr. 67'''
2 CONT Ola Olson, son åt nr. 66, f. 17/2 1823, d. 24/3 1915,
2 CONT G. I. 21/6 1859 m. Tabitta Pedersd., Tårland, Nærbø, f. 25/11 1826, d. 7/7 1871.
2 CONT Born:
2 CONT * a. Ola, f. 27/5 1861, nr. 68.
2 CONT * b. Malena, f. 1/3 1866, g. m. Bernt Berntson Bryne, Time.
2 CONT G. II. 21/3 1872 m. Anna Berta Johannesd., Høyland, Nærbø, f. 1/12 1840, d. 6/8 1924.
