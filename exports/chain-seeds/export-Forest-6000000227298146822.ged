2 CONT https://books.google.fi/books?id=7qdlAAAAcAAJ&pg=PA78&lpg=PA78&dq=ericus+krumedick&source=bl&ots=TMTnTTzVag&sig=4O9xBM9D16TnwRNImcoBNYlsjzg&hl=fi&sa=X&ved=0ahUKEwjuoYWHjpDSAhWF1ywKHaDBDzgQ6AEIHjAA#v=onepage&q=ericus%20krumedick&f=
2 CONC false
