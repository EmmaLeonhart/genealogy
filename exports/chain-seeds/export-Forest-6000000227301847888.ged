2 CONT
2 CONT '''Klepp Gards- og ættesoga gjenom 400 år, 1519-1900, Borsok, side 60, nr. 32'''
2 CONT Bernt Pederson, son åt nr. 31, f. 26/4 1872, d. 2/3 1955,
2 CONT G. 6/10 1896 m. Berta Olsd., Veø, Romsdal, f. 16/9 1871, d. 27/2 1946.
2 CONT Born:
2 CONT * a. Palmer, f. 5/4 1897, bonde på farsgarden.
2 CONT * b. Gerda, f. 2/9 1900, g. m. Johan Martin Låstad, lærar, Håland.
2 CONT * c. Rakel, f. 26/4 1905, g. m. Karl Torgerson, Grude, Håland 19a.
2 CONT * d. Oskar, f. 10/3 1903, kjøpmann, Sandnes.
2 CONT * e. Berner, f. 29/11 1906, bonde på Berheim, Høyland.
2 CONT * f. Bjarne, f. 13/11 1914, meierist, Fredrikstad.
2 CONT Bernt er førd i matrikkelen 1906 som brukar, skyld 2,48.
