2 CONT
2 CONT '''Jæren Gards- og Ættesoga - Band III, Klepp, Anda, Bruk 9, side 39, nr. 79'''
2 CONT Tore Olson, son åt nr. 78, f. 1/1 1811, d. 4/10 1877, 
2 CONT g. 8/11 1837 m. Guri Maria Garpestad, Time, f. 2/9 1817, d. 5/1 1878.
2 CONT Born:
2 CONT * a. Anna Malena, f. 6/2 1841, g. m. Svein Jonson Bryne, Time.
2 CONT * b. Rakel, f. 5/7 1844, g. m. Ola Karlson Kleppe, nr. 99.
2 CONT * c. Guri Maria, f. 6/7 1847, g. m. Kristian Abrahamson Tu, nr. 21.
2 CONT * d. Nils, f. 24/4 1853, nr. 80.
2 CONT * e. Karen Elisabet, f. 11/3 1862, g. m. nr. 58 og nr. 59.
2 CONT Tore fikk skøyte på halve farsgarden 13/7 1843, 9 skilling frå Peder Ådneson 29/10 1858, 4 skilling frå Peder Pederson s. d., samla 7,12 mark.
2 CONT
2 CONT '''Jæren Gards- og Ættesoga - Band III, Klepp, Anda, Bruk 9, side 39, nr. 80'''
2 CONT Nils Toreson, son åt nr. 79, f. 28/4 1853, d. 27/5 1940, 
2 CONT g. 17/6 1880 m. Marta Maria Ingebretsd., Grude nr. 59 d, f. 13/4 1862, d. 13/1 1936.
2 CONT Born:
2 CONT * a. Tore, f. 6/6 1881, d. 16/11 1918.
2 CONT * b. Gina Margitta, f. 4/8 1885, g. m. Ingvald Isakson Egeland, disponent, Høyland meieri.
2 CONT * c. Nikoline, f. 29/8 1887, g. m. Ommund Ellingson, n. Braut nr. 57c.
2 CONT * d. Anna Malena, f. 23/9 1889, ug.
2 CONT * e. Johan Garman, f. 7/10 1891, bonde på ein part av farsgarden.
2 CONT * f. Maren, f. 4/11 1893, ug.
2 CONT * g. Håkon, f. 13/4 1899, bonde på farsgarden.
2 CONT * h. Olav, f. 25/12 1901, kjøpmann, Kleppe.
2 CONT Nils fekk skøyte på farsgarden 9/11 1877, førd 1906, skyld 7,14 mark.
