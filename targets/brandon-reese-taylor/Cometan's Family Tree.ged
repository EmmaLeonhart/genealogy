1 _OID 44df5e3b-0835-436f-bfd5-f69a1c59c106
1 _META <metadataxml><content><line>&lt;p&gt;&lt;span style="font-size: medium;"&gt;M.I. -INSCRIPTION IN ST MARY CHURCH ECCLESTON, BY ROY LOWE.&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: medium;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p
2 CONC &gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;JOHN AND AGNES THRELFALL&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;AGNES THE ABOVE DEPARTED THIS LIFE&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&g
2 CONC t;&lt;span style="font-size: small;"&gt;APRIL 9TH 1808 AGED 30 YEARS&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;"HER RACE WAS EARLY RUN HER TIME SOON OR'E&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span s
2 CONC tyle="font-size: small;"&gt;SHE LEFT HER HUSBAND DEAR AND INFANTS FOUR&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;THEIR LOSS WAS GREAT THEY CAN EXPRESS TO OTHERS&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt
2 CONC ;span style="font-size: small;"&gt;ONE OF THE BEST WIVES AND TENDEREST OF MOTHERS"&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;&amp;nbsp; &amp;nbsp; &amp;nbsp; &amp;nbsp; ALSO INTERED HERE THE REMAINSOF MARY&lt
2 CONC ;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;THE WIFE OF HUMPHREY RIGBY LATE OF ULNES WALTON&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;AND SISTER TO THE ABOVE JOHN THRELFALL
2 CONC &lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;WHO DIED FEBRUARY 11TH 1837 AGED 30 YEARS&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;ALSO IN MEMORY OF JAMES THRELFALL OF ECCL
2 CONC ESTON&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;AND BROTHER TO THE ABOVE WHO DEPARTED THIS LIFE&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;NOVEMBER 24TH 1853 AGED 58 YEA
2 CONC RS&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;ALSO RICHARD SON OF THE ABOVE WHO DIED&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;APRIL29TH 1890 AGED 71 YEARS&lt;/span&gt;&
2 CONC lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;ALSO JANE HIS WIFE WHO DIED&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;SEPTEMBER 20TH 1890 AGED 72 YEARS&lt;/span&gt;&lt;/p&gt;</line><line>
2 CONC &lt;p&gt;&lt;span style="font-size: small;"&gt;"THE WINTER OF TROUBLE IS PAST&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;THE STORMS OF AFFLICTION ARE OR'E&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span s
2 CONC tyle="font-size: small;"&gt;THE STRUGGLE IS ENDED AT LAST&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;AND SORROW AND DEATH ARE NO MORE"&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: sma
2 CONC ll;"&gt;&amp;nbsp;&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;I THINK MARY'S DEATH AGE SHOULD BE 50 NOT 30&lt;/span&gt;&lt;/p&gt;</line><line>&lt;p&gt;&lt;span style="font-size: small;"&gt;TRANSCRIPTION ERROR?
2 CONC &lt;/span&gt;&lt;/p&gt;</line></content></metadataxml>
