1 _META <metadataxml><content><line>&lt;p style="text-align: center;"&gt;&lt;span style="color: #990000; font-family: arial, sans-serif; font-size: x-large; line-height: normal; text-align: start; background-color: #ffc8aa;"&gt;Baptism: 3 Dec 1780 St Andre
2 CONC ws, Leyland, Lancashire, England&lt;/span&gt;&lt;br style="color: #990000; font-family: arial, sans-serif; font-size: medium; line-height: normal; text-align: start; background-color: #ffc8aa;"&gt;&lt;span style="color: #990000; font-family: arial
2 CONC , sans-serif; font-size: x-large; line-height: normal; text-align: start; background-color: #ffc8aa;"&gt;John Moon - son of Henry Moon &amp;amp; Ann&lt;/span&gt;&lt;br style="color: #990000; font-family: arial, sans-serif; font-size: medium; line-h
2 CONC eight: normal; text-align: start; background-color: #ffc8aa;"&gt;&lt;span style="color: #990000; font-family: arial, sans-serif; font-size: x-large; line-height: normal; text-align: start; background-color: #ffc8aa;"&gt;&amp;nbsp;&amp;nbsp;&amp;nbs
