1 _META <metadataxml><content><line>&lt;p align="center"&gt;&lt;font size="5"&gt;Baptism: 13 Feb 1825 St Mary the Virgin, Eccleston, Lancashire, England&lt;br&gt;William Crowshaw - Child of John Crowshaw &amp;amp; Ellen&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nb
2 CONC sp;&amp;nbsp;Born: January 7th&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Abode: Eccleston&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Occupation: Weaver&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Notes: 1st Son&lt;br&gt;&amp;nbsp;
2 CONC &amp;nbsp;&amp;nbsp;&amp;nbsp;Baptised by: Thos.Marshall Curate&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Register: Baptisms 1813 - 1846, Page 63, Entry 5&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Source: Roy Lowe Transcript&lt;/font&
2 CONC gt;&lt;/p&gt;&lt;p align="center"&gt;&amp;nbsp;&lt;/p&gt;&lt;p align="center"&gt;&lt;font size="5"&gt;Marriage: 16 Mar 1847 St Mary the Virgin, Eccleston, Lancashire, England&lt;br&gt;William Crowshaw - Full Calico Printer Bachelor of Eccleston &lt
2 CONC ;br&gt;Margaret Norris - (X), Full Spinster of Eccleston &lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Groom&amp;#39;s Father: John Crowshaw, Plaisterer&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Bride&amp;#39;s Father: Richard Norris, Ta
2 CONC ilor&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Witness: John Norris; Thomas Moon&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Married by: Thomas Marshall&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Register: Marriages 1837 - 1873, P
2 CONC age 76, Entry 152&lt;br&gt;&amp;nbsp;&amp;nbsp;&amp;nbsp;&amp;nbsp;Source: Roy Lowe Transcript&lt;br&gt;&lt;/font&gt;&lt;/p&gt;&lt;p align="center"&gt;&lt;font size="5"&gt;&lt;br&gt;&amp;nbsp;&lt;/font&gt;&lt;/p&gt;</line></content></metadataxml>
