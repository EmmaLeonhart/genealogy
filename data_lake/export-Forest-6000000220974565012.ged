0 @N6000000001831633618@ NOTE 1 Nygaard, Ken, "Ketil Ken Nygaard's Genealogy" (http://nygaard.howards.net/).
1 CONT
1 CONT Childeric King of the Salian Franks
1 CONT (Abt 437-481)
1 CONT Basina
1 CONT (-)
1 CONT Chilperic
1 CONT (-)
1 CONT
1 CONT Clovis I King of the Franks
1 CONT (466-511)
1 CONT
1 CONT Saint Clotilda of the Franks
1 CONT (Abt 474-545)
1 CONT
1 CONT Chlotar I King of the Franks
1 CONT (Abt 500-561)
1 CONT
1 CONT Family Links
1 CONT Spouses/Children:
1 CONT 1. Ingund
1 CONT
