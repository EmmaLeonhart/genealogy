2 CONT     file:///E:/E-S009/genealogy/Grab_A_Site_downloads/stirnet/romans2.htm#link4
2 CONT
2 CONT     1. Constantius Chlorus, Emperor of Rome (b 242, d 07.306)
2 CONT     m1. (div) Helena 'of the Cross' (d 328, possibly dau of Coilus, King of Cochester)
2 CONT     ...
2 CONT     m2. Theodora (dau of Maximianus Herculius, Emperor of Rome) @4@ above
